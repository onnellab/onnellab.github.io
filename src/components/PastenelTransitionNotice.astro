---
const { locale = 'en' } = Astro.props;
const copy: Record<string, string> = {
 en: 'Pastenel is available on the App Store for iPhone and iPad.',
 ko: 'Pastenel(페이스트넬)을 iPhone과 iPad의 App Store에서 받을 수 있어요.',
 ja: 'Pastenelは、iPhoneとiPad向けにApp Storeで公開されています。',
 'zh-Hans': '可在 App Store 获取适用于 iPhone 和 iPad 的 Pastenel。',
 'zh-Hant': '可在 App Store 取得適用於 iPhone 和 iPad 的 Pastenel。',
 'pt-BR': 'Pastenel está disponível na App Store para iPhone e iPad.',
 de: 'Pastenel ist im App Store für iPhone und iPad verfügbar.',
 fr: 'Pastenel est disponible sur l’App Store pour iPhone et iPad.',
 es: 'Pastenel está disponible en la App Store para iPhone y iPad.'
};
---
<aside class="rename-notice" data-pastenel-availability>{copy[locale] || copy.en}</aside>
<style>.rename-notice { padding: 1rem; margin: 1rem 0; border: 1px solid currentColor; border-radius: .75rem; line-height: 1.65; font-size: .95rem; }</style>
