---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocaleMenu from './LocaleMenu.astro';
import SiteFooter from './SiteFooter.astro';
import { getProductIndexItems, type ProductIndexItem } from '../lib/products';
import { showcaseCopy } from '../lib/home-showcase-copy';
import {
  allLocaleAlternates,
  allLocaleDefinitions,
  allProductRouteFor,
  allRouteFor,
  type AllSiteLocale
} from '../lib/extended-site-i18n';
import './home-page.css';

type Props = { locale: AllSiteLocale };

const { locale } = Astro.props;
const copy = showcaseCopy[locale];
const definition = allLocaleDefinitions[locale];
const canonicalPath = allRouteFor('home', locale);
const products = getProductIndexItems(locale);
const releasedApps = products.filter(
  (app) => app.status === 'Released' && app.hasStoreListing && app.slug !== 'summer-sound-maker'
);
const featured = releasedApps.find((app) => app.slug === 'tagweaver');
const selectedApps = (['quivra', 'melivra', 'papira'] as const)
  .map((slug) => releasedApps.find((app) => app.slug === slug))
  .filter((app): app is ProductIndexItem => Boolean(app));
// Home uses original UI screenshots in rounded, clipped cards.
// App detail galleries independently retain reviewed promotional artwork.
const featuredScreenshot = featured?.homeScreenshots.supporting;
const iconPath = (slug: string, size: 96 | 192) => `/home-assets/app-icons/${slug}-${size}.webp`;
const iconSrcset = (slug: string) => `${iconPath(slug, 96)} 96w, ${iconPath(slug, 192)} 192w`;
const heroSlides = [
  { slug: 'tagweaver', category: copy.carousel.musicTag },
  { slug: 'melivra', category: copy.offers.melivra.category },
  { slug: 'papira', category: copy.offers.papira.category }
].flatMap((slide) => {
  const app = releasedApps.find((item) => item.slug === slide.slug);
  const artwork = app?.homeScreenshots.hero;
  if (!app || !artwork) return [];
  return [{ ...slide, app, artwork }];
});
// A fixed, slightly asymmetric three-slot showroom. Only the product content
// rotates; the Melivra-centered geometry is the permanent layout reference.
const initialHeroSlots = [
  { position: 'previous', index: 2 },
  { position: 'active', index: 0 },
  { position: 'next', index: 1 }
] as const;
const accentStyle = (app: ProductIndexItem) =>
  '--accent-border: ' + app.accent.border + '; --accent-bg: ' + app.accent.background + '; --accent-text: ' + app.accent.text + ';';
const navigationLabels: Record<AllSiteLocale, string> = {
  en: 'Navigation', ko: '탐색', ja: 'ナビゲーション',
  'zh-Hans': '导航', 'zh-Hant': '導覽',
  'pt-BR': 'Navegação', de: 'Navigation', fr: 'Navigation', es: 'Navegación'
};
const blogHref = `/blog/${definition.pathSegment ? `${definition.pathSegment}/` : ''}`;
const linkFor = (slug: string) => allProductRouteFor(slug, locale);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': new URL('/#organization', Astro.site).toString(),
    name: 'ONNELLAB',
    url: new URL('/', Astro.site).toString(),
    email: 'onnellab.app@gmail.com'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': new URL('/#website', Astro.site).toString(),
    name: 'ONNELLAB',
    url: new URL(canonicalPath, Astro.site).toString(),
    description: copy.description,
    inLanguage: definition.htmlLang,
    publisher: { '@id': new URL('/#organization', Astro.site).toString() }
  }
];
---

<BaseLayout
  title={copy.seoTitle}
  description={copy.description}
  canonicalPath={canonicalPath}
  lang={definition.htmlLang}
  jsonLd={jsonLd}
  alternates={allLocaleAlternates('home')}
  socialImage="/social-card.png"
>
  <main class="site-shell homepage" data-core-page="home" data-locale={locale} data-home-artwork-contract="1" data-home-locale={locale}>


    <div class="content-shell">
      <section class="home-hero" aria-labelledby="home-heading">
        <div class="hero-copy">
          <p class="eyebrow">{copy.eyebrow}</p>
          <h1 id="home-heading">
            {locale === 'ko' ? (
              <><span class="title-line">파일·미디어</span>{' '}<span class="title-line">앱을 만들어요.</span></>
            ) : locale === 'ja' ? (
              <><span class="title-line">ファイル・メディア</span><span class="title-line">向けのアプリ。</span></>
            ) : copy.heroTitle}
          </h1>
          <p class="lede">{copy.heroIntro}</p>
          <a class="primary-link" href={allRouteFor('apps', locale)}>
            {copy.browse}<span aria-hidden="true">↗</span>
          </a>
        </div>

        {heroSlides.length > 0 && (
          <div class="hero-carousel" data-hero-carousel role="region" aria-label={copy.carousel.label}>
            <div class="hero-stage" data-hero-track role="group" tabindex="0" aria-label={copy.carousel.choose}>
              {initialHeroSlots.map(({ position, index }) => {
                const slide = heroSlides[index];
                return slide && (
                  <div class="hero-slot" data-hero-slot={position}>
                    <a
                      class="hero-slide"
                      data-hero-slide
                      data-hero-product={slide.slug}
                      data-home-featured-slug={slide.slug}
                      data-home-featured-locale={locale}
                      data-index={index}
                      data-position={position}
                      aria-current={position === 'active' ? 'true' : undefined}
                      href={linkFor(slide.slug)}
                      aria-label={slide.app.title + ' · ' + slide.category}
                      style={accentStyle(slide.app)}
                    >
                      <div class="hero-slide-screen">
                        <img
                          src={slide.artwork.src}
                          data-home-artwork-slug={slide.slug}
                          data-home-artwork-locale={locale}
                          data-home-artwork-index={slide.artwork.index}
                          data-home-artwork-source={slide.artwork.source}
                          alt=""
                          width={slide.artwork.width}
                          height={slide.artwork.height}
                          loading={index === 0 ? 'eager' : 'lazy'}
                          fetchpriority={index === 0 ? 'high' : 'auto'}
                          decoding="async"
                          draggable="false"
                        />
                      </div>
                      <div class="hero-slide-label">
                        <span class="hero-slide-identity">
                          <strong>{slide.app.title}</strong>
                          <small>{slide.category}</small>
                        </span>
                        <span class="hero-slide-link-arrow" aria-hidden="true">↗</span>
                      </div>
                    </a>
                  </div>
                );
              })}
            </div>
            <div class="hero-carousel-pagination" role="group" aria-label={copy.carousel.choose}>
              {heroSlides.map((slide, index) => (
                <button
                  type="button"
                  class="hero-carousel-dot"
                  data-hero-dot
                  data-index={index}
                  aria-label={slide.app.title + ' ' + (index + 1) + ' / ' + heroSlides.length}
                  aria-current={index === 0 ? 'true' : undefined}
                ><span aria-hidden="true"></span></button>
              ))}
            </div>
            <span class="hero-carousel-announcement" data-hero-announcement role="status" aria-live="polite" aria-atomic="true">
              {heroSlides[0].app.title + ' · ' + heroSlides[0].category}
            </span>
          </div>
        )}
      </section>

      {featured && featuredScreenshot && (
        <section class="home-section signature-section" aria-labelledby="signature-title">
          <div class="section-topline">
            <p class="section-kicker">{copy.signatureLabel}</p>
            <span class="section-rule"></span>
          </div>
          <a class="featured" href={linkFor(featured.slug)} data-home-featured-slug={featured.slug} data-home-featured-locale={locale} style={`--accent-border: ${featured.accent.border}; --accent-bg: ${featured.accent.background}; --accent-text: ${featured.accent.text};`}>
            <div class="featured-image-stage">
              <div class="featured-screen">
                <img src={featuredScreenshot.src} alt={`${featured.title}: ${copy.signatureTitle}`} loading="lazy" decoding="async" width={featuredScreenshot.width} height={featuredScreenshot.height}
                  data-home-artwork-slug={featured.slug} data-home-artwork-locale={locale} data-home-artwork-index={featuredScreenshot.index} data-home-artwork-source={featuredScreenshot.source} />
              </div>
            </div>
            <div class="featured-copy">
              <div class="product-identity">
                <img src={iconPath(featured.slug, 96)} srcset={iconSrcset(featured.slug)} data-home-artwork-icon="true" sizes="64px" alt="" width="64" height="64" loading="lazy" />
                <div>
                  <span class="product-name">{featured.title}</span>
                  <span class="platform-text">{featured.platforms.join(' · ')}</span>
                </div>
              </div>
              <h2 id="signature-title">{copy.signatureTitle}</h2>
              <p>{copy.signatureBody}</p>
              <span class="text-arrow">{copy.exploreApp}<span aria-hidden="true">↗</span></span>
            </div>
          </a>
        </section>
      )}

      <section class="home-section collection-section" aria-labelledby="apps-title">
        <div class="section-topline">
          <p class="section-kicker">{copy.selectedLabel}</p>
          <span class="section-rule"></span>
        </div>
        <div class="section-heading-row">
          <div>
            <h2 id="apps-title">{copy.selectedTitle}</h2>
            <p class="section-description">{copy.selectedIntro}</p>
          </div>
          <a class="inline-link" href={allRouteFor('apps', locale)}>{copy.browse}<span aria-hidden="true">↗</span></a>
        </div>
        <div class="collection-grid">
          {selectedApps.map((app) => {
            const offer = copy.offers[app.slug as keyof typeof copy.offers];
            const screenshot = app.homeScreenshots.supporting;
            return (
              <a class="product-card" href={linkFor(app.slug)} data-home-featured-slug={app.slug} data-home-featured-locale={locale} style={`--accent-bg: ${app.accent.background}; --accent-border: ${app.accent.border}; --accent-text: ${app.accent.text};`}>
                <div class="product-picture">
                  {screenshot ? (
                    <div class="product-screen">
                      <img src={screenshot.src} alt={`${app.title}: ${offer?.category ?? app.title}`} loading="lazy" decoding="async" width={screenshot.width} height={screenshot.height}
                        data-home-artwork-slug={app.slug} data-home-artwork-locale={locale} data-home-artwork-index={screenshot.index} data-home-artwork-source={screenshot.source} />
                    </div>
                  ) : (
                    <img class="fallback-icon" src={iconPath(app.slug, 192)} data-home-artwork-icon="true" alt="" loading="lazy" width="96" height="96" />
                  )}
                </div>
                <div class="product-card-body">
                  <p class="product-category">{offer?.category}</p>
                  <div class="product-card-heading">
                    <h3>{app.title}</h3><span aria-hidden="true">↗</span>
                  </div>
                  <p>{offer?.result}</p>
                  <span class="platform-text">{app.platforms.join(' · ')}</span>
                </div>
              </a>
            );
          })}
        </div>
      </section>

      <section class="home-section trust-section" aria-labelledby="trust-title">
        <div class="section-topline"><p class="section-kicker">{copy.trustLabel}</p><span class="section-rule"></span></div>
        <div class="trust-header">
          <h2 id="trust-title">{copy.trustTitle}</h2>
          <p>{copy.trustIntro}</p>
        </div>
        <div class="trust-grid">
          {copy.trust.map((item, index) => (
            <article class="trust-item">
              <span class="trust-ordinal" aria-hidden="true">0{index + 1}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </section>


      <SiteFooter locale={locale} />
    </div>
  </main>
</BaseLayout>

<script>
  import '../scripts/home-carousel';
</script>
