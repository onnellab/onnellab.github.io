---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocaleMenu from './LocaleMenu.astro';
import SiteFooter from './SiteFooter.astro';
import { getProductIndexItems, type ProductIndexItem } from '../lib/products';
import {
  contentLocale,
  localeAlternates,
  localeDefinitions,
  productRouteFor,
  routeFor,
  type SiteLocale
} from '../lib/site-i18n';

type Props = {
  locale: SiteLocale;
};

type HomeCopy = {
  nav: {
    apps: string;
    about: string;
    privacy: string;
    terms: string;
  };
  navLabel: string;
  platformsLabel: string;
  featuredIconAlt: string;
  blogVisibleLabel: string;
  seoTitle: string;
  description: string;
  eyebrow: string;
  title: string;
  intro: string;
  featuredLabel: string;
  featuredTitle: string;
  featuredBody: string;
  appsTitle: string;
  allApps: string;
  valuesTitle: string;
  values: Array<{ title: string; body: string }>;
};

const copies: Record<SiteLocale, HomeCopy> = {
  en: {
    nav: { apps: 'Apps', about: 'About', privacy: 'Privacy', terms: 'Terms' },
    navLabel: 'Navigation',
    platformsLabel: 'Platforms',
    featuredIconAlt: 'TagWeaver app icon',
    blogVisibleLabel: 'Blog',
    seoTitle: 'ONNELLAB - Focused apps for files and creative work',
    description: 'ONNELLAB makes focused apps for managing files, media, creative work, and everyday tasks.',
    eyebrow: 'Independent software studio',
    title: 'Small tools. Calmly made.',
    intro:
      'ONNELLAB builds focused apps that keep files, creative work, and everyday tasks under your control.\nNo clutter, and no forced accounts where they are not needed.',
    featuredLabel: 'Featured app',
    featuredTitle: 'Organize music tags with TagWeaver.',
    featuredBody: 'Save MP3 and FLAC metadata, artwork, and lyrics to local files, and update multiple tracks at once.',
    appsTitle: 'More apps',
    allApps: 'View all',
    valuesTitle: 'How we build',
    values: [
      { title: 'One clear job', body: 'Each product starts with a focused task and stops before it becomes a platform.' },
      { title: 'Calm by default', body: 'Soft visuals, readable copy, and fewer interruptions keep the work in front.' },
      { title: 'User-controlled', body: 'Local-first processing and minimal permissions are preferred whenever the product allows it.' }
    ]
  },
  ko: {
    nav: { apps: '앱', about: '소개', privacy: '개인정보', terms: '이용약관' },
    navLabel: '탐색',
    platformsLabel: '플랫폼',
    featuredIconAlt: 'TagWeaver 앱 아이콘',
    blogVisibleLabel: '블로그',
    seoTitle: 'ONNELLAB - 파일과 창작 작업을 위한 앱',
    description: 'ONNELLAB은 파일과 미디어를 관리하고 창작 작업과 일상의 일을 돕는 목적이 분명한 앱을 만들어요.',
    eyebrow: '독립 소프트웨어 스튜디오',
    title: '작은 도구를, 차분하게 만들어요.',
    intro:
      'ONNELLAB은 파일과 창작물, 일상의 작업을 사용자가 직접 관리할 수 있는 목적이 분명한 앱을 만들어요.\n기능을 쌓아 올리거나 필요 없는 계정을 강요하지 않아요.',
    featuredLabel: '대표 앱',
    featuredTitle: 'TagWeaver로 음악 태그를 직접 정리해요.',
    featuredBody: 'MP3·FLAC의 정보와 커버, 가사를 파일에 저장하고 여러 곡을 한 번에 수정해요.',
    appsTitle: '다른 앱',
    allApps: '전체 보기',
    valuesTitle: '만드는 원칙',
    values: [
      { title: '한 가지 분명한 일', body: '각 앱은 하나의 작업에서 시작하고 플랫폼이 되기 전에 멈춰요.' },
      { title: '기본값부터 차분하게', body: '부드러운 화면과 읽기 쉬운 문구, 적은 방해로 작업을 앞에 둬요.' },
      { title: '사용자가 통제해요', body: '가능한 제품은 로컬 우선으로 처리하고 꼭 필요한 권한만 사용해요.' }
    ]
  },
  ja: {
    nav: { apps: 'アプリ', about: '紹介', privacy: 'プライバシー', terms: '利用規約' },
    navLabel: 'ナビゲーション',
    platformsLabel: '対応プラットフォーム',
    featuredIconAlt: 'TagWeaverアプリアイコン',
    blogVisibleLabel: 'ブログ',
    seoTitle: 'ONNELLAB - ファイルと創作作業のためのアプリ',
    description: 'ONNELLABは、ファイルやメディアの管理、創作、日々の作業に役立つ、目的の明確なアプリをつくります。',
    eyebrow: 'インディーソフトウェアスタジオ',
    title: '小さな道具を、静かに。',
    intro:
      'ONNELLABは、ファイルや創作、日々の作業を自分の手元で扱える、目的のはっきりしたアプリをつくります。\n不要な機能や、必要のないアカウントを増やしません。',
    featuredLabel: '代表アプリ',
    featuredTitle: 'TagWeaverで音楽タグを整理。',
    featuredBody: 'MP3・FLACの情報、ジャケット、歌詞をローカルファイルに保存し、複数曲をまとめて編集できます。',
    appsTitle: 'ほかのアプリ',
    allApps: '一覧を見る',
    valuesTitle: 'ものづくりの原則',
    values: [
      { title: 'ひとつの明確な役割', body: '一つの仕事から始め、プラットフォームになる前に止めます。' },
      { title: '最初から静かに', body: '柔らかな画面、読みやすい文章、少ない中断で作業を前に置きます。' },
      { title: '利用者の手元に', body: '可能な製品はローカル優先で処理し、必要最小限のアクセスだけを求めます。' }
    ]
  },
  'zh-Hans': {
    nav: { apps: '应用', about: '关于', privacy: '隐私', terms: '使用条款' },
    navLabel: '导航',
    platformsLabel: '支持平台',
    featuredIconAlt: 'TagWeaver 应用图标',
    blogVisibleLabel: '博客',
    seoTitle: 'ONNELLAB - 专注于文件与创作的应用',
    description: 'ONNELLAB 打造用途明确的应用，帮助你管理文件与媒体，完成创作和日常任务。',
    eyebrow: '独立软件工作室',
    title: '把小工具，安静地做好。',
    intro:
      'ONNELLAB 打造用途明确的应用，让文件、创作内容与日常任务始终由你掌控。\n我们不堆叠功能，也不强迫你注册不必要的账号。',
    featuredLabel: '代表应用',
    featuredTitle: '用 TagWeaver 整理音乐标签。',
    featuredBody: '将 MP3 与 FLAC 信息、封面和歌词保存到本地文件，并批量编辑多首歌曲。',
    appsTitle: '其他应用',
    allApps: '查看全部',
    valuesTitle: '我们的制作原则',
    values: [
      { title: '只做好一件事', body: '每个产品从一个明确任务开始，并在变成平台之前停下。' },
      { title: '默认保持安静', body: '柔和的界面、易读的文字和更少的打扰，让任务始终在前。' },
      { title: '由用户掌控', body: '在产品允许时优先本地处理，并只请求必要权限。' }
    ]
  },
  'zh-Hant': {
    nav: { apps: '應用程式', about: '關於', privacy: '隱私', terms: '使用條款' },
    navLabel: '導覽',
    platformsLabel: '支援平台',
    featuredIconAlt: 'TagWeaver 應用程式圖示',
    blogVisibleLabel: '部落格',
    seoTitle: 'ONNELLAB - 專注於檔案與創作的應用程式',
    description: 'ONNELLAB 打造用途明確的應用程式，幫助你管理檔案與媒體，完成創作與日常工作。',
    eyebrow: '獨立軟體工作室',
    title: '把小工具，安靜地做好。',
    intro:
      'ONNELLAB 打造用途明確的應用程式，讓檔案、創作內容與日常工作始終由你掌控。\n我們不堆疊功能，也不強迫你註冊不必要的帳號。',
    featuredLabel: '代表應用程式',
    featuredTitle: '用 TagWeaver 整理音樂標籤。',
    featuredBody: '將 MP3 與 FLAC 資訊、封面與歌詞儲存到本機檔案，並批次編輯多首歌曲。',
    appsTitle: '其他應用程式',
    allApps: '查看全部',
    valuesTitle: '我們的製作原則',
    values: [
      { title: '只做好一件事', body: '每個產品從一項明確工作開始，並在變成平台之前停下。' },
      { title: '預設保持安靜', body: '柔和的畫面、易讀的文字與更少的打擾，讓工作始終在前。' },
      { title: '由使用者掌控', body: '在產品允許時優先本機處理，並只要求必要權限。' }
    ]
  }
};

const { locale } = Astro.props;
const copy = copies[locale];
const definition = localeDefinitions[locale];
const canonicalPath = routeFor('home', locale);
const existingApps = getProductIndexItems(contentLocale(locale));
const releasedAppOrder = ['Aligna', 'ClipNest', 'Quivra', 'Segra', 'TagWeaver', 'VaultXT'];
const releasedAppNames = new Set(releasedAppOrder);
const releasedApps = existingApps
  .filter(
    (app): app is ProductIndexItem =>
      app.status === 'Released' && app.hasStoreListing && releasedAppNames.has(app.title)
  )
  .sort((a, b) => releasedAppOrder.indexOf(a.title) - releasedAppOrder.indexOf(b.title));
const featuredApp = releasedApps.find((app) => app.title === 'TagWeaver') ?? releasedApps[0];
const appHref = (slug: string) => productRouteFor(slug, locale);
const featuredHref = featuredApp ? appHref(featuredApp.slug) : routeFor('apps', locale);
const featuredOthers = releasedApps
  .filter((app) => app.title !== featuredApp?.title)
  .slice(0, 4)
  .map((app) => ({ ...app, href: appHref(app.slug) }));
const appCardStyle = (app: ProductIndexItem) =>
  `--accent-border: ${app.accent.border}; --accent-bg: ${app.accent.background}; --accent-text: ${app.accent.text};`;
const homeIconPath = (slug: string, size: 96 | 192) => `/home-assets/app-icons/${slug}-${size}.webp`;
const homeIconSrcset = (slug: string) =>
  `${homeIconPath(slug, 96)} 96w, ${homeIconPath(slug, 192)} 192w`;
const blogHref = locale === 'ko'
  ? '/blog/ko/'
  : locale === 'ja'
    ? '/blog/ja/'
    : locale === 'zh-Hans'
      ? '/blog/zh-hans/'
      : locale === 'zh-Hant'
        ? '/blog/zh-hant/'
        : '/blog/';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': new URL('/#organization', Astro.site).toString(),
    name: 'ONNELLAB',
    url: new URL('/', Astro.site).toString(),
    email: 'onnellab.app@gmail.com',
    contactPoint: {
      '@type': 'ContactPoint',
      email: 'onnellab.app@gmail.com',
      contactType: 'customer support',
      availableLanguage: ['en', 'ko', 'ja', 'zh-Hans', 'zh-Hant', 'pt-BR', 'de', 'fr', 'es']
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': new URL('/#website', Astro.site).toString(),
    name: 'ONNELLAB',
    url: new URL(canonicalPath, Astro.site).toString(),
    description: copy.description,
    inLanguage: definition.htmlLang,
    publisher: { '@id': new URL('/#organization', Astro.site).toString() }
  }
];
---

<BaseLayout
  title={copy.seoTitle}
  description={copy.description}
  canonicalPath={canonicalPath}
  lang={definition.htmlLang}
  jsonLd={jsonLd}
  alternates={localeAlternates('home')}
  socialImage="/social-card.png"
>
  <main class="site-shell" data-core-page="home" data-locale={locale}>
    <nav class="top-nav site-header" aria-label={copy.navLabel}>
      <a class="brand" href={routeFor('home', locale)}>ONNELLAB</a>
      <div class="nav-links">
        <a href={routeFor('apps', locale)}>{copy.nav.apps}</a>
        <a href={routeFor('about', locale)}>{copy.nav.about}</a>
        <a href={blogHref}>{copy.blogVisibleLabel}</a>
        <LocaleMenu locale={locale} page="home" />
      </div>
    </nav>

    <header class="home-hero">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>
        {locale === 'ko' ? (
          <><span class="title-line">작은 도구를,</span>{' '}<span class="title-line">차분하게 만들어요.</span></>
        ) : locale === 'ja' ? (
          <><span class="title-line">小さな道具を、</span>{' '}<span class="title-line">静かに。</span></>
        ) : copy.title}
      </h1>
      <p class="lede">{copy.intro}</p>
    </header>

    {featuredApp && (
      <a
        class="featured"
        href={featuredHref}
        aria-labelledby="featured-title"
        style={appCardStyle(featuredApp)}
      >
        <div class="featured-topline">
          <span class="featured-label">{copy.featuredLabel}</span>
          <div class="platform-badges" role="group" aria-label={copy.platformsLabel}>
            {featuredApp.platforms.map((platform) => <span>{platform}</span>)}
          </div>
        </div>
        <div class="featured-body">
          <img
            src={homeIconPath(featuredApp.slug, 96)}
            srcset={homeIconSrcset(featuredApp.slug)}
            sizes="(max-width: 520px) 64px, 92px"
            alt={copy.featuredIconAlt}
            width="92"
            height="92"
            data-no-visual-search="true"
          />
          <div class="featured-copy">
            <h2 id="featured-title">{copy.featuredTitle}</h2>
            <p>{copy.featuredBody}</p>
          </div>
        </div>
      </a>
    )}

    <section class="section" aria-labelledby="apps-title">
      <div class="section-head">
        <h2 id="apps-title">{copy.appsTitle}</h2>
        <a href={routeFor('apps', locale)}>{copy.allApps}</a>
      </div>
      <div class="product-grid">
        {featuredOthers.map((app) => (
          <a class="product-card" href={app.href} style={appCardStyle(app)}>
            <img
              src={homeIconPath(app.slug, 96)}
              srcset={homeIconSrcset(app.slug)}
              sizes="44px"
              alt=""
              width="44"
              height="44"
              loading="lazy"
              data-no-visual-search="true"
            />
            <div>
              <h3>{app.title}</h3>
              <p>{app.description}</p>
              <div class="platform-badges" role="group" aria-label={copy.platformsLabel}>
                {app.platforms.map((platform) => <span>{platform}</span>)}
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="section values" aria-labelledby="values-title">
      <h2 id="values-title">{copy.valuesTitle}</h2>
      <div class="value-grid">
        {copy.values.map((value) => (
          <article>
            <h3>{value.title}</h3>
            <p>{value.body}</p>
          </article>
        ))}
      </div>
    </section>

    <SiteFooter locale={locale} />
  </main>
</BaseLayout>

<style>
  @font-face {
    font-family: "ONNELLAB Japanese Nav";
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url("/fonts/noto-sans-jp-nav-600.woff2") format("woff2");
  }

  @font-face {
    font-family: "ONNELLAB Simplified Chinese Nav";
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url("/fonts/noto-sans-sc-nav-600.woff2") format("woff2");
  }

  @font-face {
    font-family: "ONNELLAB Traditional Chinese Nav";
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url("/fonts/noto-sans-tc-nav-600.woff2") format("woff2");
  }

  .site-shell {
    width: min(1080px, calc(100% - 40px));
    margin: 0 auto;
    padding: 26px 0 54px;
    color: #3f3b35;
  }

  .top-nav,
  .nav-links,
  .section-head {
    display: flex;
    align-items: center;
  }

  .top-nav {
    justify-content: space-between;
    gap: 20px;
  }

  .nav-links > a,
  .section-head a {
    color: #686259;
    font-size: 13px;
    font-weight: 620;
    text-decoration: none;
  }

  .site-shell[data-locale='ja'] .nav-links > a {
    font-family: "ONNELLAB Japanese Nav", "SUIT Variable", sans-serif;
    font-weight: 600;
  }

  .site-shell[data-locale='zh-Hans'] .nav-links > a {
    font-family: "ONNELLAB Simplified Chinese Nav", "SUIT Variable", sans-serif;
    font-weight: 600;
  }

  .site-shell[data-locale='zh-Hant'] .nav-links > a {
    font-family: "ONNELLAB Traditional Chinese Nav", "SUIT Variable", sans-serif;
    font-weight: 600;
  }

  .brand {
    color: #737067;
    font-size: 14px;
    font-weight: 560;
    letter-spacing: 0;
    text-decoration: none;
  }

  .nav-links {
    gap: 16px;
  }

  .top-nav a:hover,
  .section-head a:hover {
    color: #2f2d29;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .home-hero {
    max-width: 1080px;
    padding: clamp(88px, 13vw, 154px) 0 clamp(60px, 8vw, 92px);
  }

  .eyebrow {
    margin: 0 0 18px;
    color: #786f65;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 940px;
    margin: 0;
    color: #37332e;
    font-size: clamp(48px, 9vw, 96px);
    font-weight: 650;
    letter-spacing: -0.055em;
    line-height: 0.98;
    text-wrap: balance;
  }

  :global(html[lang='ko']) h1 {
    letter-spacing: -0.04em;
    line-height: 1.08;
    word-break: keep-all;
  }

  .site-shell[data-locale='ja'] .home-hero .title-line {
    display: block;
  }

  .lede {
    max-width: 1080px;
    margin: 28px 0 0;
    color: #6a6359;
    font-size: clamp(17px, 2vw, 21px);
    line-height: 1.75;
    white-space: pre-line;
    text-wrap: pretty;
  }

  .featured {
    position: relative;
    display: grid;
    gap: 22px;
    border: 1px solid var(--accent-border, #ded6ca);
    border-radius: 12px;
    padding: 24px 26px 27px;
    background:
      linear-gradient(135deg, var(--accent-bg, #fffdf8), rgba(255, 253, 248, 0.96) 58%, #fffdf8 90%),
      #fffdf8;
    color: inherit;
    cursor: pointer;
    overflow: hidden;
    text-decoration: none;
    transition: transform 150ms ease, border-color 150ms ease, background 150ms ease, box-shadow 150ms ease;
  }

  .featured::after {
    content: '';
    position: absolute;
    inset: 0;
    border-top: 1px solid rgba(255, 253, 248, 0.9);
    box-shadow: inset 0 0 0 1px rgba(255, 253, 248, 0.34);
    pointer-events: none;
  }

  .featured:hover,
  .featured:focus-visible {
    border-color: var(--accent-border, #d8cec0);
    background:
      linear-gradient(135deg, var(--accent-bg, #fffdf8), rgba(255, 253, 248, 0.9) 52%, #fffdf8 88%),
      #fffdf8;
    box-shadow:
      inset 0 0 0 1px rgba(255, 253, 248, 0.52),
      0 12px 26px rgba(58, 49, 38, 0.052);
    transform: translateY(-2px);
  }

  .featured:focus-visible {
    outline: 2px solid #827d72;
    outline-offset: 3px;
  }

  .featured-topline {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .featured-label {
    color: var(--accent-text, #685e50);
    font-size: 13px;
    font-weight: 680;
  }

  .featured-body {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    align-items: center;
    gap: 25px;
  }

  .featured-body > img {
    width: 92px;
    height: 92px;
    border-radius: 21px;
    box-shadow:
      0 0 0 1px var(--accent-border, #ddd5c8),
      0 10px 24px rgba(58, 49, 38, 0.06);
  }

  .featured h2,
  .section > h2,
  .section-head h2 {
    margin: 0;
    color: #3b3732;
    font-size: clamp(28px, 4.3vw, 46px);
    font-weight: 640;
    letter-spacing: -0.04em;
    line-height: 1.12;
  }

  .featured-copy > p {
    max-width: 860px;
    margin: 14px 0 0;
    color: #5d564d;
    font-size: 16px;
    line-height: 1.68;
  }

  .section {
    border-bottom: 1px solid #e1d9cd;
    padding: 60px 0 68px;
  }

  .section-head {
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }

  .section-head a {
    text-decoration: underline;
    text-decoration-color: #cfc5b7;
    text-underline-offset: 5px;
  }

  .product-grid,
  .value-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 15px;
  }

  .product-card {
    position: relative;
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr);
    align-items: start;
    gap: 16px;
    min-height: 116px;
    border: 1px solid var(--accent-border, #ded6ca);
    border-radius: 12px;
