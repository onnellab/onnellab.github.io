---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocaleMenu from './LocaleMenu.astro';
import { getProductIndexItems, type ProductIndexItem } from '../lib/products';
import {
  contentLocale,
  localeAlternates,
  localeDefinitions,
  routeFor,
  type SiteLocale
} from '../lib/site-i18n';

type Props = {
  locale: SiteLocale;
};

type HomeCopy = {
  nav: {
    apps: string;
    about: string;
    blog: string;
    privacy: string;
    terms: string;
  };
  seoTitle: string;
  description: string;
  eyebrow: string;
  title: string;
  intro: string;
  featuredLabel: string;
  featuredTitle: string;
  featuredBody: string;
  featuredAction: string;
  appsTitle: string;
  allApps: string;
  valuesTitle: string;
  values: Array<{ title: string; body: string }>;
};

const copies: Record<SiteLocale, HomeCopy> = {
  en: {
    nav: { apps: 'Apps', about: 'About', blog: 'Blog', privacy: 'Privacy', terms: 'Terms' },
    seoTitle: 'ONNELLAB - Calm, focused software',
    description: 'ONNELLAB builds small, focused apps for files, creative work, and everyday tasks.',
    eyebrow: 'Independent software studio',
    title: 'Small tools. Calmly made.',
    intro:
      'ONNELLAB builds focused apps that keep files, creative work, and everyday tasks under your control. No clutter, and no forced accounts where they are not needed.',
    featuredLabel: 'Featured app',
    featuredTitle: 'TagWeaver keeps MP3 and FLAC metadata under your control.',
    featuredBody:
      'Edit titles, artists, albums, artwork, lyrics, ratings, and batches directly in local audio files—without uploading them.',
    featuredAction: 'Explore TagWeaver',
    appsTitle: 'More ONNELLAB apps',
