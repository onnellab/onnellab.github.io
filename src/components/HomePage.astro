    valuesTitle: 'How we build',
    values: [
      { title: 'One clear job', body: 'Each product starts with a focused task and stops before it becomes a platform.' },
      { title: 'Calm by default', body: 'Soft visuals, readable copy, and fewer interruptions keep the work in front.' },
      { title: 'User-controlled', body: 'Local-first processing and minimal permissions are preferred whenever the product allows it.' }
    ]
  },
  ko: {
    nav: { apps: '앱', about: '소개', blog: '블로그', privacy: '개인정보', terms: '이용약관' },
    seoTitle: 'ONNELLAB - 차분하고 목적이 분명한 소프트웨어',
    description: 'ONNELLAB은 파일, 창작 작업과 일상을 위한 작고 목적이 분명한 앱을 만들어요.',
    eyebrow: '독립 소프트웨어 스튜디오',
    title: '작은 도구를, 차분하게 만들어요.',
    intro:
      'ONNELLAB은 파일과 창작물, 일상의 작업을 사용자가 직접 관리할 수 있는 목적이 분명한 앱을 만들어요. 기능을 쌓아 올리거나 필요 없는 계정을 강요하지 않아요.',
    featuredLabel: '대표 앱',
    featuredTitle: 'TagWeaver로 MP3·FLAC 태그를 직접 정리해요.',
    featuredBody:
      '제목, 아티스트, 앨범, 커버, 가사와 별점을 파일에 직접 저장하고 여러 곡을 한 번에 수정해요.',
    featuredAction: 'TagWeaver 살펴보기',
    appsTitle: '다른 ONNELLAB 앱',
    allApps: '모든 앱 보기',
    valuesTitle: '만드는 원칙',
    values: [
      { title: '한 가지 분명한 일', body: '각 앱은 하나의 작업에서 시작하고 플랫폼이 되기 전에 멈춰요.' },
      { title: '기본값부터 차분하게', body: '부드러운 화면과 읽기 쉬운 문구, 적은 방해로 작업을 앞에 둬요.' },
      { title: '사용자가 통제해요', body: '가능한 제품은 로컬 우선으로 처리하고 꼭 필요한 권한만 사용해요.' }
    ]
  },
  ja: {
    nav: { apps: 'アプリ', about: 'ONNELLABについて', blog: 'ブログ', privacy: 'プライバシー', terms: '利用規約' },
    seoTitle: 'ONNELLAB - 静かで目的の明確なソフトウェア',
    description: 'ONNELLABは、ファイル、創作、日々の作業のための小さく目的の明確なアプリをつくります。',
    eyebrow: 'インディーソフトウェアスタジオ',
    title: '小さな道具を、静かに。',
    intro:
      'ONNELLABは、ファイルや創作、日々の作業を自分の手元で扱える、目的のはっきりしたアプリをつくります。不要な機能や、必要のないアカウントを増やしません。',
    featuredLabel: '代表アプリ',
    featuredTitle: 'TagWeaverでMP3・FLACタグを直接整えます。',
    featuredBody:
      'タイトル、アーティスト、アルバム、ジャケット、歌詞、評価を端末上のファイルへ直接保存し、複数曲をまとめて編集できます。',
    featuredAction: 'TagWeaverを見る',
    appsTitle: 'ほかのONNELLABアプリ',
    allApps: 'すべてのアプリ',
    valuesTitle: 'ものづくりの原則',
    values: [
      { title: 'ひとつの明確な役割', body: '一つの仕事から始め、プラットフォームになる前に止めます。' },
      { title: '最初から静かに', body: '柔らかな画面、読みやすい文章、少ない中断で作業を前に置きます。' },
      { title: '利用者の手元に', body: '可能な製品はローカル優先で処理し、必要最小限のアクセスだけを求めます。' }
    ]
  },
  'zh-Hans': {
    nav: { apps: '应用', about: '关于', blog: '博客', privacy: '隐私', terms: '使用条款' },
    seoTitle: 'ONNELLAB - 安静而专注的软件',
    description: 'ONNELLAB 为文件、创作与日常任务打造小而专注的应用。',
    eyebrow: '独立软件工作室',
    title: '把小工具，安静地做好。',
    intro:
      'ONNELLAB 打造用途明确的应用，让文件、创作内容与日常任务始终由你掌控。我们不堆叠功能，也不强迫你注册不必要的账号。',
    featuredLabel: '代表应用',
    featuredTitle: '用 TagWeaver 直接整理 MP3 与 FLAC 标签。',
    featuredBody:
      '可直接编辑标题、艺术家、专辑、封面、歌词与评分，并批量写入本地音频文件。',
    featuredAction: '查看 TagWeaver',
    appsTitle: '更多 ONNELLAB 应用',
    allApps: '查看全部应用',
    valuesTitle: '我们的制作原则',
    values: [
      { title: '只做好一件事', body: '每个产品从一个明确任务开始，并在变成平台之前停下。' },
      { title: '默认保持安静', body: '柔和的界面、易读的文字和更少的打扰，让任务始终在前。' },
      { title: '由用户掌控', body: '在产品允许时优先本地处理，并只请求必要权限。' }
    ]
  },
  'zh-Hant': {
    nav: { apps: '應用程式', about: '關於', blog: '部落格', privacy: '隱私', terms: '使用條款' },
    seoTitle: 'ONNELLAB - 安靜而專注的軟體',
    description: 'ONNELLAB 為檔案、創作與日常工作打造小而專注的應用程式。',
    eyebrow: '獨立軟體工作室',
    title: '把小工具，安靜地做好。',
    intro:
      'ONNELLAB 打造用途明確的應用程式，讓檔案、創作內容與日常工作始終由你掌控。我們不堆疊功能，也不強迫你註冊不必要的帳號。',
    featuredLabel: '代表應用程式',
    featuredTitle: '用 TagWeaver 直接整理 MP3 與 FLAC 標籤。',
    featuredBody:
      '可直接編輯標題、藝人、專輯、封面、歌詞與評分，並批次寫入本機音訊檔案。',
    featuredAction: '查看 TagWeaver',
    appsTitle: '更多 ONNELLAB 應用程式',
    allApps: '查看全部應用程式',
    valuesTitle: '我們的製作原則',
    values: [
      { title: '只做好一件事', body: '每個產品從一項明確工作開始，並在變成平台之前停下。' },
      { title: '預設保持安靜', body: '柔和的畫面、易讀的文字與更少的打擾，讓工作始終在前。' },
      { title: '由使用者掌控', body: '在產品允許時優先本機處理，並只要求必要權限。' }
    ]
  }
};

const { locale } = Astro.props;
const copy = copies[locale];
const definition = localeDefinitions[locale];
const canonicalPath = routeFor('home', locale);
const existingApps = getProductIndexItems(contentLocale(locale));
const releasedAppOrder = ['Aligna', 'ClipNest', 'Quivra', 'Segra', 'TagWeaver', 'VaultXT'];
const releasedAppNames = new Set(releasedAppOrder);
const releasedApps = existingApps
  .filter(
    (app): app is ProductIndexItem =>
      app.status === 'Released' && app.hasStoreListing && releasedAppNames.has(app.title)
  )
  .sort((a, b) => releasedAppOrder.indexOf(a.title) - releasedAppOrder.indexOf(b.title));
const featuredApp = releasedApps.find((app) => app.title === 'TagWeaver') ?? releasedApps[0];
const appHref = (slug: string) => (locale === 'ko' ? `/apps/${slug}/ko/` : `/apps/${slug}/`);
const featuredHref = featuredApp ? appHref(featuredApp.slug) : routeFor('apps', locale);
const featuredOthers = releasedApps
  .filter((app) => app.title !== featuredApp?.title)
  .slice(0, 4)
  .map((app) => ({ ...app, href: appHref(app.slug) }));
const blogHref = locale === 'ko' ? '/blog/ko/' : '/blog/';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': new URL('/#organization', Astro.site).toString(),
    name: 'ONNELLAB',
    url: new URL('/', Astro.site).toString(),
    email: 'onnellab.app@gmail.com',
    contactPoint: {
      '@type': 'ContactPoint',
      email: 'onnellab.app@gmail.com',
      contactType: 'customer support',
      availableLanguage: ['en', 'ko', 'ja', 'zh-Hans', 'zh-Hant']
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': new URL('/#website', Astro.site).toString(),
    name: 'ONNELLAB',
    url: new URL(canonicalPath, Astro.site).toString(),
    description: copy.description,
    inLanguage: definition.htmlLang,
    publisher: { '@id': new URL('/#organization', Astro.site).toString() }
  }
];
---

<BaseLayout
  title={copy.seoTitle}
  description={copy.description}
  canonicalPath={canonicalPath}
  lang={definition.htmlLang}
  jsonLd={jsonLd}
  alternates={localeAlternates('home')}
>
  <main class="site-shell" data-core-page="home">
    <nav class="top-nav" aria-label="Navigation">
      <a class="brand" href={routeFor('home', locale)}>ONNELLAB</a>
      <div class="nav-links">
        <a href={routeFor('apps', locale)}>{copy.nav.apps}</a>
        <a href={routeFor('about', locale)}>{copy.nav.about}</a>
        <a href={blogHref}>{copy.nav.blog}</a>
        <LocaleMenu locale={locale} page="home" />
      </div>
    </nav>

    <header class="home-hero">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.title}</h1>
      <p class="lede">{copy.intro}</p>
    </header>

    {featuredApp && (
      <section class="featured" aria-labelledby="featured-title">
        <div class="featured-icon">
          <img
            src={featuredApp.iconPath}
            alt="TagWeaver app icon"
            width="112"
            height="112"
            data-no-visual-search="true"
          />
        </div>
        <div>
          <p class="eyebrow">{copy.featuredLabel}</p>
          <h2 id="featured-title">{copy.featuredTitle}</h2>
          <p>{copy.featuredBody}</p>
          <a class="text-link" href={featuredHref}>{copy.featuredAction}</a>
        </div>
      </section>
    )}

    <section class="section" aria-labelledby="apps-title">
      <div class="section-head">
        <h2 id="apps-title">{copy.appsTitle}</h2>
        <a href={routeFor('apps', locale)}>{copy.allApps}</a>
      </div>
      <div class="product-grid">
        {featuredOthers.map((app) => (
          <a class="product-card" href={app.href}>
            <img src={app.iconPath} alt="" width="56" height="56" loading="lazy" data-no-visual-search="true" />
            <h3>{app.title}</h3>
            <p>{app.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="section values" aria-labelledby="values-title">
      <h2 id="values-title">{copy.valuesTitle}</h2>
      <div class="value-grid">
        {copy.values.map((value) => (
          <article>
            <h3>{value.title}</h3>
            <p>{value.body}</p>
          </article>
        ))}
      </div>
    </section>

    <footer>
      <a href={routeFor('privacy', locale)}>{copy.nav.privacy}</a>
      <a href={routeFor('terms', locale)}>{copy.nav.terms}</a>
      <a href="mailto:onnellab.app@gmail.com">onnellab.app@gmail.com</a>
      <span>© ONNELLAB</span>
    </footer>
  </main>
</BaseLayout>

<style>
  .site-shell {
    width: min(1080px, calc(100% - 40px));
    margin: 0 auto;
    padding: 26px 0 54px;
    color: #3f3b35;
  }

  .top-nav,
  .nav-links,
  .section-head,
  footer {
    display: flex;
    align-items: center;
  }

  .top-nav {
    justify-content: space-between;
    gap: 20px;
  }

  .brand,
  .nav-links > a,
  .section-head a,
  footer a {
    color: #686259;
    font-size: 13px;
    font-weight: 620;
    text-decoration: none;
  }

  .brand {
    letter-spacing: 0.02em;
  }

  .nav-links {
    gap: 16px;
  }

  .top-nav a:hover,
  .section-head a:hover,
  footer a:hover {
    color: #2f2d29;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .home-hero {
    max-width: 940px;
    padding: clamp(88px, 13vw, 154px) 0 clamp(60px, 8vw, 92px);
  }

  .eyebrow {
    margin: 0 0 18px;
    color: #8b8175;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 940px;
    margin: 0;
    color: #37332e;
    font-size: clamp(48px, 9vw, 96px);
    font-weight: 650;
    letter-spacing: -0.055em;
    line-height: 0.98;
    text-wrap: balance;
  }

  :global(html[lang='ko']) h1 {
    word-break: keep-all;
  }

  .lede {
    max-width: 760px;
    margin: 28px 0 0;
    color: #6a6359;
    font-size: clamp(17px, 2vw, 21px);
    line-height: 1.75;
  }

  .featured {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: clamp(28px, 5vw, 58px);
    align-items: center;
    border-top: 1px solid #ddd4c8;
    border-bottom: 1px solid #ddd4c8;
    padding: 58px 0;
  }

  .featured-icon img {
    width: 112px;
    height: 112px;
    border-radius: 25px;
    box-shadow: 0 14px 34px rgba(58, 49, 40, 0.12);
  }

  .featured h2,
  .section > h2,
  .section-head h2 {
    margin: 0;
    color: #3b3732;
    font-size: clamp(28px, 4.3vw, 46px);
    font-weight: 640;
    letter-spacing: -0.04em;
    line-height: 1.12;
  }

  .featured > div > p:not(.eyebrow) {
    max-width: 700px;
    margin: 18px 0 0;
    color: #696158;
    font-size: 16px;
    line-height: 1.75;
  }

  .text-link {
    display: inline-block;
    margin-top: 22px;
    color: #4d6175;
    font-size: 14px;
    font-weight: 650;
    text-underline-offset: 5px;
  }

  .section {
    border-bottom: 1px solid #e1d9cd;
    padding: 66px 0 72px;
  }

  .section-head {
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 30px;
  }

  .section-head a {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .product-grid,
  .value-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .product-card {
    min-height: 185px;
    border: 1px solid #ded6ca;
    border-radius: 17px;
    padding: 25px;
    background: rgba(255, 253, 248, 0.62);
    color: inherit;
    text-decoration: none;
    transition: transform 150ms ease, border-color 150ms ease, background 150ms ease;
  }

  .product-card:hover,
  .product-card:focus-visible {
    border-color: #cfc4b5;
    background: #fffdf8;
    transform: translateY(-2px);
  }

  .product-card:focus-visible {
    outline: 2px solid #827d72;
    outline-offset: 3px;
  }

  .product-card img {
    border-radius: 13px;
  }

  .product-card h3,
  .value-grid h3 {
    margin: 18px 0 0;
    color: #403b35;
    font-size: 19px;
    font-weight: 650;
  }

  .product-card p,
  .value-grid p {
    margin: 10px 0 0;
    color: #71695f;
    font-size: 14px;
    line-height: 1.65;
  }

  .value-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 32px;
  }

  .value-grid article {
    border-top: 2px solid #c7bad3;
    padding: 22px 8px 0 0;
  }

  .value-grid h3 {
    margin-top: 0;
  }

  footer {
    flex-wrap: wrap;
    justify-content: center;
    gap: 9px 20px;
    margin-top: 58px;
    border-top: 1px solid #ded6ca;
    padding-top: 28px;
    color: #857d72;
    font-size: 12px;
  }

  @media (max-width: 760px) {
    .site-shell {
      width: min(100% - 30px, 1080px);
      padding-top: 20px;
    }

    .nav-links {
      gap: 10px;
    }

    .nav-links > a:nth-of-type(2),
    .nav-links > a:nth-of-type(3) {
      display: none;
    }

    .featured {
      grid-template-columns: 1fr;
    }

    .product-grid,
    .value-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .site-shell {
      width: min(100% - 28px, 1080px);
      padding-top: 18px;
    }

    .home-hero {
      padding: 40px 0 34px;
    }

    .home-hero .eyebrow {
      margin-bottom: 12px;
    }

    .home-hero h1 {
      max-width: 11ch;
      font-size: clamp(38px, 10.5vw, 44px);
      letter-spacing: -0.03em;
      line-height: 1.07;
    }

    .home-hero .lede {
      max-width: 34ch;
      margin-top: 18px;
      color: #5f584f;
      font-size: 16px;
      line-height: 1.65;
      text-wrap: pretty;
    }

    .featured {
      grid-template-columns: 72px minmax(0, 1fr);
      gap: 18px;
      align-items: start;
      padding: 34px 0;
    }

    .featured-icon img {
      width: 72px;
      height: 72px;
      border-radius: 17px;
      box-shadow: 0 8px 22px rgba(58, 49, 40, 0.1);
    }

    .featured .eyebrow {
      margin-bottom: 9px;
      letter-spacing: 0.06em;
    }

    .featured h2 {
      font-size: 25px;
      letter-spacing: -0.035em;
      line-height: 1.18;
    }

    .featured > div > p:not(.eyebrow) {
      margin-top: 12px;
      font-size: 15px;
      line-height: 1.65;
    }

    .text-link {
      margin-top: 16px;
    }

    .section {
      padding: 50px 0 56px;
    }

    .section-head {
      align-items: flex-end;
      margin-bottom: 22px;
    }

    .section-head h2,
    .section > h2 {
      font-size: 29px;
    }

    .product-card {
      min-height: 0;
      padding: 20px;
    }

    footer {
      justify-content: flex-start;
      margin-top: 44px;
    }
  }
</style>
