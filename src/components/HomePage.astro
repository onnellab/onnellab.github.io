---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocaleMenu from './LocaleMenu.astro';
import SiteFooter from './SiteFooter.astro';
import { getProductIndexItems, getProductPageData, type ProductIndexItem } from '../lib/products';
import { showcaseCopy } from '../lib/home-showcase-copy';
import {
  allLocaleAlternates,
  allLocaleDefinitions,
  allProductRouteFor,
  allRouteFor,
  type AllSiteLocale
} from '../lib/extended-site-i18n';
import './home-page.css';

type Props = { locale: AllSiteLocale };

const { locale } = Astro.props;
const copy = showcaseCopy[locale];
const definition = allLocaleDefinitions[locale];
const canonicalPath = allRouteFor('home', locale);
const products = getProductIndexItems(locale);
const releasedApps = products.filter(
  (app) => app.status === 'Released' && app.hasStoreListing && app.slug !== 'summer-sound-maker'
);
const featured = releasedApps.find((app) => app.slug === 'tagweaver');
const selectedApps = (['quivra', 'melivra', 'papira'] as const)
  .map((slug) => releasedApps.find((app) => app.slug === slug))
  .filter((app): app is ProductIndexItem => Boolean(app));
const screenshotFor = (slug: string, index = 0) => {
  const screenshots = getProductPageData(slug, locale).screenshotPaths;
  return screenshots[index] ?? screenshots[0];
};
const heroScreenshot = featured ? screenshotFor(featured.slug, 1) : undefined;
const featuredScreenshot = featured ? screenshotFor(featured.slug, 0) : undefined;
const quivraScreenshot = selectedApps.find((app) => app.slug === 'quivra') ? screenshotFor('quivra') : undefined;
const melivraScreenshot = selectedApps.find((app) => app.slug === 'melivra') ? screenshotFor('melivra') : undefined;
const papiraScreenshot = selectedApps.find((app) => app.slug === 'papira') ? screenshotFor('papira') : undefined;
const screenshotBySlug: Record<string, string | undefined> = {
  quivra: quivraScreenshot,
  melivra: melivraScreenshot,
  papira: papiraScreenshot
};
const iconPath = (slug: string, size: 96 | 192) => `/home-assets/app-icons/${slug}-${size}.webp`;
const iconSrcset = (slug: string) => `${iconPath(slug, 96)} 96w, ${iconPath(slug, 192)} 192w`;
const navigationLabels: Record<AllSiteLocale, string> = {
  en: 'Navigation', ko: '탐색', ja: 'ナビゲーション',
  'zh-Hans': '导航', 'zh-Hant': '導覽',
  'pt-BR': 'Navegação', de: 'Navigation', fr: 'Navigation', es: 'Navegación'
};
const footerLabels: Record<AllSiteLocale, string> = {
  en: 'Footer navigation', ko: '하단 탐색', ja: 'フッターナビゲーション',
  'zh-Hans': '页脚导航', 'zh-Hant': '頁尾導覽',
  'pt-BR': 'Navegação do rodapé', de: 'Footernavigation', fr: 'Navigation de pied de page', es: 'Navegación del pie'
};
const blogHref = `/blog/${definition.pathSegment ? `${definition.pathSegment}/` : ''}`;
const linkFor = (slug: string) => allProductRouteFor(slug, locale);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': new URL('/#organization', Astro.site).toString(),
    name: 'ONNELLAB',
    url: new URL('/', Astro.site).toString(),
    email: 'onnellab.app@gmail.com'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': new URL('/#website', Astro.site).toString(),
    name: 'ONNELLAB',
    url: new URL(canonicalPath, Astro.site).toString(),
    description: copy.description,
    inLanguage: definition.htmlLang,
    publisher: { '@id': new URL('/#organization', Astro.site).toString() }
  }
];
---

<BaseLayout
  title={copy.seoTitle}
  description={copy.description}
  canonicalPath={canonicalPath}
  lang={definition.htmlLang}
  jsonLd={jsonLd}
  alternates={allLocaleAlternates('home')}
  socialImage="/social-card.png"
>
  <main class="site-shell homepage" data-core-page="home" data-locale={locale}>
    <header class="header-wrap">
      <nav class="top-nav site-header" aria-label={navigationLabels[locale]}>
        <a class="brand brand-lockup" href={canonicalPath} aria-label="ONNELLAB">
          <img class="brand-symbol" src="/brand/onnellab-symbol.svg" alt="" width="36" height="30" />
          <span>ONNELLAB</span>
        </a>

        <div class="nav-actions">
          <div class="nav-links">
            <a href={allRouteFor('apps', locale)}>{copy.nav.apps}</a>
            <a href={allRouteFor('about', locale)}>{copy.nav.about}</a>
            <a href={blogHref}>{copy.nav.blog}</a>
          </div>
          <LocaleMenu locale={locale} page="home" />
          <details class="mobile-menu">
            <summary aria-label={copy.nav.menu}>
              <span class="menu-line"></span><span class="menu-line"></span>
            </summary>
            <div class="mobile-menu-panel">
              <a href={allRouteFor('apps', locale)}>{copy.nav.apps}</a>
              <a href={allRouteFor('about', locale)}>{copy.nav.about}</a>
              <a href={blogHref}>{copy.nav.blog}</a>
            </div>
          </details>
        </div>
      </nav>
    </header>

    <div class="content-shell">
      <section class="home-hero" aria-labelledby="home-heading">
        <div class="hero-copy">
          <p class="eyebrow">{copy.eyebrow}</p>
          <h1 id="home-heading">
            {locale === 'ko' ? (
              <><span class="title-line">작은 도구를,</span>{' '}<span class="title-line">세심하게 만들어요.</span></>
            ) : locale === 'ja' ? (
              <><span class="title-line">小さな道具を、</span><span class="title-line">丁寧に。</span></>
            ) : copy.heroTitle}
          </h1>
          <p class="lede">{copy.heroIntro}</p>
          <a class="primary-link" href={allRouteFor('apps', locale)}>
            {copy.browse}<span aria-hidden="true">↗</span>
          </a>
        </div>

        {featured && heroScreenshot && (
          <div class="hero-stage" aria-label={copy.signatureLabel}>
            {melivraScreenshot && (
              <a class="stage-device stage-back" href={linkFor('melivra')} aria-label="Melivra">
                <img src={melivraScreenshot} alt="" loading="lazy" decoding="async" width="270" height="540" />
              </a>
            )}
            <a class="stage-device stage-main" href={linkFor(featured.slug)} aria-label="TagWeaver">
              <img src={heroScreenshot} alt="" loading="eager" fetchpriority="high" decoding="async" width="300" height="600" />
            </a>
            {papiraScreenshot && (
              <a class="stage-device stage-front" href={linkFor('papira')} aria-label="Papira">
                <img src={papiraScreenshot} alt="" loading="lazy" decoding="async" width="270" height="540" />
              </a>
            )}
          </div>
        )}
      </section>

      {featured && featuredScreenshot && (
        <section class="home-section signature-section" aria-labelledby="signature-title">
          <div class="section-topline">
            <p class="section-kicker">{copy.signatureLabel}</p>
            <span class="section-rule"></span>
          </div>
          <a class="featured" href={linkFor(featured.slug)}>
            <div class="featured-image-stage">
              <div class="featured-screen">
                <img src={featuredScreenshot} alt={`${featured.title}: ${copy.signatureTitle}`} loading="lazy" decoding="async" width="380" height="760" />
              </div>
              <span class="screen-index" aria-hidden="true">01 / SIGNATURE</span>
            </div>
            <div class="featured-copy">
              <div class="product-identity">
                <img src={iconPath(featured.slug, 96)} srcset={iconSrcset(featured.slug)} sizes="48px" alt="" width="48" height="48" loading="lazy" />
                <div>
                  <span class="product-name">{featured.title}</span>
                  <span class="platform-text">{featured.platforms.join(' · ')}</span>
                </div>
              </div>
              <h2 id="signature-title">{copy.signatureTitle}</h2>
              <p>{copy.signatureBody}</p>
              <span class="text-arrow">{copy.exploreApp}<span aria-hidden="true">↗</span></span>
            </div>
          </a>
        </section>
      )}

      <section class="home-section collection-section" aria-labelledby="apps-title">
        <div class="section-topline">
          <p class="section-kicker">{copy.selectedLabel}</p>
          <span class="section-rule"></span>
        </div>
        <div class="section-heading-row">
          <div>
            <h2 id="apps-title">{copy.selectedTitle}</h2>
            <p class="section-description">{copy.selectedIntro}</p>
          </div>
          <a class="inline-link" href={allRouteFor('apps', locale)}>{copy.browse}<span aria-hidden="true">↗</span></a>
        </div>
        <div class="collection-grid">
          {selectedApps.map((app) => {
            const offer = copy.offers[app.slug as keyof typeof copy.offers];
            const screenshot = screenshotBySlug[app.slug];
            return (
              <a class="product-card" href={linkFor(app.slug)} style={`--product-tint:${app.accent.background};--product-border:${app.accent.border}`}>
                <div class="product-picture">
                  {screenshot ? (
                    <div class="product-screen">
                      <img src={screenshot} alt={`${app.title}: ${offer?.category ?? app.title}`} loading="lazy" decoding="async" width="240" height="480" />
                    </div>
                  ) : (
                    <img class="fallback-icon" src={iconPath(app.slug, 192)} alt="" loading="lazy" width="96" height="96" />
                  )}
                </div>
                <div class="product-card-body">
                  <p class="product-category">{offer?.category}</p>
                  <div class="product-card-heading">
                    <h3>{app.title}</h3><span aria-hidden="true">↗</span>
                  </div>
                  <p>{offer?.result}</p>
                  <span class="platform-text">{app.platforms.join(' · ')}</span>
                </div>
              </a>
            );
          })}
        </div>
      </section>

      <section class="home-section trust-section" aria-labelledby="trust-title">
        <div class="section-topline"><p class="section-kicker">{copy.trustLabel}</p><span class="section-rule"></span></div>
        <div class="trust-header">
          <h2 id="trust-title">{copy.trustTitle}</h2>
          <p>{copy.trustIntro}</p>
        </div>
        <div class="trust-grid">
          {copy.trust.map((item, index) => (
            <article class="trust-item">
              {index === 0 ? (
                <div class="trust-number"><span class="trust-count">{releasedApps.length}</span><span>{copy.releasedUnit}</span></div>
              ) : (
                <span class="trust-ordinal" aria-hidden="true">0{index + 1}</span>
              )}
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
        <div class="trust-principles" aria-label={copy.approachLabel}>
          <span class="trust-principles-label">{copy.approachLabel}</span>
          {copy.values.map((value) => <span class="trust-principle">{value.title}</span>)}
        </div>
      </section>

      <nav class="footer-directory" aria-label={footerLabels[locale]}>
        <a href={allRouteFor('apps', locale)}>{copy.nav.apps}</a>
        <a href={allRouteFor('about', locale)}>{copy.nav.about}</a>
        <a href={blogHref}>{copy.nav.blog}</a>
      </nav>
      <SiteFooter locale={locale} />
    </div>
  </main>
</BaseLayout>
