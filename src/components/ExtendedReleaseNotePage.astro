---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProductSource, getIconRoutePath } from '../lib/products';
import { releaseNoteKoPath, releaseNotePath, type ReleaseNote } from '../lib/releaseNotes';
import {
  getExtendedReleaseCopy,
  labels as releaseLabels,
  releaseNoteLocalePath,
  type ReleaseLocale
} from '../lib/extended-release-notes';
import {
  allLocaleDefinitions,
  allProductRouteFor,
  allRouteFor,
  allSiteLocales
} from '../lib/extended-site-i18n';

type Props = { note: ReleaseNote; locale: ReleaseLocale };
const { note, locale } = Astro.props;
const text = getExtendedReleaseCopy(note, locale);
const labels = releaseLabels[locale];
const definition = allLocaleDefinitions[locale];
const canonicalPath = releaseNoteLocalePath(note, locale);
const source = getProductSource(note.appSlug);
const iconPath = getIconRoutePath(source);
const appPath = allProductRouteFor(note.appSlug, locale);
const alternatePath = (item: typeof allSiteLocales[number]) => {
  if (item === 'en') return releaseNotePath(note);
  if (item === 'ko') return releaseNoteKoPath(note);
  return releaseNoteLocalePath(note, item as ReleaseLocale);
};
const alternates = [
  ...allSiteLocales.map((item) => ({ lang: allLocaleDefinitions[item].hreflang, path: alternatePath(item) })),
  { lang: 'x-default', path: releaseNotePath(note) }
];
const description = `${note.title} ${labels.titleSuffix}. ${text.summary}`;
---

<BaseLayout title={`${note.title} ${labels.titleSuffix} | ONNELLAB`} description={description} canonicalPath={canonicalPath} lang={definition.htmlLang} image={iconPath} ogType="article" alternates={alternates} articleMeta={{ publishedTime: note.releasedDate, modifiedTime: note.releasedDate, section: labels.titleSuffix, tags: [note.appName,note.platform,note.version] }}>
  <main class="release-shell">
    <nav class="topbar site-header" aria-label="ONNELLAB">
      <a class="brand" href={allRouteFor('home', locale)}>ONNELLAB</a>
      <details class="locale-menu">
        <summary>{definition.label}</summary>
        <ul>{allSiteLocales.map((item) => <li><a href={alternatePath(item)} lang={allLocaleDefinitions[item].htmlLang} hreflang={allLocaleDefinitions[item].hreflang} data-locale-choice={item} aria-current={item===locale?'page':undefined}>{allLocaleDefinitions[item].label}</a></li>)}</ul>
      </details>
    </nav>
    <article class="release-note">
      <header>
        <p class="eyebrow">{labels.eyebrow}</p>
        <h1>{note.title}</h1>
        <p class="summary">{text.summary}</p>
        <a class="app-link" href={appPath}>{note.appName} {labels.appPage}</a>
        <dl class="facts"><div><dt>{labels.released}</dt><dd>{note.releasedDate}</dd></div><div><dt>{labels.platform}</dt><dd>{note.platform}</dd></div><div><dt>{labels.previous}</dt><dd>{note.previousVersion}</dd></div></dl>
      </header>
      <section><h2>{labels.changed}</h2><ul>{text.changes.map((change)=><li>{change}</li>)}</ul></section>
      <section><h2>{labels.compatibility}</h2><p>{labels.compatibilityText(note.appName)}</p></section>
      <section><h2>{labels.upgrade}</h2><p>{labels.upgradeText}</p></section>
    </article>
    <footer class="footer"><a href={allRouteFor('apps',locale)}>{labels.appPage}</a><a href={allRouteFor('privacy',locale)}>Privacy</a><a href="mailto:onnellab.app@gmail.com">onnellab.app@gmail.com</a><span>© ONNELLAB</span></footer>
  </main>
</BaseLayout>
<style>
.release-shell{min-height:100vh;padding:24px 20px 56px;background:#faf8f5}.topbar,.release-note{max-width:860px;margin:0 auto}.topbar{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:46px}.brand{color:#737067;font-size:14px;font-weight:560;text-decoration:none}.locale-menu{position:relative}.locale-menu summary{min-height:34px;display:inline-flex;align-items:center;border:1px solid #ded6ca;border-radius:999px;padding:6px 12px;background:rgba(255,253,248,.72);color:#5f5a50;cursor:pointer;font-size:13px;font-weight:650;list-style:none}.locale-menu ul{position:absolute;z-index:20;right:0;top:calc(100% + 7px);width:max-content;min-width:170px;display:grid;gap:2px;margin:0;border:1px solid #ded6ca;border-radius:12px;padding:6px;background:#fffdf8;box-shadow:0 14px 34px rgba(57,48,39,.11);list-style:none}.locale-menu a{display:block;border-radius:8px;padding:8px 10px;color:#5f5a50;text-decoration:none;font-size:13px}.locale-menu a:hover,.locale-menu a[aria-current='page']{background:#f4efe7}.release-note{color:#343230}.eyebrow{margin:0 0 10px;color:#6e675e;font-size:13px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}h1{margin:0;color:#252321;font-size:clamp(34px,5vw,58px);line-height:1.04}.summary{max-width:680px;margin:18px 0 0;color:#4f4a44;font-size:18px;line-height:1.65}.app-link{display:inline-flex;margin-top:16px;border:1px solid #ded6ca;border-radius:999px;padding:6px 12px;color:#5f5a50;text-decoration:none;font-size:13px;font-weight:700}.facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:28px 0 42px}.facts div{border:1px solid #ddd6cc;border-radius:8px;background:#fffdf9;padding:14px}dt{color:#6e675e;font-size:12px;font-weight:800;text-transform:uppercase}dd{margin:6px 0 0;color:#2f2c29;font-size:16px;font-weight:800}section{border-top:1px solid #ded8cf;padding:28px 0}h2{margin:0 0 14px;color:#282522;font-size:23px}p,li{line-height:1.7}.footer{max-width:860px;display:flex;justify-content:center;flex-wrap:wrap;gap:10px 20px;margin:36px auto 0;border-top:1px solid #ded6ca;padding-top:28px;color:#786f65;font-size:12px}.footer a{color:#686259;text-decoration:none;font-weight:620}@media(max-width:640px){.facts{grid-template-columns:1fr}.topbar{margin-bottom:34px}}
</style>
