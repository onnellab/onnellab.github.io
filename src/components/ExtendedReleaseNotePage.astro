---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReleaseNoteLocaleMenu from './ReleaseNoteLocaleMenu.astro';
import { getProductSource, getIconRoutePath } from '../lib/products';
import {
  releaseNoteKoPath,
  releaseNotePath,
  type ReleaseNote
} from '../lib/releaseNotes';
import {
  getExtendedReleaseCopy,
  labels as releaseLabels,
  releaseNoteLocalePath,
  type ReleaseLocale
} from '../lib/extended-release-notes';
import {
  allLocaleDefinitions,
  allProductRouteFor,
  allRouteFor,
  allSiteLocales
} from '../lib/extended-site-i18n';

type Props = {
  note: ReleaseNote;
  locale: ReleaseLocale;
};

const { note, locale } = Astro.props;
const text = getExtendedReleaseCopy(note, locale);
const submittedLabels: Record<ReleaseLocale, {
  released: string;
  compatibility: string;
  compatibilityText: (app: string) => string;
  upgrade: string;
  upgradeText: string;
}> = {
  ja: {
    released: 'ウェブ掲載日',
    compatibility: 'ストア公開状況',
    compatibilityText: () => 'このアップデートは iOS と Android の審査に提出済みです。各ストアで承認され次第、順次公開されます。',
    upgrade: 'アップデートについて',
    upgradeText: 'ストアでバージョン2.3が公開された後、通常のアップデートとしてインストールできます。'
  },
  'zh-Hans': {
    released: '网页发布日期',
    compatibility: '商店上架状态',
    compatibilityText: () => '此更新已提交 iOS 和 Android 审核，将在各商店审核通过后陆续上架。',
    upgrade: '更新说明',
    upgradeText: '2.3 版本在商店上架后，可按常规方式更新。'
  },
  'zh-Hant': {
    released: '網頁發布日',
    compatibility: '商店上架狀態',
    compatibilityText: () => '此更新已提交 iOS 與 Android 審核，將在各商店審核通過後陸續上架。',
    upgrade: '更新說明',
    upgradeText: '2.3 版本在商店上架後，可依一般方式更新。'
  },
  'pt-BR': {
    released: 'Publicação no site',
    compatibility: 'Status nas lojas',
    compatibilityText: () => 'Esta atualização foi enviada para análise no iOS e no Android. Ela será disponibilizada em cada loja após a respectiva aprovação.',
    upgrade: 'Como atualizar',
    upgradeText: 'Quando a versão 2.3 estiver disponível na sua loja, ela poderá ser instalada como uma atualização normal.'
  },
  de: {
    released: 'Web-Veröffentlichung',
    compatibility: 'Store-Status',
    compatibilityText: () => 'Dieses Update wurde für iOS und Android zur Prüfung eingereicht. Es wird in jedem Store nach der jeweiligen Freigabe veröffentlicht.',
    upgrade: 'Update-Hinweise',
    upgradeText: 'Sobald Version 2.3 in deinem Store verfügbar ist, kann sie wie ein normales Update installiert werden.'
  },
  fr: {
    released: 'Publication sur le site',
    compatibility: 'Disponibilité dans les stores',
    compatibilityText: () => 'Cette mise à jour a été soumise à validation sur iOS et Android. Elle sera publiée dans chaque boutique après approbation.',
    upgrade: 'Mise à jour',
    upgradeText: 'Lorsque la version 2.3 sera disponible dans votre boutique, elle pourra être installée comme une mise à jour normale.'
  },
  es: {
    released: 'Publicación en la web',
    compatibility: 'Estado en las tiendas',
    compatibilityText: () => 'Esta actualización se ha enviado a revisión para iOS y Android. Se publicará en cada tienda cuando reciba la aprobación correspondiente.',
    upgrade: 'Cómo actualizar',
    upgradeText: 'Cuando la versión 2.3 esté disponible en tu tienda, podrás instalarla como una actualización normal.'
  }
};
const labels = note.storeStatus === 'submitted'
  ? { ...releaseLabels[locale], ...submittedLabels[locale] }
  : releaseLabels[locale];
const definition = allLocaleDefinitions[locale];
const canonicalPath = releaseNoteLocalePath(note, locale);
const source = getProductSource(note.appSlug);
const iconPath = getIconRoutePath(source);
const appPath = allProductRouteFor(note.appSlug, locale);
const alternatePath = (item: typeof allSiteLocales[number]): string => {
  if (item === 'en') return releaseNotePath(note);
  if (item === 'ko') return releaseNoteKoPath(note);
  return releaseNoteLocalePath(note, item as ReleaseLocale);
};
const alternates = [
  ...allSiteLocales.map((item) => ({
    lang: allLocaleDefinitions[item].hreflang,
    path: alternatePath(item)
  })),
  { lang: 'x-default', path: releaseNotePath(note) }
];
const canonicalUrl = new URL(canonicalPath, Astro.site);
const description = `${note.title} ${labels.titleSuffix}. ${text.summary}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  '@id': `${canonicalUrl.toString()}#release-notes`,
  headline: note.title,
  description,
  datePublished: note.releasedDate,
  dateModified: note.releasedDate,
  inLanguage: definition.htmlLang,
  mainEntityOfPage: canonicalUrl.toString(),
  about: {
    '@type': 'SoftwareApplication',
    name: note.appName,
    softwareVersion: note.version,
    url: new URL(appPath, Astro.site).toString()
  },
  publisher: {
    '@type': 'Organization',
    '@id': new URL('/#organization', Astro.site).toString(),
    name: 'ONNELLAB',
    url: new URL('/', Astro.site).toString()
  }
};
const footerLabels: Record<ReleaseLocale, { apps: string; privacy: string }> = {
  ja: { apps: 'アプリ一覧', privacy: 'プライバシー' },
  'zh-Hans': { apps: '全部应用', privacy: '隐私' },
  'zh-Hant': { apps: '全部應用程式', privacy: '隱私權' },
  'pt-BR': { apps: 'Todos os apps', privacy: 'Privacidade' },
  de: { apps: 'Alle Apps', privacy: 'Datenschutz' },
  fr: { apps: 'Toutes les applications', privacy: 'Confidentialité' },
  es: { apps: 'Todas las aplicaciones', privacy: 'Privacidad' }
};
const footer = footerLabels[locale];
---

<BaseLayout
  title={`${note.title} ${labels.titleSuffix} | ONNELLAB`}
  description={description}
  canonicalPath={canonicalPath}
  lang={definition.htmlLang}
  image={iconPath}
  ogType="article"
  alternates={alternates}
  articleMeta={{
    publishedTime: note.releasedDate,
    modifiedTime: note.releasedDate,
    section: labels.titleSuffix,
    tags: [note.appName, note.platform, note.version]
  }}
  jsonLd={jsonLd}
>
  <main class="release-shell">
    <nav class="topbar site-header" aria-label="ONNELLAB">
      <a class="brand" href={allRouteFor('home', locale)}>ONNELLAB</a>
      <ReleaseNoteLocaleMenu note={note} locale={locale} />
    </nav>

    <article class="release-note">
      <header>
        <p class="eyebrow">{labels.eyebrow}</p>
        <h1>{note.title}</h1>
        <p class="summary">{text.summary}</p>
        <a class="app-link" href={appPath}>{note.appName} {labels.appPage}</a>
        <dl class="facts">
          <div>
            <dt>{labels.released}</dt>
            <dd>{note.releasedDate}</dd>
          </div>
          <div>
            <dt>{labels.platform}</dt>
            <dd>{note.platform}</dd>
          </div>
          <div>
            <dt>{labels.previous}</dt>
            <dd>{note.previousVersion}</dd>
          </div>
        </dl>
      </header>

      <section aria-labelledby="changed-heading">
        <h2 id="changed-heading">{labels.changed}</h2>
        <ul>
          {text.changes.map((change) => <li>{change}</li>)}
        </ul>
      </section>

      <section aria-labelledby="compat-heading">
        <h2 id="compat-heading">{labels.compatibility}</h2>
        <p>{labels.compatibilityText(note.appName)}</p>
      </section>

      <section aria-labelledby="upgrade-heading">
        <h2 id="upgrade-heading">{labels.upgrade}</h2>
        <p>{labels.upgradeText}</p>
      </section>
    </article>

    <footer class="footer">
      <a href={allRouteFor('apps', locale)}>{footer.apps}</a>
      <a href={allRouteFor('privacy', locale)}>{footer.privacy}</a>
      <a href="mailto:onnellab.app@gmail.com">onnellab.app@gmail.com</a>
      <span>© ONNELLAB</span>
    </footer>
  </main>
</BaseLayout>

<style>
  .release-shell {
    min-height: 100vh;
    padding: 24px 20px 56px;
    background: #faf8f5;
  }

  .topbar,
  .release-note {
    max-width: 860px;
    margin: 0 auto;
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 46px;
  }

  .brand {
    color: #737067;
    font-size: 14px;
    font-weight: 560;
    text-decoration: none;
  }

  .brand:focus-visible,
  .app-link:focus-visible,
  .footer a:focus-visible {
    outline: 2px solid #827d72;
    outline-offset: 3px;
  }

  .release-note {
    color: #343230;
  }

  .eyebrow {
    margin: 0 0 10px;
    color: #6e675e;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: #252321;
    font-size: clamp(34px, 5vw, 58px);
    line-height: 1.04;
  }

  .summary {
    max-width: 680px;
    margin: 18px 0 0;
    color: #4f4a44;
    font-size: 18px;
    line-height: 1.65;
  }

  .app-link {
    display: inline-flex;
    margin-top: 16px;
    border: 1px solid #ded6ca;
    border-radius: 999px;
    padding: 6px 12px;
    color: #5f5a50;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: 28px 0 42px;
  }

  .facts div {
    border: 1px solid #ddd6cc;
    border-radius: 8px;
    background: #fffdf9;
    padding: 14px;
  }

  dt {
    color: #6e675e;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
  }

  dd {
    margin: 6px 0 0;
    color: #2f2c29;
    font-size: 16px;
    font-weight: 800;
  }

  section {
    border-top: 1px solid #ded8cf;
    padding: 28px 0;
  }

  h2 {
    margin: 0 0 14px;
    color: #282522;
    font-size: 23px;
  }

  p,
  li {
    line-height: 1.7;
  }

  .footer {
    max-width: 860px;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px 20px;
    margin: 36px auto 0;
    border-top: 1px solid #ded6ca;
    padding-top: 28px;
    color: #786f65;
    font-size: 12px;
  }

  .footer a {
    color: #686259;
    font-weight: 620;
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .facts {
      grid-template-columns: 1fr;
    }

    .topbar {
      margin-bottom: 34px;
    }
  }
</style>
