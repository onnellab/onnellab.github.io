---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocaleMenu from './LocaleMenu.astro';
import SiteFooter from './SiteFooter.astro';
import {
  localeAlternates,
  localeDefinitions,
  routeFor,
  type SiteLocale
} from '../lib/site-i18n';

type Props = {
  locale: SiteLocale;
  page: 'terms';
};

type TermsCopy = {
  nav: {
    apps: string;
    about: string;
    blog: string;
  };
  navLabel: string;
  seoTitle: string;
  description: string;
  eyebrow: string;
  title: string;
  intro: string;
  updatedLabel: string;
  updatedValue: string;
  sections: Array<{ title: string; paragraphs: string[] }>;
};

const copies: Record<SiteLocale, TermsCopy> = {
  en: {
    nav: { apps: 'Apps', about: 'About', blog: 'Blog' },
    navLabel: 'Navigation',
    seoTitle: 'ONNELLAB Terms of Use',
    description: 'General terms for ONNELLAB apps and websites.',
    eyebrow: 'Legal',
    title: 'Terms of Use',
    intro: 'These general terms apply to ONNELLAB apps and websites unless a product page or store listing states a more specific rule.',
    updatedLabel: 'Last updated',
    updatedValue: '2026-08-21',
    sections: [
      { title: '1. Using ONNELLAB products', paragraphs: ['Use each product lawfully and in accordance with its store listing, in-app notices, and platform rules. Do not attempt to disrupt, reverse-engineer for abuse, or misuse a service or another person’s data.'] },
      { title: '2. Your files and content', paragraphs: ['You remain responsible for files, manuscripts, media, and other content you choose to process. ONNELLAB does not claim ownership of user content. Make sure you have the rights needed to use and export the material.'] },
      { title: '3. Purchases and refunds', paragraphs: ['App downloads, purchases, subscriptions, refunds, and purchase restoration are processed by the applicable app store under its own terms. Product-specific pricing and entitlements are shown in the store or app.'] },
      { title: '4. External services', paragraphs: ['When a product opens or shares data with another app, website, storage provider, or platform, that destination’s terms and privacy policy apply. ONNELLAB is not responsible for third-party services outside its control.'] },
      { title: '5. Availability and changes', paragraphs: ['We may update products to fix defects, maintain compatibility, meet legal or store requirements, or improve the experience. Features may differ by platform where operating-system rules require it.'] },
      { title: '6. Contact', paragraphs: ['Questions about these terms can be sent to onnellab.app@gmail.com.'] }
    ]
  },
  ko: {
    nav: { apps: '앱', about: '소개', blog: '블로그' },
    navLabel: '탐색',
    seoTitle: 'ONNELLAB 이용약관',
    description: 'ONNELLAB 앱과 웹사이트의 일반 이용약관이에요.',
    eyebrow: '법적 안내',
    title: '이용약관',
    intro: '제품 페이지나 스토어 안내에 더 구체적인 규칙이 없는 경우 ONNELLAB 앱과 웹사이트에 이 일반 약관이 적용돼요.',
    updatedLabel: '최종 업데이트',
    updatedValue: '2026-08-21',
    sections: [
      { title: '1. ONNELLAB 제품 이용', paragraphs: ['각 제품은 법률, 스토어 안내, 앱 안의 고지와 플랫폼 규칙을 지켜 사용해요. 서비스를 방해하거나 다른 사람의 데이터를 침해하는 방식으로 악용하면 안 돼요.'] },
      { title: '2. 사용자의 파일과 콘텐츠', paragraphs: ['사용자가 선택한 파일, 원고, 미디어와 콘텐츠에 대한 책임은 사용자에게 있어요. ONNELLAB은 사용자 콘텐츠의 소유권을 주장하지 않아요. 처리하고 내보낼 권리가 있는 자료인지 확인해요.'] },
      { title: '3. 구매와 환불', paragraphs: ['앱 다운로드, 구매, 구독, 환불과 구매 복원은 해당 앱 스토어가 자체 약관에 따라 처리해요. 제품별 가격과 이용 권한은 스토어나 앱에서 안내해요.'] },
      { title: '4. 외부 서비스', paragraphs: ['제품에서 다른 앱, 웹사이트, 저장소 또는 플랫폼으로 데이터를 열거나 공유하면 해당 대상의 약관과 개인정보 처리방침이 적용돼요. ONNELLAB이 통제하지 않는 외부 서비스에 대해서는 책임지지 않아요.'] },
      { title: '5. 제공 및 변경', paragraphs: ['오류 수정, 호환성 유지, 법률·스토어 요구 대응과 사용 경험 개선을 위해 제품을 업데이트할 수 있어요. 운영체제 규칙에 따라 플랫폼별 기능이 다를 수 있어요.'] },
      { title: '6. 문의', paragraphs: ['이 약관에 관한 문의는 onnellab.app@gmail.com으로 보내요.'] }
    ]
  },
  ja: {
    nav: { apps: 'アプリ', about: 'ONNELLABについて', blog: 'ブログ' },
    navLabel: 'ナビゲーション',
    seoTitle: 'ONNELLAB 利用規約',
    description: 'ONNELLABアプリとウェブサイトの一般利用規約です。',
    eyebrow: '法的情報',
    title: '利用規約',
    intro: '製品ページやストア表示により具体的な規則がない場合、ONNELLABのアプリとウェブサイトには本一般規約が適用されます。',
    updatedLabel: '最終更新日',
    updatedValue: '2026-08-21',
    sections: [
      { title: '1. ONNELLAB製品の利用', paragraphs: ['各製品は、法令、ストア表示、アプリ内の案内、プラットフォーム規則に従って使用してください。サービスの妨害や他者のデータを侵害する目的で利用してはいけません。'] },
      { title: '2. 利用者のファイルとコンテンツ', paragraphs: ['利用者が選択したファイル、原稿、メディア、その他のコンテンツについては利用者が責任を負います。ONNELLABは利用者コンテンツの所有権を主張しません。処理や書き出しに必要な権利があることを確認してください。'] },
      { title: '3. 購入と返金', paragraphs: ['ダウンロード、購入、サブスクリプション、返金、購入の復元は、各アプリストアがその規約に従って処理します。製品ごとの価格と利用権はストアまたはアプリに表示されます。'] },
      { title: '4. 外部サービス', paragraphs: ['別のアプリ、ウェブサイト、ストレージ、プラットフォームへデータを開いたり共有したりした場合、送信先の規約とプライバシーポリシーが適用されます。ONNELLABは管理外の第三者サービスについて責任を負いません。'] },
      { title: '5. 提供と変更', paragraphs: ['不具合修正、互換性維持、法令・ストア要件への対応、体験改善のため製品を更新することがあります。OSの規則により、機能がプラットフォームごとに異なる場合があります。'] },
      { title: '6. お問い合わせ', paragraphs: ['本規約に関するお問い合わせは onnellab.app@gmail.com までお送りください。'] }
    ]
  },
  'zh-Hans': {
    nav: { apps: '应用', about: '关于', blog: '博客' },
    navLabel: '导航',
    seoTitle: 'ONNELLAB 使用条款',
    description: '适用于 ONNELLAB 应用与网站的一般使用条款。',
    eyebrow: '法律信息',
    title: '使用条款',
    intro: '如产品页面或应用商店说明没有更具体的规则，本一般条款适用于 ONNELLAB 应用与网站。',
    updatedLabel: '最后更新',
    updatedValue: '2026-08-21',
    sections: [
      { title: '1. 使用 ONNELLAB 产品', paragraphs: ['请依法并按照应用商店说明、应用内提示和平台规则使用产品。不得以破坏服务或侵害他人数据的方式滥用产品。'] },
      { title: '2. 用户文件与内容', paragraphs: ['用户对自己选择处理的文件、原稿、媒体及其他内容负责。ONNELLAB 不主张用户内容的所有权。请确认你拥有处理与导出相应材料所需的权利。'] },
      { title: '3. 购买与退款', paragraphs: ['下载、购买、订阅、退款与恢复购买由相应应用商店按照其条款处理。具体价格与权益会在商店或应用中说明。'] },
      { title: '4. 外部服务', paragraphs: ['当产品把数据打开或分享到其他应用、网站、存储服务或平台时，将适用接收方的条款与隐私政策。ONNELLAB 不对其无法控制的第三方服务负责。'] },
      { title: '5. 提供与变更', paragraphs: ['我们可能为修复问题、保持兼容、满足法律或商店要求及改进体验而更新产品。受操作系统规则影响，不同平台的功能可能不同。'] },
      { title: '6. 联系', paragraphs: ['有关本条款的问题可发送至 onnellab.app@gmail.com。'] }
    ]
  },
  'zh-Hant': {
    nav: { apps: '應用程式', about: '關於', blog: '部落格' },
    navLabel: '導覽',
    seoTitle: 'ONNELLAB 使用條款',
    description: '適用於 ONNELLAB 應用程式與網站的一般使用條款。',
    eyebrow: '法律資訊',
    title: '使用條款',
    intro: '如產品頁面或應用程式商店說明沒有更具體的規則，本一般條款適用於 ONNELLAB 應用程式與網站。',
    updatedLabel: '最後更新',
    updatedValue: '2026-08-21',
    sections: [
      { title: '1. 使用 ONNELLAB 產品', paragraphs: ['請依法並依照應用程式商店說明、應用程式內提示和平台規則使用產品。不得以破壞服務或侵害他人資料的方式濫用產品。'] },
      { title: '2. 使用者檔案與內容', paragraphs: ['使用者對自己選擇處理的檔案、原稿、媒體與其他內容負責。ONNELLAB 不主張使用者內容的所有權。請確認你擁有處理與匯出相關材料所需的權利。'] },
      { title: '3. 購買與退款', paragraphs: ['下載、購買、訂閱、退款與回復購買由對應應用程式商店依其條款處理。產品價格與權益會在商店或應用程式內說明。'] },
      { title: '4. 外部服務', paragraphs: ['當產品將資料開啟或分享至其他應用程式、網站、儲存服務或平台時，將適用接收方的條款與隱私權政策。ONNELLAB 不對無法控制的第三方服務負責。'] },
      { title: '5. 提供與變更', paragraphs: ['我們可能為修正問題、維持相容、符合法律或商店要求及改善體驗而更新產品。受作業系統規則影響，不同平台的功能可能不同。'] },
      { title: '6. 聯絡', paragraphs: ['有關本條款的問題可寄至 onnellab.app@gmail.com。'] }
    ]
  }
};

const { locale } = Astro.props;
const copy = copies[locale];
const definition = localeDefinitions[locale];
const canonicalPath = routeFor('terms', locale);
const blogHref = locale === 'ko'
  ? '/blog/ko/'
  : locale === 'ja'
    ? '/blog/ja/'
    : locale === 'zh-Hans'
      ? '/blog/zh-hans/'
      : locale === 'zh-Hant'
        ? '/blog/zh-hant/'
        : '/blog/';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: copy.seoTitle,
  description: copy.description,
  url: new URL(canonicalPath, Astro.site).toString(),
  inLanguage: definition.htmlLang
};
---

<BaseLayout
  title={copy.seoTitle}
  description={copy.description}
  canonicalPath={canonicalPath}
  lang={definition.htmlLang}
  jsonLd={jsonLd}
  alternates={localeAlternates('terms')}
>
  <main class="site-shell" data-core-page="terms">
    <nav class="top-nav" aria-label={copy.navLabel}>
      <a class="brand" href={routeFor('home', locale)}>ONNELLAB</a>
      <div class="nav-links">
        <a href={routeFor('apps', locale)}>{copy.nav.apps}</a>
        <a href={routeFor('about', locale)}>{copy.nav.about}</a>
        <a href={blogHref}>{copy.nav.blog}</a>
        <LocaleMenu locale={locale} page="terms" />
      </div>
    </nav>

    <header class="page-hero">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.title}</h1>
      <p class="lede">{copy.intro}</p>
      <p class="updated"><strong>{copy.updatedLabel}:</strong> {copy.updatedValue}</p>
    </header>
    <section class="prose terms-prose">
      {copy.sections.map((section) => (
        <section>
          <h2>{section.title}</h2>
          {section.paragraphs.map((paragraph) =>
            paragraph.includes('onnellab.app@gmail.com') ? (
              <p>{paragraph.replace('onnellab.app@gmail.com', '')}<a href="mailto:onnellab.app@gmail.com">onnellab.app@gmail.com</a></p>
            ) : (
              <p>{paragraph}</p>
            )
          )}
        </section>
      ))}
    </section>

    <SiteFooter locale={locale} />
  </main>
</BaseLayout>

<style>
  .site-shell {
    width: min(1080px, calc(100% - 40px));
    margin: 0 auto;
    padding: 26px 0 54px;
    color: #3f3b35;
  }

  .top-nav,
  .nav-links {
    display: flex;
    align-items: center;
  }

  .top-nav {
    justify-content: space-between;
    gap: 20px;
  }

  .brand,
  .nav-links > a {
    color: #686259;
    font-size: 13px;
    font-weight: 620;
    text-decoration: none;
  }

  .brand {
    letter-spacing: 0.02em;
  }

  .nav-links {
    gap: 16px;
  }

  .top-nav a:hover {
    color: #2f2d29;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .page-hero {
    max-width: 820px;
    padding: clamp(88px, 13vw, 154px) 0 clamp(60px, 8vw, 92px);
  }

  .eyebrow {
    margin: 0 0 18px;
    color: #8b8175;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: #37332e;
    font-size: clamp(48px, 9vw, 96px);
    font-weight: 650;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .lede {
    max-width: 760px;
    margin: 28px 0 0;
    color: #6a6359;
    font-size: clamp(17px, 2vw, 21px);
    line-height: 1.75;
  }

  .prose {
    max-width: 790px;
  }

  .terms-prose {
    border-top: 1px solid #ded6ca;
    padding-top: 10px;
  }

  .terms-prose section {
    border-bottom: 1px solid #e3dbcf;
    padding: 36px 0 30px;
  }

  .terms-prose h2 {
    margin: 0 0 12px;
    color: #413c36;
    font-size: 20px;
    font-weight: 660;
  }

  .terms-prose p {
    margin: 0;
    color: #686158;
    font-size: 15px;
    line-height: 1.75;
  }

  .updated {
    margin: 22px 0 0;
    color: #7a7268;
    font-size: 13px;
  }

  .terms-prose a {
    color: #3d5f82;
    text-underline-offset: 4px;
  }

  @media (max-width: 760px) {
    .site-shell {
      width: min(100% - 30px, 1080px);
      padding-top: 20px;
    }

    .nav-links {
      gap: 10px;
    }

    .nav-links > a:nth-of-type(2),
    .nav-links > a:nth-of-type(3) {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .page-hero {
      padding: 72px 0 54px;
    }

    h1 {
      font-size: clamp(44px, 14vw, 66px);
    }
  }
</style>
