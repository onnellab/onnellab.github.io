const { locale, page } = Astro.props;
const copy = copies[locale];
const definition = localeDefinitions[locale];
const canonicalPath = routeFor(page, locale);
const sourceLocale = contentLocale(locale);
const existingApps = getProductIndexItems(sourceLocale);
const appHref = (slug: string) => {
  if (locale === 'ko') return `/apps/${slug}/ko/`;
  return `/apps/${slug}/`;
};
const papiraSummary: Record<SiteLocale, string> = {
  en: 'Offline TXT-to-EPUB maker for fanfiction, novels, digital zines, and TRPG scenarios.',
  ko: '팬픽·소설·전자책 동인지·TRPG 시나리오 TXT 원고를 EPUB으로 만들어요.',
  ja: '二次創作・小説・電子同人誌・TRPGシナリオのTXT原稿をEPUBにまとめます。',
  'zh-Hans': '把同人文、小说、电子同人志与 TRPG 剧本的 TXT 原稿制作成 EPUB。',
  'zh-Hant': '把同人文、小說、電子同人誌與 TRPG 劇本的 TXT 原稿製作成 EPUB。'
};
const papiraCard = {
  slug: 'papira',
  title: 'Papira',
  status: copy.apps.papiraStatus,
  platforms: ['iOS', 'Android'],
  description: papiraSummary[locale],
  iconPath: '/app-assets/papira/assets/icon/Papira.png',
  href: routeFor('papira', locale),
  privacy: routeFor('papiraPrivacy', locale)
};
const allApps = [papiraCard, ...existingApps.map((app) => ({ ...app, href: appHref(app.slug) }))];
const featuredOthers = existingApps.slice(0, 4).map((app) => ({ ...app, href: appHref(app.slug) }));
const privacyDates: Record<string, string> = {
  Aligna: '2026-06-24',
  ClipNest: '2026-06-13',
  Melivra: '2026-07-09',
  Papira: '2026-08-21',
  Quivra: '2026-02-10',
  Segra: '2026-06-12',
  TagWeaver: '2026-02-14',
  VaultXT: '2026-03-11'
};
const localizedExistingPrivacy = (href: string) => (locale === 'ko' ? href.replace(/\/?$/, '/ko/') : href);
const policies = [
  ...existingApps.map((app) => ({
    title: app.title,
    href: localizedExistingPrivacy(app.privacy),
    date: privacyDates[app.title] ?? '2026-01-01',
    platforms: app.platforms,
    localized: locale === 'en' || locale === 'ko'
  })),
  {
    title: 'Papira',
    href: routeFor('papiraPrivacy', locale),
    date: privacyDates.Papira,
    platforms: ['iOS', 'Android'],
    localized: true
  }
].sort((a, b) => a.title.localeCompare(b.title));

const pageCopy = copy[page];
const title = 'seoTitle' in pageCopy ? pageCopy.seoTitle : 'ONNELLAB';
const description = 'description' in pageCopy ? pageCopy.description : 'ONNELLAB';
const jsonLd =
  page === 'home'
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'Organization',
          '@id': new URL('/#organization', Astro.site).toString(),
          name: 'ONNELLAB',
          url: new URL('/', Astro.site).toString(),
          email: 'onnellab.app@gmail.com'
        },
        {
          '@context': 'https://schema.org',
          '@type': 'WebSite',
          '@id': new URL('/#website', Astro.site).toString(),
          name: 'ONNELLAB',
          url: new URL(canonicalPath, Astro.site).toString(),
          inLanguage: definition.htmlLang,
          publisher: { '@id': new URL('/#organization', Astro.site).toString() }
        }
      ]
    : page === 'apps'
      ? {
          '@context': 'https://schema.org',
          '@type': 'CollectionPage',
          name: copy.apps.seoTitle,
          description: copy.apps.description,
          url: new URL(canonicalPath, Astro.site).toString(),
          inLanguage: definition.htmlLang,
          mainEntity: {
            '@type': 'ItemList',
            itemListElement: allApps.map((app, index) => ({
              '@type': 'ListItem',
              position: index + 1,
              name: app.title,
              url: new URL(app.href, Astro.site).toString()
            }))
          }
        }
      : page === 'privacy'
        ? {
            '@context': 'https://schema.org',
            '@type': 'CollectionPage',
            '@id': new URL(`${canonicalPath}#privacy-policies`, Astro.site).toString(),
            name: copy.privacy.seoTitle,
            description: copy.privacy.description,
            url: new URL(canonicalPath, Astro.site).toString(),
            inLanguage: definition.htmlLang,
            mainEntity: {
              '@type': 'ItemList',
              itemListElement: policies.map((policy, index) => ({
                '@type': 'ListItem',
                position: index + 1,
                name: `${policy.title} Privacy Policy`,
                url: new URL(policy.href, Astro.site).toString()
              }))
            }
          }
        : {
            '@context': 'https://schema.org',
            '@type': page === 'about' ? 'AboutPage' : 'WebPage',
            name: title,
            description,
            url: new URL(canonicalPath, Astro.site).toString(),
            inLanguage: definition.htmlLang
          };
const blogHref = locale === 'ko' ? '/blog/ko/' : '/blog/';
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  lang={definition.htmlLang}
  jsonLd={jsonLd}
  alternates={localeAlternates(page)}
>
  <main class="site-shell" data-core-page={page}>
    <nav class="top-nav" aria-label="Navigation">
      <a class="brand" href={routeFor('home', locale)}>ONNELLAB</a>
      <div class="nav-links">
        <a href={routeFor('apps', locale)}>{copy.nav.apps}</a>
        <a href={routeFor('about', locale)}>{copy.nav.about}</a>
        <a href={blogHref}>{copy.nav.blog}</a>
        <LocaleMenu locale={locale} page={page} />
      </div>
    </nav>

    {page === 'home' && (
      <>
        <header class="home-hero">
          <p class="eyebrow">{copy.home.eyebrow}</p>
          <h1>{copy.home.title}</h1>
          <p class="lede">{copy.home.intro}</p>
        </header>

        <section class="featured" aria-labelledby="featured-title">
          <div class="featured-icon">
            <img src="/app-assets/papira/assets/icon/Papira.png" alt="Papira app icon" width="112" height="112" data-no-visual-search="true" />
          </div>
          <div>
            <p class="eyebrow">{copy.home.featuredLabel}</p>
            <h2 id="featured-title">{copy.home.featuredTitle}</h2>
            <p>{copy.home.featuredBody}</p>
            <a class="text-link" href={routeFor('papira', locale)}>{copy.home.featuredAction}</a>
          </div>
        </section>

        <section class="section" aria-labelledby="apps-title">
          <div class="section-head">
            <h2 id="apps-title">{copy.home.appsTitle}</h2>
            <a href={routeFor('apps', locale)}>{copy.home.allApps}</a>
          </div>
          <div class="product-grid">
            {featuredOthers.map((app) => (
              <a class="product-card" href={app.href}>
                <img src={app.iconPath} alt="" width="56" height="56" loading="lazy" data-no-visual-search="true" />
                <h3>{app.title}</h3>
                <p>{app.description}</p>
              </a>
            ))}
          </div>
        </section>

        <section class="section values" aria-labelledby="values-title">
          <h2 id="values-title">{copy.home.valuesTitle}</h2>
          <div class="value-grid">
            {copy.home.values.map((value) => (
              <article>
                <h3>{value.title}</h3>
                <p>{value.body}</p>
              </article>
            ))}
          </div>
        </section>
      </>
    )}

    {page === 'apps' && (
      <>
        <header class="page-hero">
          <p class="eyebrow">{copy.apps.eyebrow}</p>
          <h1>{copy.apps.title}</h1>
          <p class="lede">{copy.apps.intro}</p>
        </header>

        {copy.apps.languageNotice && <p class="language-notice">{copy.apps.languageNotice}</p>}

        <label class="search-field">
          <span>{copy.apps.searchLabel}</span>
          <input type="search" placeholder={copy.apps.searchPlaceholder} data-app-search />
        </label>
        <p class="empty-state" data-app-empty hidden>{copy.apps.empty}</p>

        <section class="app-list" aria-label={copy.apps.title}>
          {allApps.map((app) => (
            <a class="app-row" href={app.href} data-app-row data-app-title={app.title.toLowerCase()}>
              <img src={app.iconPath} alt="" width="64" height="64" loading="lazy" data-no-visual-search="true" />
              <div class="app-copy">
                <div class="app-title-line">
                  <h2>{app.title}</h2>
                  <span>{app.status}</span>
                </div>
                <p>{app.description}</p>
              </div>
              <div class="badges" aria-label="Platforms">
                {app.platforms.map((platform) => <span>{platform}</span>)}
              </div>
            </a>
          ))}
        </section>
        <script is:inline>
          (() => {
            const input = document.querySelector('[data-app-search]');
            const rows = Array.from(document.querySelectorAll('[data-app-row]'));
            if (!(input instanceof HTMLInputElement)) return;
            input.addEventListener('input', () => {
              const query = input.value.trim().toLowerCase();
              let visible = 0;
              rows.forEach((row) => {
                const title = row.getAttribute('data-app-title') ?? '';
                const hidden = query.length > 0 && !title.includes(query);
                row.hidden = hidden;
                if (!hidden) visible += 1;
              });
              const empty = document.querySelector('[data-app-empty]');
              if (empty instanceof HTMLElement) empty.hidden = visible > 0;
            });
          })();
        </script>
      </>
    )}

    {page === 'about' && (
      <>
        <header class="page-hero">
          <p class="eyebrow">{copy.about.eyebrow}</p>
          <h1>{copy.about.title}</h1>
        </header>
        <section class="prose lead-prose">
          {copy.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </section>
        <section class="section values" aria-labelledby="principles-title">
          <h2 id="principles-title">{copy.about.principlesTitle}</h2>
          <div class="value-grid">
            {copy.about.principles.map((principle) => (
              <article>
                <h3>{principle.title}</h3>
                <p>{principle.body}</p>
              </article>
            ))}
          </div>
        </section>
      </>
    )}

    {page === 'privacy' && (
      <>
        <header class="page-hero">
          <p class="eyebrow">{copy.privacy.eyebrow}</p>
          <h1>{copy.privacy.title}</h1>
          <p class="lede">{copy.privacy.intro}</p>
        </header>

        {copy.privacy.fallbackNotice && <p class="language-notice">{copy.privacy.fallbackNotice}</p>}

        <label class="search-field">
          <span>{copy.privacy.searchLabel}</span>
          <input type="search" placeholder={copy.privacy.searchPlaceholder} data-policy-search />
        </label>
        <p class="empty-state" data-policy-empty hidden>{copy.privacy.empty}</p>

        <div class="notice-grid">
          <section>
            <h2>{copy.privacy.analyticsTitle}</h2>
            <p>{copy.privacy.analyticsBody}</p>
          </section>
          <section>
            <h2>{copy.privacy.siteTitle}</h2>
            <p>{copy.privacy.siteBody}</p>
          </section>
          <section>
            <h2>{copy.privacy.contactTitle}</h2>
            <p>{copy.privacy.contactBody.replace('onnellab.app@gmail.com', '')}<a href="mailto:onnellab.app@gmail.com">onnellab.app@gmail.com</a></p>
          </section>
        </div>

        <section class="policy-list" aria-label={copy.privacy.title}>
          {policies.map((policy) => (
            <a class="policy-row" href={policy.href} data-policy-row data-policy-title={policy.title.toLowerCase()}>
              <div>
                <h2>{policy.title}</h2>
                <p><span>{copy.privacy.updated}</span> <time datetime={policy.date}>{policy.date}</time></p>
              </div>
              <div class="badges" aria-label="Platforms">
                {policy.platforms.map((platform) => <span>{platform}</span>)}
              </div>
            </a>
          ))}
        </section>
        <script is:inline>
          (() => {
            const input = document.querySelector('[data-policy-search]');
            const rows = Array.from(document.querySelectorAll('[data-policy-row]'));
            if (!(input instanceof HTMLInputElement)) return;
            input.addEventListener('input', () => {
              const query = input.value.trim().toLowerCase();
              let visible = 0;
              rows.forEach((row) => {
                const title = row.getAttribute('data-policy-title') ?? '';
                const hidden = query.length > 0 && !title.includes(query);
                row.hidden = hidden;
                if (!hidden) visible += 1;
              });
              const empty = document.querySelector('[data-policy-empty]');
              if (empty instanceof HTMLElement) empty.hidden = visible > 0;
            });
          })();
        </script>
      </>
    )}

    {page === 'terms' && (
      <>
        <header class="page-hero">
          <p class="eyebrow">{copy.terms.eyebrow}</p>
          <h1>{copy.terms.title}</h1>
          <p class="lede">{copy.terms.intro}</p>
          <p class="updated"><strong>{copy.terms.updatedLabel}:</strong> {copy.terms.updatedValue}</p>
        </header>
        <section class="prose terms-prose">
          {copy.terms.sections.map((section) => (
            <section>
              <h2>{section.title}</h2>
              {section.paragraphs.map((paragraph) =>
                paragraph.includes('onnellab.app@gmail.com') ? (
                  <p>{paragraph.replace('onnellab.app@gmail.com', '')}<a href="mailto:onnellab.app@gmail.com">onnellab.app@gmail.com</a></p>
                ) : (
                  <p>{paragraph}</p>
                )
              )}
            </section>
          ))}
        </section>
      </>
    )}

    <footer>
      <a href={routeFor('privacy', locale)}>{copy.nav.privacy}</a>
      <a href={routeFor('terms', locale)}>{copy.nav.terms}</a>
      <a href="mailto:onnellab.app@gmail.com">onnellab.app@gmail.com</a>
      <span>© ONNELLAB</span>
    </footer>
  </main>
</BaseLayout>

<style>
  .site-shell {
    width: min(1080px, calc(100% - 40px));
    margin: 0 auto;
    padding: 26px 0 54px;
    color: #3f3b35;
  }

  .top-nav,
  .nav-links,
  .section-head,
  .app-row,
  .app-title-line,
  .badges,
  footer {
    display: flex;
    align-items: center;
  }

  .top-nav {
    justify-content: space-between;
    gap: 20px;
  }

  .brand,
  .nav-links > a,
  .section-head a,
  footer a {
    color: #686259;
    font-size: 13px;
    font-weight: 620;
    text-decoration: none;
  }

  .brand {
    letter-spacing: 0.02em;
  }

  .nav-links {
    gap: 16px;
  }

  .top-nav a:hover,
  .section-head a:hover,
  footer a:hover {
    color: #2f2d29;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .home-hero,
  .page-hero {
    padding: clamp(88px, 13vw, 154px) 0 clamp(60px, 8vw, 92px);
  }

  .home-hero {
    max-width: 940px;
  }

  .page-hero {
    max-width: 820px;
  }

  .eyebrow {
    margin: 0 0 18px;
    color: #8b8175;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: #37332e;
    font-size: clamp(48px, 9vw, 96px);
    font-weight: 650;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .lede,
  .home-hero .lede {
    max-width: 760px;
    margin: 28px 0 0;
    color: #6a6359;
    font-size: clamp(17px, 2vw, 21px);
    line-height: 1.75;
  }

  .featured {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: clamp(28px, 5vw, 58px);
    align-items: center;
    border-top: 1px solid #ddd4c8;
    border-bottom: 1px solid #ddd4c8;
    padding: 58px 0;
  }

  .featured-icon img {
    width: 112px;
    height: 112px;
    border-radius: 25px;
    box-shadow: 0 14px 34px rgba(58, 49, 40, 0.12);
  }

  .featured h2,
  .section > h2,
  .section-head h2 {
    margin: 0;
    color: #3b3732;
    font-size: clamp(28px, 4.3vw, 46px);
    font-weight: 640;
    letter-spacing: -0.04em;
    line-height: 1.12;
  }

  .featured > div > p:not(.eyebrow) {
    max-width: 700px;
    margin: 18px 0 0;
    color: #696158;
    font-size: 16px;
    line-height: 1.75;
  }

  .text-link {
    display: inline-block;
    margin-top: 22px;
    color: #4d6175;
    font-size: 14px;
    font-weight: 650;
    text-underline-offset: 5px;
  }

  .section {
    border-bottom: 1px solid #e1d9cd;
    padding: 66px 0 72px;
  }

  .section-head {
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 30px;
  }

  .section-head a {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .product-grid,
  .value-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .product-card {
    min-height: 185px;
    border: 1px solid #ded6ca;
    border-radius: 17px;
    padding: 25px;
    background: rgba(255, 253, 248, 0.62);
    color: inherit;
    text-decoration: none;
    transition: transform 150ms ease, border-color 150ms ease, background 150ms ease;
  }

  .product-card:hover,
  .product-card:focus-visible {
    border-color: #cfc4b5;
    background: #fffdf8;
    transform: translateY(-2px);
  }

  .product-card:focus-visible,
  .app-row:focus-visible,
  .policy-row:focus-visible {
    outline: 2px solid #827d72;
    outline-offset: 3px;
  }

  .product-card img,
  .app-row img {
    border-radius: 13px;
  }

  .product-card h3,
  .value-grid h3 {
    margin: 18px 0 0;
    color: #403b35;
    font-size: 19px;
    font-weight: 650;
  }

  .product-card p,
  .value-grid p {
    margin: 10px 0 0;
    color: #71695f;
    font-size: 14px;
    line-height: 1.65;
  }

  .value-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 32px;
  }

  .value-grid article {
    border-top: 2px solid #c7bad3;
    padding: 22px 8px 0 0;
  }

  .value-grid h3 {
    margin-top: 0;
  }

  .language-notice,
  .empty-state {
    border-left: 3px solid #c9b9d6;
    margin: -34px 0 34px;
    padding: 12px 16px;
    background: rgba(247, 242, 249, 0.66);
    color: #675f6b;
    font-size: 13px;
    line-height: 1.65;
  }

  .search-field {
    display: grid;
    gap: 8px;
    max-width: 340px;
    margin-bottom: 30px;
    color: #6f695f;
    font-size: 13px;
    font-weight: 640;
  }

  .search-field input {
    min-height: 44px;
    border: 1px solid #ded6ca;
    border-radius: 9px;
    padding: 10px 13px;
    background: rgba(255, 253, 248, 0.78);
    color: #3f3b35;
    font: inherit;
    font-weight: 500;
  }

  .search-field input:focus {
    border-color: #c8bdaf;
    outline: 2px solid #827d72;
    outline-offset: 3px;
  }

  .app-list,
  .policy-list {
    border-top: 1px solid #ded6ca;
    border-bottom: 1px solid #ded6ca;
  }

  .app-row,
  .policy-row {
    position: relative;
    gap: 20px;
    border-bottom: 1px solid #e8e0d4;
    padding: 20px 16px;
    color: inherit;
    text-decoration: none;
  }

  .app-row:last-child,
  .policy-row:last-child {
    border-bottom: 0;
  }

  .app-row[hidden],
  .policy-row[hidden] {
    display: none;
  }

  .app-row:hover,
  .policy-row:hover {
    background: rgba(255, 253, 248, 0.7);
  }

  .app-copy,
  .policy-row > div:first-child {
    min-width: 0;
    flex: 1;
  }

  .app-title-line {
    flex-wrap: wrap;
    gap: 8px 12px;
  }

  .app-title-line h2,
  .policy-row h2 {
    margin: 0;
    color: #3e3933;
    font-size: 21px;
    font-weight: 650;
  }

  .app-title-line span {
    border-radius: 999px;
    padding: 3px 8px;
    background: #f0eaf3;
    color: #665d6d;
    font-size: 11px;
    font-weight: 650;
  }

  .app-copy > p,
  .policy-row p {
    margin: 7px 0 0;
    color: #746c62;
    font-size: 13px;
    line-height: 1.55;
  }

  .policy-row {
    display: flex;
    align-items: center;
  }

  .policy-row p span {
    font-weight: 630;
  }

  .badges {
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 5px;
  }

  .badges span {
    border: 1px solid #ddd5c8;
    border-radius: 999px;
    padding: 3px 7px;
    color: #737067;
    font-size: 11px;
    line-height: 1.4;
    white-space: nowrap;
  }

  .prose {
    max-width: 790px;
  }

  .lead-prose {
    border-top: 1px solid #ded6ca;
    padding: 50px 0 66px;
  }

  .prose p {
    margin: 0 0 22px;
    color: #5f584f;
    font-size: clamp(17px, 2vw, 20px);
    line-height: 1.82;
  }

  .terms-prose {
    border-top: 1px solid #ded6ca;
    padding-top: 10px;
  }

  .terms-prose section {
    border-bottom: 1px solid #e3dbcf;
    padding: 36px 0 30px;
  }

  .terms-prose h2,
  .notice-grid h2 {
    margin: 0 0 12px;
    color: #413c36;
    font-size: 20px;
    font-weight: 660;
  }

  .terms-prose p,
  .notice-grid p {
    margin: 0;
    color: #686158;
    font-size: 15px;
    line-height: 1.75;
  }

  .updated {
    margin: 22px 0 0;
    color: #7a7268;
    font-size: 13px;
  }

  .notice-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0 0 42px;
  }

  .notice-grid section {
    border-top: 2px solid #c7bad3;
    padding: 20px 6px 0 0;
  }

  .notice-grid a,
  .terms-prose a {
    color: #3d5f82;
    text-underline-offset: 4px;
  }

  footer {
    flex-wrap: wrap;
    justify-content: center;
    gap: 9px 20px;
    margin-top: 58px;
    border-top: 1px solid #ded6ca;
    padding-top: 28px;
    color: #857d72;
    font-size: 12px;
  }

  @media (max-width: 760px) {
    .site-shell {
      width: min(100% - 30px, 1080px);
      padding-top: 20px;
    }

    .nav-links {
      gap: 10px;
    }

    .nav-links > a:nth-of-type(2),
    .nav-links > a:nth-of-type(3) {
      display: none;
    }

    .featured {
      grid-template-columns: 1fr;
    }

    .product-grid,
    .value-grid,
    .notice-grid {
      grid-template-columns: 1fr;
    }

    .app-row,
    .policy-row {
      align-items: flex-start;
    }
  }

  @media (max-width: 520px) {
    .home-hero,
    .page-hero {
      padding: 72px 0 54px;
    }

    h1 {
      font-size: clamp(44px, 14vw, 66px);
    }

    .app-row,
    .policy-row {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 14px;
      padding: 17px 10px;
    }

    .badges {
      grid-column: 2;
      justify-content: flex-start;
    }

    .policy-row > div:first-child {
      grid-column: 1 / -1;
    }

    .policy-row .badges {
      grid-column: 1 / -1;
    }
  }
</style>
