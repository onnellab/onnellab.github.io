---
import {
  allLocaleDefinitions,
  allSiteLocales,
  type AllSiteLocale
} from '../lib/extended-site-i18n';

type Props = {
  locale: AllSiteLocale;
  slug?: string;
};

const { locale, slug } = Astro.props;
const definition = allLocaleDefinitions[locale];
const hrefFor = (item: AllSiteLocale) => {
  const segment = allLocaleDefinitions[item].pathSegment;
  if (slug) {
    if (item === 'en') return `/blog/en/${slug}/`;
    return `/blog/${segment}/${slug}/`;
  }
  if (item === 'en') return '/blog/';
  return `/blog/${segment}/`;
};
const ariaLabel = {
  en: `Language: ${definition.label}`,
  ko: `언어: ${definition.label}`,
  ja: `言語: ${definition.label}`,
  'zh-Hans': `语言：${definition.label}`,
  'zh-Hant': `語言：${definition.label}`,
  'pt-BR': `Idioma: ${definition.label}`,
  de: `Sprache: ${definition.label}`,
  fr: `Langue : ${definition.label}`,
  es: `Idioma: ${definition.label}`
}[locale];
---

<details class="blog-locale-menu">
  <summary class="site-language-control" aria-label={ariaLabel}>{definition.label}</summary>
  <ul>
    {allSiteLocales.map((item) => {
      const itemDefinition = allLocaleDefinitions[item];
      return (
        <li>
          <a
            href={hrefFor(item)}
            lang={itemDefinition.htmlLang}
            hreflang={itemDefinition.hreflang}
            data-locale-choice={item}
            aria-current={item === locale ? 'page' : undefined}
          >
            {itemDefinition.label}
          </a>
        </li>
      );
    })}
  </ul>
</details>

<style>
  .blog-locale-menu {
    position: relative;
    z-index: 20;
  }

  .blog-locale-menu summary {
    min-height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #ded6ca;
    border-radius: 999px;
    padding: 6px 12px;
    background: rgba(255, 253, 248, 0.82);
    color: #5f5a50;
    cursor: pointer;
    font-size: 13px;
    font-weight: 650;
    line-height: 1.35;
    list-style: none;
    white-space: nowrap;
  }

  .blog-locale-menu summary::-webkit-details-marker {
    display: none;
  }

  .blog-locale-menu summary::after {
    content: '⌄';
    margin-left: 7px;
    color: #90877b;
    font-size: 12px;
  }

  .blog-locale-menu ul {
    width: max-content;
    min-width: 170px;
    position: absolute;
    top: calc(100% + 7px);
    right: 0;
    display: grid;
    gap: 2px;
    margin: 0;
    border: 1px solid #ded6ca;
    border-radius: 12px;
    padding: 6px;
    background: #fffdf8;
    box-shadow: 0 14px 34px rgba(57, 48, 39, 0.11);
    list-style: none;
  }

  .blog-locale-menu a {
    display: block;
    border-radius: 8px;
    padding: 8px 10px;
    color: #5f5a50;
    font-size: 13px;
    font-weight: 560;
    text-decoration: none;
  }

  .blog-locale-menu a:hover,
  .blog-locale-menu a[aria-current='page'] {
    background: #f4efe7;
    color: #383631;
  }

  .blog-locale-menu summary:focus-visible,
  .blog-locale-menu a:focus-visible {
    outline: 2px solid #827d72;
    outline-offset: 3px;
  }
</style>
