---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocaleMenu from './LocaleMenu.astro';
import SiteFooter from './SiteFooter.astro';
import { getProductIndexItems } from '../lib/products';
import {
  contentLocale,
  localeAlternates,
  localeDefinitions,
  routeFor,
  type SiteLocale
} from '../lib/site-i18n';

type Props = {
  locale: SiteLocale;
};

type PrivacyCopy = {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  intro: string;
  searchLabel: string;
  searchPlaceholder: string;
  empty: string;
  updated: string;
  analyticsTitle: string;
  analyticsBody: string;
  siteTitle: string;
  siteBody: string;
  contactTitle: string;
  contactBody: string;
  fallbackNotice?: string;
};

const copies: Record<SiteLocale, PrivacyCopy> = {
  en: {
    title: 'ONNELLAB Privacy Policies',
    description: 'Privacy policy links for ONNELLAB apps.',
    eyebrow: 'Legal',
    heading: 'Privacy Policies',
    intro: 'Choose an app to read the policy that matches its actual data flow and platform features.',
    searchLabel: 'Find app',
    searchPlaceholder: 'Search app name',
    empty: 'No matching apps.',
    updated: 'Policy date',
    analyticsTitle: 'Website analytics',
    analyticsBody:
      'When Google Analytics is configured, the ONNELLAB website may measure aggregate events such as page visits, language switches, store clicks, and screenshot opens to improve the site. It does not collect app file contents, tag values, or account information.',
    siteTitle: 'ONNELLAB website privacy',
    siteBody:
      'This website provides original ONNELLAB content and product information. External publishing APIs are used only for approved ONNELLAB-owned content and ONNELLAB-controlled accounts. ONNELLAB does not sell or analyze other users’ private social data.',
    contactTitle: 'Contact',
    contactBody: 'For privacy questions, contact onnellab.app@gmail.com.'
  },
  ko: {
    title: 'ONNELLAB 개인정보 처리방침',
    description: 'ONNELLAB 앱별 개인정보 처리방침을 확인해요.',
    eyebrow: '법적 안내',
    heading: '개인정보 처리방침',
    intro: '앱마다 실제 데이터 흐름과 플랫폼 기능에 맞는 개인정보 처리방침을 제공해요.',
    searchLabel: '앱 찾기',
    searchPlaceholder: '앱 이름을 검색해요',
    empty: '일치하는 앱이 없어요.',
    updated: '작성 날짜',
    analyticsTitle: '사이트 이용 분석',
    analyticsBody:
      'Google Analytics가 설정된 경우에만 사이트 개선을 위해 페이지 방문, 언어 전환, 스토어 이동과 스크린샷 열람 같은 집계 이벤트를 측정할 수 있어요. 앱 안의 파일 내용, 태그 값이나 계정 정보는 수집하지 않아요.',
    siteTitle: 'ONNELLAB 웹사이트 개인정보',
    siteBody:
      '이 웹사이트는 ONNELLAB이 만든 콘텐츠와 제품 정보를 제공해요. 외부 게시 API는 승인된 ONNELLAB 콘텐츠와 ONNELLAB이 관리하는 계정에만 사용해요. 다른 사용자의 비공개 소셜 데이터를 판매하거나 분석하지 않아요.',
    contactTitle: '문의',
    contactBody: '개인정보 관련 문의는 onnellab.app@gmail.com으로 보내요.'
  },
  ja: {
    title: 'ONNELLAB プライバシーポリシー',
    description: 'ONNELLABアプリごとのプライバシーポリシーです。',
    eyebrow: '法的情報',
    heading: 'プライバシーポリシー',
    intro: '各アプリの実際のデータフローとプラットフォーム機能に合わせたポリシーを掲載しています。',
    searchLabel: 'アプリを探す',
    searchPlaceholder: 'アプリ名で検索',
    empty: '該当するアプリはありません。',
    updated: 'ポリシー日付',
    analyticsTitle: 'ウェブサイトの利用分析',
    analyticsBody:
      'Google Analyticsが設定されている場合に限り、サイト改善のため、ページ閲覧、言語切り替え、ストアへの移動、スクリーンショット表示などの集計イベントを測定することがあります。アプリ内のファイル内容、タグ値、アカウント情報は収集しません。',
    siteTitle: 'ONNELLABウェブサイトのプライバシー',
    siteBody:
      '本サイトはONNELLABのコンテンツと製品情報を提供します。外部投稿APIは承認済みのONNELLABコンテンツとONNELLAB管理アカウントにのみ使用します。他の利用者の非公開ソーシャルデータを販売または分析しません。',
    contactTitle: 'お問い合わせ',
    contactBody: 'プライバシーに関するお問い合わせは onnellab.app@gmail.com までお送りください。',
  },
  'zh-Hans': {
    title: 'ONNELLAB 隐私政策',
    description: 'ONNELLAB 各应用的隐私政策。',
    eyebrow: '法律信息',
    heading: '隐私政策',
    intro: '每款应用都提供与实际数据流和平台功能相符的隐私政策。',
    searchLabel: '查找应用',
    searchPlaceholder: '搜索应用名称',
    empty: '没有匹配的应用。',
    updated: '政策日期',
    analyticsTitle: '网站使用分析',
    analyticsBody:
      '仅在配置 Google Analytics 时，本网站可能为改进体验而统计页面访问、语言切换、前往商店和查看截图等汇总事件。不会收集应用内文件内容、标签值或账号信息。',
    siteTitle: 'ONNELLAB 网站隐私',
    siteBody:
      '本网站提供 ONNELLAB 原创内容与产品信息。外部发布 API 仅用于经批准的 ONNELLAB 内容和由 ONNELLAB 管理的账号。我们不会出售或分析其他用户的私密社交数据。',
    contactTitle: '联系',
    contactBody: '隐私相关问题请发送至 onnellab.app@gmail.com。',
  },
  'zh-Hant': {
    title: 'ONNELLAB 隱私權政策',
    description: 'ONNELLAB 各應用程式的隱私權政策。',
    eyebrow: '法律資訊',
    heading: '隱私權政策',
    intro: '每款應用程式都提供與實際資料流程和平台功能相符的隱私權政策。',
    searchLabel: '尋找應用程式',
    searchPlaceholder: '搜尋應用程式名稱',
    empty: '沒有符合的應用程式。',
    updated: '政策日期',
    analyticsTitle: '網站使用分析',
    analyticsBody:
      '僅在設定 Google Analytics 時，本網站可能為改善體驗而統計頁面瀏覽、語言切換、前往商店和查看截圖等彙總事件。不會蒐集應用程式內的檔案內容、標籤值或帳號資訊。',
    siteTitle: 'ONNELLAB 網站隱私',
    siteBody:
      '本網站提供 ONNELLAB 原創內容與產品資訊。外部發布 API 僅用於經核准的 ONNELLAB 內容和由 ONNELLAB 管理的帳號。我們不會出售或分析其他使用者的私人社群資料。',
    contactTitle: '聯絡',
    contactBody: '隱私相關問題請寄至 onnellab.app@gmail.com。',
  }
};

const { locale } = Astro.props;
const copy = copies[locale];
const definition = localeDefinitions[locale];
const canonicalPath = routeFor('privacy', locale);
const privacyUpdatedAtByTitle: Record<string, string> = {
  Aligna: '2026-06-24',
  ClipNest: '2026-06-13',
  Melivra: '2026-07-09',
  Meriq: '2026-08-23',
  Papira: '2026-08-21',
  Quivra: '2026-02-10',
  Segra: '2026-06-12',
  TagWeaver: '2026-02-14',
  VaultXT: '2026-03-11'
};
const existingApps = getProductIndexItems(contentLocale(locale));
const existingPolicyHref = (href: string) => {
  const segment = localeDefinitions[locale].pathSegment;
  return segment ? href.replace(/\/?$/, `/${segment}/`) : href;
};
const policies = [
  ...existingApps.map((app) => ({
    title: app.title,
    href: existingPolicyHref(app.privacy),
    date: privacyUpdatedAtByTitle[app.title] ?? '2026-01-01',
    platforms: app.platforms
  })),
  {
    title: 'Papira',
    href: routeFor('papiraPrivacy', locale),
    date: privacyUpdatedAtByTitle.Papira,
    platforms: ['iOS', 'Android']
  }
].sort((a, b) => a.title.localeCompare(b.title, 'en', { sensitivity: 'base' }));
const email = 'onnellab.app@gmail.com';
const emailIndex = copy.contactBody.indexOf(email);
const contactBefore = emailIndex >= 0 ? copy.contactBody.slice(0, emailIndex) : copy.contactBody;
const contactAfter = emailIndex >= 0 ? copy.contactBody.slice(emailIndex + email.length) : '';
const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': new URL(`${canonicalPath}#privacy-policies`, Astro.site).toString(),
  name: copy.title,
  description: copy.description,
  url: new URL(canonicalPath, Astro.site).toString(),
  inLanguage: definition.htmlLang,
  isPartOf: { '@id': new URL('/#website', Astro.site).toString() },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: policies.map((policy, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: `${policy.title} Privacy Policy`,
      url: new URL(policy.href, Astro.site).toString()
    }))
  }
};
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  canonicalPath={canonicalPath}
  lang={definition.htmlLang}
  jsonLd={collectionJsonLd}
  alternates={localeAlternates('privacy')}
>
  <main class="page-shell information-shell" data-privacy-page data-locale={locale}>
    <nav class="top-nav site-header" aria-label="Navigation">
      <a class="brand" href={routeFor('home', locale)}>ONNELLAB</a>
      <LocaleMenu locale={locale} page="privacy" />
    </nav>

    <header>
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1 class="information-heading">{copy.heading}</h1>
      <p class="intro">{copy.intro}</p>
    </header>

    {copy.fallbackNotice && <p class="language-notice">{copy.fallbackNotice}</p>}

    <label class="policy-search">
      <span>{copy.searchLabel}</span>
      <input type="search" placeholder={copy.searchPlaceholder} data-policy-search />
    </label>

    <p class="empty-state" data-policy-empty hidden>{copy.empty}</p>

    <div class="notice-grid">
      <section>
        <h2>{copy.analyticsTitle}</h2>
        <p>{copy.analyticsBody}</p>
      </section>
      <section>
        <h2>{copy.siteTitle}</h2>
        <p>{copy.siteBody}</p>
      </section>
      <section data-contact-notice>
        <h2>{copy.contactTitle}</h2>
        <p>{contactBefore}<a href={`mailto:${email}`}>{email}</a>{contactAfter}</p>
      </section>
    </div>

    <section class="policy-list" aria-label={copy.heading}>
      {policies.map((policy) => (
        <a class="policy-row" href={policy.href} data-policy-row data-policy-title={policy.title.toLowerCase()}>
          <div>
            <h2>{policy.title}</h2>
            <p><span>{copy.updated}</span> <time datetime={policy.date}>{policy.date}</time></p>
          </div>
          <div class="platform-badges" aria-label="Platforms">
            {policy.platforms.map((platform) => <span>{platform}</span>)}
          </div>
        </a>
      ))}
    </section>

    <SiteFooter locale={locale} />

    <script is:inline>
      (() => {
        const policySearch = document.querySelector('[data-policy-search]');
        const policyRows = Array.from(document.querySelectorAll('[data-policy-row]'));
        if (!(policySearch instanceof HTMLInputElement)) return;

        policySearch.addEventListener('input', () => {
          const query = policySearch.value.trim().toLowerCase();
          let visibleCount = 0;
          policyRows.forEach((row) => {
            const title = row.getAttribute('data-policy-title') ?? '';
            const isHidden = query.length > 0 && !title.includes(query);
            row.hidden = isHidden;
            if (!isHidden) visibleCount += 1;
          });
          const emptyState = document.querySelector('[data-policy-empty]');
          if (emptyState instanceof HTMLElement) emptyState.hidden = visibleCount > 0;
        });
      })();
    </script>
  </main>
</BaseLayout>

<style>
  .page-shell {
    color: #3f3b35;
  }

  .top-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .brand {
    text-decoration: none;
  }

  header {
    padding: 68px 0 34px;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: #827d72;
    font-size: 12px;
    font-weight: 680;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: #36332f;
  }

  .intro {
    max-width: 840px;
    margin: 22px 0 0;
    color: #5b574f;
    font-size: 18px;
    line-height: 1.65;
  }

  .language-notice {
    border-left: 3px solid #c9b9d6;
    margin: 0 0 26px;
    padding: 12px 16px;
    background: rgba(247, 242, 249, 0.66);
    color: #675f6b;
    font-size: 13px;
    line-height: 1.65;
  }

  .policy-search {
    display: grid;
    gap: 8px;
    max-width: 340px;
    color: #6f695f;
    font-size: 13px;
    font-weight: 620;
  }

  .policy-search input {
    min-height: 44px;
    border: 1px solid #ded6ca;
    border-radius: 8px;
    padding: 9px 12px;
    background: rgba(255, 253, 248, 0.78);
    color: #3f3b35;
    font: inherit;
    font-weight: 500;
  }

  .policy-search input:focus {
    border-color: #cfc5b7;
    outline: 2px solid #827d72;
    outline-offset: 3px;
  }

  .empty-state {
    border-top: 1px solid #e0d8cb;
    border-bottom: 1px solid #e0d8cb;
    margin: 18px 0 0;
    padding: 18px 0;
    color: #827d72;
    font-size: 14px;
  }

  .notice-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin: 38px 0 42px;
  }

  .notice-grid section {
    border-top: 2px solid #c7bad3;
    padding: 20px 6px 0 0;
  }

  .notice-grid h2 {
    margin: 0 0 10px;
    color: #413c36;
    font-size: 19px;
    line-height: 1.35;
  }

  .notice-grid p {
    margin: 0;
    color: #686158;
    font-size: 14px;
    line-height: 1.72;
  }

  .notice-grid a {
    color: #3d5f82;
    text-underline-offset: 4px;
  }

  .policy-list {
    border-top: 1px solid #ded6ca;
    border-bottom: 1px solid #ded6ca;
  }

  .policy-row {
    display: flex;
    align-items: center;
    gap: 20px;
    border-bottom: 1px solid #e8e0d4;
    padding: 19px 16px;
    color: inherit;
    text-decoration: none;
  }

  .policy-row:last-child {
    border-bottom: 0;
  }

  .policy-row[hidden] {
    display: none;
  }

  .policy-row:hover {
    background: rgba(255, 253, 248, 0.7);
  }

  .policy-row:focus-visible {
    outline: 2px solid #827d72;
    outline-offset: 3px;
  }

  .policy-row > div:first-child {
    min-width: 0;
    flex: 1;
  }

  .policy-row h2 {
    margin: 0;
    color: #3e3933;
    font-size: 21px;
    line-height: 1.3;
  }

  .policy-row p {
    margin: 7px 0 0;
    color: #746c62;
    font-size: 13px;
  }

  .policy-row p span {
    font-weight: 630;
  }

  .platform-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 5px;
  }

  .platform-badges span {
    border: 1px solid #ddd5c8;
    border-radius: 999px;
    padding: 3px 7px;
    color: #737067;
    font-size: 11px;
    line-height: 1.4;
    white-space: nowrap;
  }

  @media (max-width: 700px) {
    header {
      padding: 48px 0 30px;
    }

    .intro {
      font-size: 16px;
      line-height: 1.62;
    }

    .notice-grid {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .policy-row {
      align-items: flex-start;
      padding: 17px 10px;
    }

    .platform-badges {
      justify-content: flex-start;
    }
  }
</style>
