---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from './SiteFooter.astro';
import { uiLabels } from '../lib/ui-labels';
import {
  getPrivacyPolicyDocument,
  type AllPrivacyAppSlug
} from '../lib/privacy-policy-documents';
import {
  allAppPrivacyRouteFor,
  allLocaleDefinitions,
  allRouteFor,
  allSiteLocales,
  type AllSiteLocale
} from '../lib/extended-site-i18n';

type Props = { slug: AllPrivacyAppSlug; locale: AllSiteLocale };
const { slug, locale } = Astro.props;
const policy = getPrivacyPolicyDocument(slug, locale);
const definition = allLocaleDefinitions[locale];
const canonicalPath = allAppPrivacyRouteFor(slug, locale);
const alternates = [
  ...allSiteLocales.map((item) => ({
    lang: allLocaleDefinitions[item].hreflang,
    path: allAppPrivacyRouteFor(slug, item)
  })),
  { lang: 'x-default', path: allAppPrivacyRouteFor(slug, 'en') }
];
const email = 'onnellab.app@gmail.com';
---

<BaseLayout
  title={policy.title}
  description={policy.description}
  canonicalPath={canonicalPath}
  lang={definition.htmlLang}
  alternates={alternates}
  ogType="article"
>
  <main class="privacy-shell" data-app-privacy={slug} data-policy-locale={locale}>
    <nav class="topbar site-header" aria-label={uiLabels[locale].navigation}>
      <a class="home-link brand" href={allRouteFor('home', locale)}>ONNELLAB</a>
      <details class="locale-menu">
        <summary class="site-language-control" aria-label={definition.label}>{definition.label}</summary>
        <ul class="locale-menu-panel">
          {allSiteLocales.map((item) => {
            const localized = allLocaleDefinitions[item];
            return (
              <li>
                <a
                  href={allAppPrivacyRouteFor(slug, item)}
                  lang={localized.htmlLang}
                  hreflang={localized.hreflang}
                  data-locale-choice={item}
                  aria-current={item === locale ? 'page' : undefined}
                >
                  {localized.label}
                </a>
              </li>
            );
          })}
        </ul>
      </details>
    </nav>

    <header>
      <h1>{policy.title}</h1>
      <p class="intro">{policy.intro}</p>
      <p class="updated">
        <strong>{policy.updatedLabel}:</strong>
        <time datetime={policy.updatedAt}>{policy.updatedAt}</time>
      </p>
    </header>

    <hr />
    <h2>{policy.heading}</h2>
    <p class="opening">{policy.opening}</p>

    {policy.sections.map((section, sectionIndex) => (
      <section aria-labelledby={`privacy-section-${sectionIndex + 1}`}>
        <h3 id={`privacy-section-${sectionIndex + 1}`}>{section.title}</h3>
        {section.blocks.map((block) => (
          block.kind === 'list'
            ? <ul>{block.items.map((item) => <li>{item}</li>)}</ul>
            : <p>{block.value.split(email).map((part, i, all) => (
                <>{part}{i < all.length - 1 && <a href={`mailto:${email}`}>{email}</a>}</>
              ))}</p>
        ))}
      </section>
    ))}

    {policy.externalLinks && policy.externalLinks.length > 0 && (
      <aside class="external-policy-links">
        {policy.externalLinks.map((link) => (
          <a href={link.href} rel="noopener noreferrer">{link.label}</a>
        ))}
      </aside>
    )}

    <SiteFooter locale={locale} />
  </main>
</BaseLayout>

<style>
  .privacy-shell {
    width: min(860px, calc(100% - 36px));
    margin: 0 auto;
    padding: 28px 0 56px;
    color: #4d4942;
    line-height: 1.75;
    overflow-wrap: break-word;
  }
  .topbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .home-link.home-link { color: #68645c; text-decoration: none; font-size: 14px; font-weight: 620; }
  .locale-menu { position: relative; z-index: 20; }
  .locale-menu summary {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    border: 1px solid #ded6ca;
    border-radius: 999px;
    padding: 7px 13px;
    background: rgba(255,253,248,.82);
    color: #5f5a50;
    cursor: pointer;
    font-size: 13px;
    font-weight: 620;
    list-style: none;
  }
  .locale-menu summary::-webkit-details-marker { display: none; }
  .locale-menu ul {
    position: absolute;
    right: 0;
    top: calc(100% + 7px);
    width: max-content;
    min-width: 170px;
    display: grid;
    gap: 2px;
    margin: 0;
    border: 1px solid #ded6ca;
    border-radius: 12px;
    padding: 6px;
    background: #fffdf8;
    box-shadow: 0 14px 34px rgba(57,48,39,.11);
    list-style: none;
  }
  .locale-menu li { margin: 0; }
  .locale-menu a {
    display: block;
    border-radius: 8px;
    padding: 8px 10px;
    color: #5f5a50;
    text-decoration: none;
    font-size: 13px;
  }
  .locale-menu a:hover, .locale-menu a[aria-current='page'] { background: #f4efe7; color: #383631; }
  .locale-menu summary:focus-visible, .locale-menu a:focus-visible, .home-link:focus-visible {
    outline: 2px solid #827d72;
    outline-offset: 3px;
  }
  header { margin: 58px 0 22px; }
  h1 { margin: 0; color: #282723; font-size: clamp(36px, 6vw, 64px); line-height: 1.08; }
  h2 { margin: 30px 0 8px; color: #34322d; font-size: 26px; }
  h3 { margin: 0 0 10px; color: #34322d; font-size: 21px; line-height: 1.35; }
  p { margin: 10px 0 0; font-size: 16px; }
  .updated time { margin-left: 6px; }
  ul { padding-left: 24px; }
  li { margin: 6px 0; }
  section { border-top: 1px solid #e5ded4; margin-top: 22px; padding-top: 22px; }
  hr { border: 0; border-top: 1px solid #e5ded4; margin: 24px 0; }
  section a, .external-policy-links a {
    color: #3d5f82;
    text-decoration-color: rgba(61,95,130,.36);
    text-underline-offset: 4px;
  }
  .external-policy-links { margin-top: 28px; font-size: 13px; }
  @media (max-width: 640px) {
    .privacy-shell { width: min(100% - 28px, 860px); padding-top: 22px; }
    header { margin-top: 38px; }
    .locale-menu ul { right: 0; }
  }
</style>
