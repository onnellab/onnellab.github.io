---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocaleMenu from './LocaleMenu.astro';
import { papiraCopy } from '../lib/papira';
import {
  localeAlternates,
  localeDefinitions,
  routeFor,
  type SiteLocale
} from '../lib/site-i18n';

type Props = { locale: SiteLocale };

const { locale } = Astro.props;
const text = papiraCopy[locale];
const definition = localeDefinitions[locale];
const canonicalPath = routeFor('papira', locale);
const privacyPath = routeFor('papiraPrivacy', locale);
const appIcon = '/app-assets/papira/assets/icon/Papira.png';
const accentStyle = '--accent-border:#d7cfdb;--accent-bg:#f4eff5;--accent-text:#614f68;';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    '@id': new URL(`${canonicalPath}#softwareapplication`, Astro.site).toString(),
    name: 'Papira',
    description: text.seoDescription,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: ['iOS', 'Android'],
    inLanguage: definition.htmlLang,
    url: new URL(canonicalPath, Astro.site).toString(),
    image: new URL(appIcon, Astro.site).toString(),
    featureList: text.features,
    privacyPolicy: new URL(privacyPath, Astro.site).toString(),
    publisher: {
      '@type': 'Organization',
      '@id': new URL('/#organization', Astro.site).toString(),
      name: 'ONNELLAB',
      url: new URL('/', Astro.site).toString()
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': new URL(`${canonicalPath}#faq`, Astro.site).toString(),
    mainEntity: text.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer }
    }))
  }
];
---

<BaseLayout
  title={text.seoTitle}
  description={text.seoDescription}
  canonicalPath={canonicalPath}
  lang={definition.htmlLang}
  image={appIcon}
  favicon={appIcon}
  jsonLd={jsonLd}
  alternates={localeAlternates('papira')}
>
  <main class="page-shell" style={accentStyle} data-product-slug="papira" data-product-locale={locale}>
    <header class="topbar" aria-label="ONNELLAB">
      <a class="brand" href={routeFor('home', locale)}>ONNELLAB</a>
      <div class="nav-actions">
        <a class="apps-link" href={routeFor('apps', locale)}>{text.appsLabel}</a>
        <LocaleMenu locale={locale} page="papira" />
      </div>
    </header>

    <section class="hero" aria-labelledby="product-title" data-app="papira">
      <div class="hero-grid">
        <div class="identity">
          <img src={appIcon} alt="Papira app icon" width="124" height="124" data-no-visual-search="true" />
          <div>
            <p class="eyebrow">{text.eyebrow}</p>
            <h1 id="product-title">Papira</h1>
            <p class="intro">{text.tagline}</p>
          </div>
        </div>

        <div class="task-preview" aria-label={text.featuresTitle}>
          {text.features.slice(0, 3).map((feature, index) => (
            <div class="task-row">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{feature}</strong>
            </div>
          ))}
        </div>
      </div>

      <p class="hero-description">{text.lead}</p>

      <dl class="meta-list">
        <div class="meta-pill status-pill">
          <dt>{text.statusLabel}</dt>
          <dd><span>{text.statusValue}</span></dd>
        </div>
        <div class="meta-pill">
          <dt>{text.platformsLabel}</dt>
          <dd>{text.platformsValue.split(/\s*[,·/]\s*/).filter(Boolean).map((platform) => <span>{platform}</span>)}</dd>
        </div>
      </dl>
    </section>

    <section class="content-band" aria-labelledby="modes-title">
      <div class="band-heading">
        <p>01</p>
        <h2 id="modes-title">{text.modesTitle}</h2>
      </div>
      <div class="mode-grid">
        {text.modes.map((mode) => (
          <article>
            <h3>{mode.title}</h3>
            <p>{mode.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="content-band" aria-labelledby="features-title">
      <div class="band-heading">
        <p>02</p>
        <h2 id="features-title">{text.featuresTitle}</h2>
      </div>
      <ul class="feature-list">
        {text.features.map((feature) => <li>{feature}</li>)}
      </ul>
    </section>

    <section class="split-band">
      <article aria-labelledby="privacy-title">
        <p class="section-number">03</p>
        <h2 id="privacy-title">{text.privacyTitle}</h2>
        <ul>{text.privacyItems.map((item) => <li>{item}</li>)}</ul>
      </article>
      <article aria-labelledby="boundaries-title">
        <p class="section-number">04</p>
        <h2 id="boundaries-title">{text.boundariesTitle}</h2>
        <ul>{text.boundaries.map((item) => <li>{item}</li>)}</ul>
      </article>
    </section>

    <section class="faq-band" aria-labelledby="faq-title">
      <div class="band-heading">
        <p>05</p>
        <h2 id="faq-title">{text.faqTitle}</h2>
      </div>
      <div class="faq-list">
        {text.faqs.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="support-band" aria-label={text.contactLabel}>
      <a href={privacyPath}>{text.privacyLabel}</a>
      <a href="mailto:onnellab.app@gmail.com">{text.contactLabel}</a>
    </section>

    <footer>
      <a href={privacyPath}>{text.privacyLabel}</a>
      <a href="mailto:onnellab.app@gmail.com">onnellab.app@gmail.com</a>
      <span>© ONNELLAB</span>
    </footer>
  </main>
</BaseLayout>

<style>
  .page-shell {
    width: min(1040px, calc(100% - 36px));
    margin: 0 auto;
    padding: 24px 0 30px;
    color: #3f3b35;
  }

  .topbar,
  .nav-actions,
  footer {
    display: flex;
    align-items: center;
  }

  .topbar {
    justify-content: space-between;
    gap: 16px;
  }

  .nav-actions {
    gap: 12px;
  }

  .apps-link,
  footer a {
    color: #686259;
    font-size: 13px;
    font-weight: 620;
    text-decoration: none;
  }

  .apps-link:hover,
  footer a:hover {
    color: #2f2d29;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .hero {
    position: relative;
    min-height: 452px;
    display: grid;
    align-content: center;
    gap: 21px;
    border-bottom: 1px solid #e0d8cb;
    padding: 48px 0 40px;
    overflow: hidden;
    background: linear-gradient(180deg, rgba(255,253,248,0), rgba(255,253,248,.34) 48%, rgba(255,253,248,0));
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 178px 0 116px auto;
    width: 140px;
    background:
      linear-gradient(90deg, var(--accent-border) 0 1px, transparent 1px),
      linear-gradient(0deg, var(--accent-border) 0 1px, transparent 1px);
    background-size: 23px 23px;
    opacity: .09;
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(250px, 312px);
    align-items: center;
    gap: 46px;
  }

  .identity {
    display: grid;
    grid-template-columns: 124px minmax(0, 1fr);
    align-items: center;
    gap: 28px;
  }

  .identity img {
    width: 124px;
    height: 124px;
    border: 1px solid var(--accent-border);
    border-radius: 26px;
    background: linear-gradient(135deg, rgba(255,253,248,.98), var(--accent-bg));
    box-shadow: 0 10px 24px rgba(58,49,38,.06);
  }

  .eyebrow,
  .band-heading > p,
  .section-number {
    margin: 0 0 8px;
    color: #827d72;
    font-size: 13px;
    font-weight: 600;
  }

  h1 {
    margin: 0;
    color: #383631;
    font-size: clamp(50px, 8.6vw, 84px);
    line-height: .98;
    letter-spacing: 0;
  }

  .intro {
    max-width: 560px;
    margin: 16px 0 0;
    color: #5b574f;
    font-size: 18px;
    line-height: 1.55;
  }

  .task-preview {
    display: grid;
    gap: 9px;
    border-left: 1px solid rgba(210,199,184,.22);
    padding: 5px 0 5px 20px;
  }

  .task-row {
    display: grid;
    grid-template-columns: 25px minmax(0, 1fr);
    gap: 11px;
    padding: 6px 0;
  }

  .task-row + .task-row {
    border-top: 1px solid rgba(210,199,184,.18);
  }

  .task-row span {
    width: 19px;
    height: 19px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--accent-border);
    border-radius: 999px;
    background: rgba(255,253,248,.7);
    color: var(--accent-text);
    font-size: 9px;
    font-weight: 650;
  }

  .task-row strong {
    color: #504a41;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
  }

  .hero-description {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0 0 0 152px;
    color: #5b574f;
    font-size: 16px;
    line-height: 1.68;
  }

  .meta-list {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 0 0 152px;
  }

  .meta-pill {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    border: 1px solid var(--accent-border);
    border-radius: 8px;
    padding: 7px 10px;
    background: var(--accent-bg);
  }

  .meta-pill dt {
    color: var(--accent-text);
    font-size: 13px;
  }

  .meta-pill dd {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin: 0;
  }

  .meta-pill dd span {
    border: 1px solid var(--accent-border);
    border-radius: 999px;
    padding: 2px 7px;
    background: color-mix(in srgb, var(--accent-bg) 84%, #fffdf8);
    color: var(--accent-text);
    font-size: 12px;
    font-weight: 620;
  }

  .status-pill dd span {
    border-color: #d4c3df;
    background: #f0e7f5;
    color: #65516f;
  }

  .content-band,
  .split-band,
  .faq-band,
  .support-band {
    border-top: 1px solid #e3dbcf;
    padding: 42px 0;
  }

  .band-heading {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
    margin-bottom: 28px;
  }

  .band-heading h2,
  .split-band h2 {
    margin: 0;
    color: #39352f;
    font-size: clamp(27px, 4vw, 40px);
    font-weight: 640;
    letter-spacing: -.035em;
    line-height: 1.15;
  }

  .mode-grid,
  .split-band {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .mode-grid article,
  .split-band article {
    border: 1px solid var(--accent-border);
    border-radius: 10px;
    padding: 24px;
    background: linear-gradient(145deg, rgba(255,253,248,.94), var(--accent-bg));
  }

  .mode-grid h3 {
    margin: 0;
    color: #3c3832;
    font-size: 20px;
    font-weight: 650;
  }

  .mode-grid p,
  .faq-list p {
    margin: 13px 0 0;
    color: #6a6359;
    font-size: 15px;
    line-height: 1.72;
  }

  .feature-list,
  .split-band ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .feature-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 38px;
  }

  .feature-list li,
  .split-band li {
    position: relative;
    border-bottom: 1px solid #e7dfd3;
    padding: 16px 0 16px 20px;
    color: #585149;
    font-size: 15px;
    line-height: 1.65;
  }

  .feature-list li::before,
  .split-band li::before {
    content: '';
    width: 6px;
    height: 6px;
    position: absolute;
    top: 25px;
    left: 0;
    border-radius: 50%;
    background: var(--accent-border);
  }

  .split-band ul {
    margin-top: 20px;
  }

  .faq-list {
    border-top: 1px solid #dfd7cb;
  }

  .faq-list details {
    border-bottom: 1px solid #dfd7cb;
    padding: 0 4px;
  }

  .faq-list summary {
    padding: 20px 0;
    color: #3f3a34;
    cursor: pointer;
    font-size: 17px;
    font-weight: 640;
  }

  .faq-list p {
    max-width: 760px;
    margin: -3px 0 20px;
  }

  .support-band {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .support-band a {
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #ded6ca;
    border-radius: 8px;
    background: #fffdf8;
    color: #5f5a50;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }

  footer {
    flex-wrap: wrap;
    justify-content: center;
    gap: 9px 20px;
    border-top: 1px solid #dfd7cb;
    padding-top: 28px;
    color: #857d72;
    font-size: 12px;
  }

  @media (max-width: 760px) {
    .page-shell {
      width: min(100% - 30px, 1040px);
      padding-top: 20px;
    }

    .hero {
      min-height: auto;
      padding: 54px 0 38px;
    }

    .hero-grid,
    .mode-grid,
    .feature-list,
    .split-band {
      grid-template-columns: 1fr;
    }

    .identity {
      grid-template-columns: 84px minmax(0, 1fr);
      gap: 18px;
    }

    .identity img {
      width: 84px;
      height: 84px;
      border-radius: 20px;
    }

    .task-preview {
      border-left: 0;
      border-top: 1px solid #e3dbcf;
      padding: 18px 0 0;
    }

    .hero-description,
    .meta-list {
      margin-left: 0;
    }
  }

  @media (max-width: 520px) {
    .topbar {
      align-items: flex-start;
    }

    .nav-actions {
      align-items: flex-end;
      flex-direction: column-reverse;
      gap: 8px;
    }

    h1 {
      font-size: clamp(48px, 16vw, 68px);
    }

    .intro {
      font-size: 16px;
    }

    .band-heading {
      grid-template-columns: 34px minmax(0, 1fr);
      gap: 8px;
    }

    .mode-grid article,
    .split-band article {
      padding: 20px;
    }

    .support-band {
      grid-template-columns: 1fr;
    }
  }
</style>
