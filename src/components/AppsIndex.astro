---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocaleMenu from './LocaleMenu.astro';
import SiteFooter from './SiteFooter.astro';
import { getProductIndexItems, type ProductIndexItem } from '../lib/products';
import {
  contentLocale,
  localeAlternates,
  localeDefinitions,
  productRouteFor,
  routeFor,
  type SiteLocale
} from '../lib/site-i18n';

type Props = {
  locale: SiteLocale;
};

type StatusKind = 'released' | 'preparing';

type AppCard = ProductIndexItem & {
  statusKind: StatusKind;
};

type AppsCopy = {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  intro: string;
  navLabel: string;
  platformsLabel: string;
  searchLabel: string;
  searchPlaceholder: string;
  empty: string;
  status: Record<StatusKind, string>;
};

const copies: Record<SiteLocale, AppsCopy> = {
  en: {
    title: 'ONNELLAB Apps',
    description: 'Browse focused ONNELLAB apps for files, media, and creative work.',
    eyebrow: 'Products',
    heading: 'Apps',
    intro: 'Small tools with clear boundaries. Open a product to see exactly what it does—and what it deliberately leaves out.',
    navLabel: 'Navigation',
    platformsLabel: 'Platforms',
    searchLabel: 'Find an app',
    searchPlaceholder: 'Search app name',
    empty: 'No matching apps.',
    status: { released: 'Released', preparing: 'Preparing for release' }
  },
  ko: {
    title: 'ONNELLAB 앱',
    description: '파일, 미디어와 창작 작업을 위한 ONNELLAB 앱을 살펴봐요.',
    eyebrow: '제품',
    heading: '앱',
    intro: '작지만 경계가 분명한 도구들이에요. 각 제품 페이지에서 무엇을 하고, 무엇을 하지 않는지 정확히 확인해요.',
    navLabel: '탐색',
    platformsLabel: '플랫폼',
    searchLabel: '앱 찾기',
    searchPlaceholder: '앱 이름을 검색해요',
    empty: '일치하는 앱이 없어요.',
    status: { released: '출시됨', preparing: '출시 준비 중' }
  },
  ja: {
    title: 'ONNELLAB アプリ',
    description: 'ファイル、メディア、創作作業のためのONNELLABアプリ一覧です。',
    eyebrow: 'プロダクト',
    heading: 'アプリ',
    intro: '小さく、境界の明確な道具です。各ページで、できることと、あえて行わないことを確認できます。',
    navLabel: 'ナビゲーション',
    platformsLabel: '対応プラットフォーム',
    searchLabel: 'アプリを探す',
    searchPlaceholder: 'アプリ名で検索',
    empty: '該当するアプリはありません。',
    status: { released: '公開済み', preparing: '公開準備中' }
  },
  'zh-Hans': {
    title: 'ONNELLAB 应用',
    description: '浏览用于文件、媒体与创作工作的 ONNELLAB 应用。',
    eyebrow: '产品',
    heading: '应用',
    intro: '小而边界清晰的工具。每个产品页都会说明它能做什么，以及刻意不做什么。',
    navLabel: '导航',
    platformsLabel: '支持平台',
    searchLabel: '查找应用',
    searchPlaceholder: '搜索应用名称',
    empty: '没有匹配的应用。',
    status: { released: '已发布', preparing: '准备发布' }
  },
  'zh-Hant': {
    title: 'ONNELLAB 應用程式',
    description: '瀏覽用於檔案、媒體與創作工作的 ONNELLAB 應用程式。',
    eyebrow: '產品',
    heading: '應用程式',
    intro: '小而邊界清楚的工具。每個產品頁都會說明能做什麼，以及刻意不做什麼。',
    navLabel: '導覽',
    platformsLabel: '支援平台',
    searchLabel: '尋找應用程式',
    searchPlaceholder: '搜尋應用程式名稱',
    empty: '沒有符合的應用程式。',
    status: { released: '已發布', preparing: '準備發布' }
  }
};

const { locale } = Astro.props;
const copy = copies[locale];
const definition = localeDefinitions[locale];
const canonicalPath = routeFor('apps', locale);
const appHref = (slug: string) => productRouteFor(slug, locale);
const statusKind = (value: string): StatusKind =>
  /prepar|coming|soon/i.test(value) ? 'preparing' : 'released';
const existingApps: AppCard[] = getProductIndexItems(contentLocale(locale)).map((app) => {
  const kind = statusKind(app.status);
  return {
    ...app,
    href: appHref(app.slug),
    status: copy.status[kind],
    statusKind: kind
  };
});
const papiraSummary: Record<SiteLocale, string> = {
  en: 'Offline TXT-to-EPUB maker',
  ko: '오프라인 TXT→EPUB 제작 도구',
  ja: 'オフラインTXT→EPUB作成ツール',
  'zh-Hans': '离线 TXT 转 EPUB 制作工具',
  'zh-Hant': '離線 TXT 轉 EPUB 製作工具'
};
const papiraCard: AppCard = {
  slug: 'papira',
  title: 'Papira',
  status: copy.status.preparing,
  statusKind: 'preparing',
  platforms: ['iOS', 'Android'],
  description: papiraSummary[locale],
  iconPath: '/app-assets/papira/icon.png',
  href: routeFor('papira', locale),
  privacy: routeFor('papiraPrivacy', locale),
  hasStoreListing: false,
  accent: { border: '#d7cfdb', background: '#f4eff5', text: '#614f68' }
};
const apps = [papiraCard, ...existingApps].sort((a, b) =>
  a.title.localeCompare(b.title, 'en', { sensitivity: 'base' })
);
const appCardStyle = (app: AppCard) =>
  `--accent-border: ${app.accent.border}; --accent-bg: ${app.accent.background}; --accent-text: ${app.accent.text};`;
const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': new URL(`${canonicalPath}#collection`, Astro.site).toString(),
  name: copy.title,
  description: copy.description,
  url: new URL(canonicalPath, Astro.site).toString(),
  inLanguage: definition.htmlLang,
  isPartOf: { '@id': new URL('/#website', Astro.site).toString() },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: apps.map((app, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: app.title,
      url: new URL(app.href, Astro.site).toString()
    }))
  }
};
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  canonicalPath={canonicalPath}
  lang={definition.htmlLang}
  jsonLd={collectionJsonLd}
  alternates={localeAlternates('apps')}
>
  <main class="page-shell information-shell" data-apps-page data-locale={locale}>
    <nav class="top-nav site-header" aria-label={copy.navLabel}>
      <a class="brand" href={routeFor('home', locale)}>ONNELLAB</a>
      <LocaleMenu locale={locale} page="apps" />
    </nav>

    <header>
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1 class="information-heading">{copy.heading}</h1>
      <p>{copy.intro}</p>
    </header>

    <label class="app-search">
      <span>{copy.searchLabel}</span>
      <input type="search" placeholder={copy.searchPlaceholder} data-app-search />
    </label>

    <p class="empty-state" data-app-empty hidden>{copy.empty}</p>

    <section class="grid" aria-label={copy.heading}>
      {apps.map((app) => (
        <a
          class="app-card"
          href={app.href}
          style={appCardStyle(app)}
          data-app-row
          data-app-title={app.title.toLowerCase()}
          data-status-kind={app.statusKind}
        >
          <img src={app.iconPath} alt="" width="64" height="64" loading="lazy" data-no-visual-search="true" />
          <div class="app-copy">
            <div class="title-row">
              <h2>{app.title}</h2>
              <span class="status-badge" data-status-kind={app.statusKind}>{app.status}</span>
            </div>
            <p>{app.description}</p>
            <div class="platform-badges" aria-label={copy.platformsLabel}>
              {app.platforms.map((platform) => <span>{platform}</span>)}
            </div>
          </div>
        </a>
      ))}
    </section>

    <SiteFooter locale={locale} />

    <script is:inline>
      (() => {
        const appSearch = document.querySelector('[data-app-search]');
        const appRows = Array.from(document.querySelectorAll('[data-app-row]'));
        if (!(appSearch instanceof HTMLInputElement)) return;

        appSearch.addEventListener('input', () => {
          const query = appSearch.value.trim().toLowerCase();
          let visibleCount = 0;
          appRows.forEach((row) => {
            const title = row.getAttribute('data-app-title') ?? '';
            const isHidden = query.length > 0 && !title.includes(query);
            row.hidden = isHidden;
            if (!isHidden) visibleCount += 1;
          });
          const emptyState = document.querySelector('[data-app-empty]');
          if (emptyState instanceof HTMLElement) emptyState.hidden = visibleCount > 0;
        });
      })();
    </script>
  </main>
</BaseLayout>

<style>
  .top-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .brand {
    text-decoration: none;
  }

  header {
    padding: 72px 0 36px;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: #827d72;
    font-size: 12px;
    font-weight: 680;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: #36332f;
  }

  header > p:last-child {
    max-width: 820px;
    margin: 22px 0 0;
    color: #5b574f;
    font-size: 18px;
    line-height: 1.65;
  }

  .app-search {
    display: grid;
    gap: 8px;
    max-width: 360px;
    color: #6f695f;
    font-size: 13px;
    font-weight: 620;
  }

  .app-search input {
    min-height: 44px;
    border: 1px solid #ded6ca;
    border-radius: 8px;
    padding: 9px 12px;
    background: rgba(255, 253, 248, 0.78);
    color: #3f3b35;
    font: inherit;
    font-weight: 500;
  }

  .app-search input:focus {
    border-color: #cfc5b7;
    outline: 2px solid #827d72;
    outline-offset: 3px;
  }

  .empty-state {
    border-top: 1px solid #e0d8cb;
    border-bottom: 1px solid #e0d8cb;
    margin: 18px 0 0;
    padding: 18px 0;
    color: #827d72;
    font-size: 14px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 28px;
  }

  .app-card {
    position: relative;
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr);
    align-items: start;
    gap: 16px;
    min-height: 128px;
    border: 1px solid var(--accent-border, #e0d8cb);
    border-radius: 11px;
    padding: 18px;
    background:
      linear-gradient(135deg, rgba(255, 253, 248, 0.96) 16%, var(--accent-bg, #fffdf8)),
      #fffdf8;
    color: inherit;
    text-decoration: none;
    transition: transform 140ms ease, border-color 140ms ease, background 140ms ease, box-shadow 140ms ease;
  }

  .app-card[hidden] {
    display: none;
  }

  .app-card:hover,
  .app-card:focus-visible {
    border-color: var(--accent-border, #d8cec0);
    background:
      linear-gradient(135deg, #fffdf8 10%, var(--accent-bg, #fffdf8) 92%),
      #fffdf8;
    box-shadow: 0 10px 22px rgba(58, 49, 38, 0.055);
    transform: translateY(-2px);
  }

  .app-card:focus-visible {
    outline: 2px solid #827d72;
    outline-offset: 3px;
  }

  .app-card > img {
    width: 52px;
    height: 52px;
    border-radius: 13px;
    box-shadow: 0 0 0 1px var(--accent-border, #ddd5c8);
  }

  .app-copy {
    min-width: 0;
  }

  .title-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px 10px;
  }

  h2 {
    margin: 0;
    color: #3e3933;
    font-size: 19px;
    line-height: 1.25;
    letter-spacing: 0;
  }

  .status-badge {
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 3px 8px;
    font-size: 11px;
    font-weight: 650;
    line-height: 1.35;
    white-space: nowrap;
  }

  .status-badge[data-status-kind='released'] {
    border-color: #c9d8d2;
    background: #edf5f2;
    color: #49645a;
  }

  .status-badge[data-status-kind='preparing'] {
    border-color: #e1cfc5;
    background: #f9eee8;
    color: #765849;
  }

  .app-copy > p {
    margin: 8px 0 0;
    color: #5f5a50;
    font-size: 14px;
    line-height: 1.55;
  }

  .platform-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 10px;
  }

  .platform-badges span {
    border: 1px solid var(--accent-border, #ddd5c8);
    border-radius: 999px;
    padding: 2px 7px;
    background: color-mix(in srgb, var(--accent-bg, #faf8f5) 80%, #fffdf8);
    color: var(--accent-text, #737067);
    font-size: 11px;
    line-height: 1.4;
  }

  @media (max-width: 680px) {
    header {
      padding: 48px 0 30px;
    }

    header > p:last-child {
      font-size: 16px;
      line-height: 1.62;
    }

    .grid {
      grid-template-columns: 1fr;
      gap: 10px;
      margin-top: 24px;
    }

    .app-card {
      grid-template-columns: 46px minmax(0, 1fr);
      gap: 13px;
      min-height: 0;
      padding: 15px;
    }

    .app-card > img {
      width: 44px;
      height: 44px;
      border-radius: 11px;
    }
  }
</style>
