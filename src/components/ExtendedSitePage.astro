const { locale, page } = Astro.props;
const copy = copyByLocale[locale];
const definition = allLocaleDefinitions[locale];
const canonicalPath = allRouteFor(page, locale);
const productSources = getProductSources();
const statusKind = (status: string) => /prepar|coming|soon/i.test(status) ? 'preparing' : 'released';
const appItems = [
  ...productSources.map((source) => ({
    slug: source.slug,
    title: source.meta.title,
    status: statusKind(source.meta.status) === 'preparing' ? copy.apps.preparing : copy.apps.released,
    platforms: source.meta.platforms,
    description: copy.appSummaries[source.slug] ?? source.meta.title,
    icon: getIconRoutePath(source),
    href: allProductRouteFor(source.slug, locale),
    privacy: allAppPrivacyRouteFor(source.slug, locale)
  })),
  {
    slug: 'papira', title: 'Papira', status: copy.apps.preparing, platforms: ['iOS', 'Android'],
    description: copy.appSummaries.papira, icon: '/app-assets/papira/icon.png',
    href: allRouteFor('papira', locale), privacy: allRouteFor('papiraPrivacy', locale)
  }
].sort((a, b) => a.title.localeCompare(b.title, 'en', { sensitivity: 'base' }));
const featured = appItems.find((item) => item.slug === 'tagweaver');
const timeline = [
  ['2026.03', 'TagWeaver'], ['2026.04', 'Quivra'], ['2026.04', 'VaultXT'],
  ['2026.06', 'ClipNest'], ['2026.06', 'Aligna'], ['2026.07', 'Segra']
];
const title = page === 'home' ? copy.home.seoTitle : page === 'apps' ? copy.apps.seoTitle : page === 'about' ? copy.about.seoTitle : page === 'privacy' ? copy.privacy.seoTitle : copy.terms.seoTitle;
const description = page === 'home' ? copy.home.description : page === 'apps' ? copy.apps.description : page === 'about' ? copy.about.description : page === 'privacy' ? copy.privacy.description : copy.terms.description;
const blogHref = `/blog/${definition.pathSegment}/`;
const email = 'onnellab.app@gmail.com';
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} lang={definition.htmlLang} alternates={allLocaleAlternates(page)} socialImage={page === 'home' ? '/social-card.png' : undefined}>
  <main class="extended-shell" data-core-page={page} data-locale={locale}>
    <nav class="top-nav site-header" aria-label="Navigation">
      <a class="brand" href={allRouteFor('home', locale)}>ONNELLAB</a>
      <div class="nav-links">
        {page !== 'apps' && <a href={allRouteFor('apps', locale)}>{copy.nav.apps}</a>}
        {page !== 'about' && <a href={allRouteFor('about', locale)}>{copy.nav.about}</a>}
        {page !== 'privacy' && <a href={allRouteFor('privacy', locale)}>{copy.nav.privacy}</a>}
        {page !== 'terms' && <a href={allRouteFor('terms', locale)}>{copy.nav.terms}</a>}
        <a href={blogHref}>{copy.nav.blog}</a>
        <LocaleMenu locale={locale} page={page} />
      </div>
    </nav>

    {page === 'home' && (
      <>
        <header class="hero">
          <p class="eyebrow">{copy.home.eyebrow}</p>
          <h1>{copy.home.title}</h1>
          <p class="lede">{copy.home.intro}</p>
        </header>
        {featured && (
          <a class="featured" href={featured.href}>
            <span class="eyebrow">{copy.home.featuredLabel}</span>
            <div class="featured-row"><img src={featured.icon} alt="" width="80" height="80" /><div><h2>{copy.home.featuredTitle}</h2><p>{copy.home.featuredBody}</p></div></div>
          </a>
        )}
        <section class="section">
          <div class="section-head"><h2>{copy.home.appsTitle}</h2><a href={allRouteFor('apps', locale)}>{copy.home.allApps}</a></div>
          <div class="card-grid">{appItems.filter((item) => item.slug !== 'tagweaver').slice(0, 4).map((item) => <a class="card" href={item.href}><h3>{item.title}</h3><p>{item.description}</p></a>)}</div>
        </section>
        <section class="section"><h2>{copy.home.valuesTitle}</h2><div class="card-grid">{copy.home.values.map((item) => <article class="card"><h3>{item.title}</h3><p>{item.body}</p></article>)}</div></section>
      </>
    )}

    {page === 'apps' && (
      <>
        <header class="hero compact"><p class="eyebrow">{copy.apps.eyebrow}</p><h1>{copy.apps.title}</h1><p class="lede">{copy.apps.intro}</p></header>
        <label class="search"><span class="sr-only">{copy.apps.search}</span><input type="search" placeholder={copy.apps.search} data-search /></label>
        <p data-empty hidden>{copy.apps.empty}</p>
        <section class="app-list">{appItems.map((item) => <a class="app-row" href={item.href} data-row data-title={item.title.toLowerCase()}><img src={item.icon} alt="" width="58" height="58" /><div><div class="title-row"><h2>{item.title}</h2><span>{item.status}</span></div><p>{item.description}</p><small>{item.platforms.join(' · ')}</small></div></a>)}</section>
        <script is:inline>{`(()=>{const i=document.querySelector('[data-search]');if(!(i instanceof HTMLInputElement))return;const r=[...document.querySelectorAll('[data-row]')];i.addEventListener('input',()=>{const q=i.value.trim().toLowerCase();let n=0;r.forEach(x=>{const h=q&&!(x.getAttribute('data-title')||'').includes(q);x.hidden=!!h;if(!h)n++});const e=document.querySelector('[data-empty]');if(e instanceof HTMLElement)e.hidden=n>0})})()`}</script>
      </>
    )}

    {page === 'about' && (
      <>
        <header class="hero compact"><p class="eyebrow">{copy.about.eyebrow}</p><h1>{copy.about.title}</h1></header>
        <section class="section prose"><h2>{copy.about.studioTitle}</h2>{copy.about.intro.map((item) => <p>{item}</p>)}</section>
        <section class="section"><h2>{copy.about.principlesTitle}</h2><div class="card-grid">{copy.about.principles.map((item) => <article class="card"><h3>{item.title}</h3><p>{item.body}</p></article>)}</div></section>
        <section class="section"><h2>{copy.about.timelineTitle}</h2><ol class="timeline">{timeline.map(([month, app]) => <li><time>{month}</time><span><strong>{app}</strong> · {copy.about.launch}</span></li>)}</ol><p>{copy.about.closing}</p></section>
      </>
    )}

    {page === 'privacy' && (
      <>
        <header class="hero compact"><p class="eyebrow">{copy.privacy.eyebrow}</p><h1>{copy.privacy.title}</h1><p class="lede">{copy.privacy.intro}</p></header>
        <div class="notice-grid"><section class="card"><h2>{copy.privacy.analyticsTitle}</h2><p>{copy.privacy.analyticsBody}</p></section><section class="card"><h2>{copy.privacy.siteTitle}</h2><p>{copy.privacy.siteBody}</p></section><section class="card"><h2>{copy.privacy.contactTitle}</h2><p>{copy.privacy.contactBody}</p></section></div>
        <label class="search"><span class="sr-only">{copy.privacy.search}</span><input type="search" placeholder={copy.privacy.search} data-search /></label>
        <p data-empty hidden>{copy.privacy.empty}</p>
        <section class="policy-list">{appItems.map((item) => <a class="policy-row" href={item.privacy} data-row data-title={item.title.toLowerCase()}><div><h2>{item.title}</h2><p>{copy.privacy.updated}</p></div><small>{item.platforms.join(' · ')}</small></a>)}</section>
        <script is:inline>{`(()=>{const i=document.querySelector('[data-search]');if(!(i instanceof HTMLInputElement))return;const r=[...document.querySelectorAll('[data-row]')];i.addEventListener('input',()=>{const q=i.value.trim().toLowerCase();let n=0;r.forEach(x=>{const h=q&&!(x.getAttribute('data-title')||'').includes(q);x.hidden=!!h;if(!h)n++});const e=document.querySelector('[data-empty]');if(e instanceof HTMLElement)e.hidden=n>0})})()`}</script>
      </>
    )}

    {page === 'terms' && (
      <>
        <header class="hero compact"><p class="eyebrow">{copy.terms.eyebrow}</p><h1>{copy.terms.title}</h1><p class="lede">{copy.terms.intro}</p><p class="updated">{copy.terms.updated}</p></header>
        <div class="legal">{copy.terms.sections.map((section) => <section><h2>{section.title}</h2>{section.paragraphs.map((p) => <p>{p}</p>)}</section>)}</div>
      </>
    )}

    <footer class="footer"><a href={allRouteFor('privacy', locale)}>{copy.common.privacy}</a><a href={allRouteFor('terms', locale)}>{copy.common.terms}</a><a href={`mailto:${email}`}>{email}</a><span>© ONNELLAB</span></footer>
  </main>
</BaseLayout>

<style>
  .extended-shell{width:min(1080px,calc(100% - 40px));margin:0 auto;padding:26px 0 54px;color:#3f3b35}.top-nav,.nav-links,.section-head,.featured-row,.title-row,.policy-row,.app-row,.footer{display:flex;align-items:center}.top-nav,.section-head,.policy-row{justify-content:space-between}.nav-links{gap:16px;flex-wrap:wrap}.brand,.nav-links>a,.section-head>a,.footer a{color:#686259;text-decoration:none;font-size:13px;font-weight:620}.hero{padding:clamp(82px,12vw,150px) 0 clamp(54px,8vw,88px)}.hero.compact{padding-bottom:44px}.eyebrow{margin:0 0 14px;color:#786f65;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}h1{max-width:950px;margin:0;color:#37332e;font-size:clamp(46px,8vw,88px);line-height:1.02;letter-spacing:-.045em}.compact h1{font-size:clamp(42px,7vw,72px)}.lede{max-width:900px;margin:24px 0 0;white-space:pre-line;color:#6a6359;font-size:18px;line-height:1.72}.featured,.card,.app-row,.policy-row{border:1px solid #ded6ca;border-radius:12px;background:#fffdf8;color:inherit;text-decoration:none}.featured{display:grid;gap:16px;padding:24px}.featured-row{gap:20px}.featured h2,.card h3,.app-row h2,.policy-row h2{margin:0;color:#37332e}.featured p,.card p,.app-row p,.policy-row p{color:#6a6359;line-height:1.6}.section{margin-top:58px}.section h2{font-size:27px}.section-head{margin-bottom:18px}.card-grid,.notice-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.card{padding:20px}.app-list,.policy-list,.legal{display:grid;gap:12px}.app-row{gap:18px;padding:18px}.app-row>div{min-width:0;flex:1}.title-row{justify-content:space-between;gap:12px}.title-row span,.app-row small,.policy-row small{color:#817a70;font-size:12px}.search{display:block;margin:0 0 22px}.search input{width:min(100%,420px);border:1px solid #ded6ca;border-radius:10px;padding:12px 14px;background:#fffdf8;font:inherit}.policy-row{padding:18px 20px}.prose{max-width:800px}.prose p,.legal p{color:#5f5a52;line-height:1.75}.timeline{display:grid;gap:10px;padding:0;list-style:none}.timeline li{display:grid;grid-template-columns:90px 1fr;gap:18px;border-top:1px solid #e5ded4;padding:13px 0}.updated{color:#817a70;font-size:14px}.legal section{border-top:1px solid #e5ded4;padding:22px 0}.footer{justify-content:center;flex-wrap:wrap;gap:10px 20px;margin-top:64px;border-top:1px solid #ded6ca;padding-top:28px;color:#786f65;font-size:12px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(max-width:760px){.nav-links{gap:10px}.nav-links>a{display:none}.card-grid,.notice-grid{grid-template-columns:1fr}.hero{padding-top:70px}.featured-row{align-items:flex-start}.policy-row{align-items:flex-start;gap:14px}.app-row{align-items:flex-start}}
</style>
