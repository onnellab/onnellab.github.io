    about: { seoTitle: 'Acerca de ONNELLAB', description: 'ONNELLAB es un estudio de software independiente de Corea que crea utilidades tranquilas y enfocadas.', eyebrow: 'Estudio de software independiente', title: 'Acerca de ONNELLAB', studioTitle: 'Estudio', intro: ['ONNELLAB crea herramientas tranquilas y enfocadas para archivos, contenido multimedia, trabajo creativo y tareas cotidianas.', 'Cada producto empieza con una tarea clara. Evitamos acumular funciones, exigir cuentas innecesarias y crear interfaces que pidan más atención que el propio trabajo.', 'Siempre que el producto lo permite, los archivos permanecen en el dispositivo y el acceso se limita a lo que el usuario elige expresamente.'], principlesTitle: 'Principios', principles: [{ title: 'Enfocado', body: 'Una herramienta debe poder explicar su propósito en una frase y detenerse antes de convertirse en una plataforma.' }, { title: 'Tranquilo', body: 'El diseño debe apoyar la tarea en lugar de competir por la atención.' }, { title: 'Respetuoso', body: 'Los usuarios deben mantener el control de sus archivos, decisiones y atención.' }], timelineTitle: 'Cronología', launch: 'lanzamiento', closing: 'ONNELLAB sigue creando herramientas pequeñas pensadas para durar.' },
    privacy: { seoTitle: 'Políticas de privacidad de ONNELLAB', description: 'Políticas de privacidad de las apps de ONNELLAB.', eyebrow: 'Información legal', title: 'Políticas de privacidad', intro: 'Elige una app para leer la política que corresponde a su flujo de datos real y a las funciones de la plataforma.', search: 'Buscar app', empty: 'No hay apps que coincidan.', updated: 'Fecha de la política', analyticsTitle: 'Analítica del sitio web', analyticsBody: 'Cuando Google Analytics está configurado, el sitio web de ONNELLAB puede medir eventos agregados como visitas a páginas, cambios de idioma, clics hacia las tiendas y aperturas de capturas de pantalla para mejorar el sitio. No recopila el contenido de archivos de las apps, valores de etiquetas ni información de cuentas.', siteTitle: 'Privacidad del sitio web de ONNELLAB', siteBody: 'Este sitio web ofrece contenido original de ONNELLAB e información de productos. Las API externas de publicación se usan solo para contenido aprobado de ONNELLAB y cuentas controladas por ONNELLAB. No vendemos ni analizamos datos sociales privados de otros usuarios.', contactTitle: 'Contacto', contactBody: 'Para consultas sobre privacidad: onnellab.app@gmail.com.' },
    terms: { seoTitle: 'Términos de uso de ONNELLAB', description: 'Términos generales para las apps y sitios web de ONNELLAB.', eyebrow: 'Información legal', title: 'Términos de uso', intro: 'Estos términos generales se aplican a las apps y sitios web de ONNELLAB salvo que la página del producto o la ficha de la tienda indique una regla más específica.', updated: 'Última actualización: 2026-08-21', sections: [{ title: '1. Uso de los productos de ONNELLAB', paragraphs: ['Usa cada producto de forma legal y de acuerdo con su ficha en la tienda, los avisos dentro de la app y las reglas de la plataforma. No intentes interrumpir un servicio, realizar ingeniería inversa con fines abusivos ni usar indebidamente datos de otra persona.'] }, { title: '2. Tus archivos y contenido', paragraphs: ['Sigues siendo responsable de los archivos, manuscritos, contenido multimedia y demás materiales que elijas procesar. ONNELLAB no reclama la propiedad del contenido de los usuarios. Asegúrate de tener los derechos necesarios para usar y exportar el material.'] }, { title: '3. Compras y reembolsos', paragraphs: ['Las descargas, compras, suscripciones, reembolsos y restauraciones de compras las procesa la tienda de aplicaciones correspondiente según sus propios términos. Los precios y derechos específicos de cada producto se muestran en la tienda o en la app.'] }, { title: '4. Servicios externos', paragraphs: ['Cuando un producto abre o comparte datos con otra app, sitio web, proveedor de almacenamiento o plataforma, se aplican los términos y la política de privacidad del destino. ONNELLAB no se hace responsable de servicios de terceros que estén fuera de su control.'] }, { title: '5. Disponibilidad y cambios', paragraphs: ['Podemos actualizar los productos para corregir fallos, mantener la compatibilidad, cumplir requisitos legales o de las tiendas y mejorar la experiencia. Algunas funciones pueden variar entre plataformas cuando lo exijan las reglas del sistema operativo.'] }, { title: '6. Contacto', paragraphs: ['Las consultas sobre estos términos pueden enviarse a onnellab.app@gmail.com.'] }] },
    common: { platforms: 'Plataformas', privacy: 'Política de privacidad', terms: 'Términos' },
    appSummaries: { aligna: 'Renombrador de archivos por lotes con vista previa', clipnest: 'Portapapeles local y textos reutilizables', melivra: 'Reproductor sin conexión para biblioteca de audio local', meriq: 'Preparación de archivos de producción para merchandising', quivra: 'Conversor multimedia sencillo y sin anuncios', segra: 'Herramienta local para cortar y unir audio', tagweaver: 'Editor sin conexión de etiquetas MP3 y FLAC', vaultxt: 'Editor ligero para archivos TXT grandes', papira: 'Creador sin conexión de TXT a EPUB' }
  }
