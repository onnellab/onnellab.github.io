---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocaleMenu from './LocaleMenu.astro';
import {
  localeAlternates,
  localeDefinitions,
  routeFor,
  type SiteLocale
} from '../lib/site-i18n';

type Props = {
  locale: SiteLocale;
};

type PolicySection = {
  title: string;
  paragraphs?: string[];
  items?: string[];
};

type PolicyCopy = {
  title: string;
  description: string;
  intro: string;
  updatedLabel: string;
  updatedValue: string;
  heading: string;
  opening: string;
  sections: PolicySection[];
  homeLabel: string;
  privacyHubLabel: string;
};

const policies: Record<SiteLocale, PolicyCopy> = {
