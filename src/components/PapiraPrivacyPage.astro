---
import BaseLayout from '../layouts/BaseLayout.astro';
import { papiraPrivacyCopies } from '../lib/papira-privacy-copy';
import { uiLabels } from '../lib/ui-labels';
import LocaleMenu from './LocaleMenu.astro';
import SiteFooter from './SiteFooter.astro';
import {
  papiraPrivacyLocaleAlternates,
  papiraPrivacyLocaleDefinitions,
  papiraPrivacyRouteFor,
  isSiteLocale,
  routeFor,
  type PapiraPrivacyLocale
} from '../lib/site-i18n';

type Props = {
  locale: PapiraPrivacyLocale;
};

const { locale } = Astro.props;
const text = papiraPrivacyCopies[locale];
const definition = papiraPrivacyLocaleDefinitions[locale];
const canonicalPath = papiraPrivacyRouteFor(locale);
const relatedLocale = isSiteLocale(locale) ? locale : 'en';
const email = 'onnellab.app@gmail.com';
const emailParts = (value: string) => {
  const index = value.indexOf(email);
  if (index < 0) return { before: value, after: '' };
  return {
    before: value.slice(0, index),
    after: value.slice(index + email.length)
  };
};
---

<BaseLayout
  title={text.title}
  description={text.description}
  canonicalPath={canonicalPath}
  lang={definition.htmlLang}
  alternates={papiraPrivacyLocaleAlternates()}
>
  <main class="legal-shell" data-papira-privacy data-locale={locale}>
    <nav class="topbar site-header" aria-label={uiLabels[locale].navigation}>
      <a class="brand home-link" href={routeFor('home', relatedLocale)}>{text.homeLabel}</a>
      <div class="topbar-actions">
        <a class="hub-link" href={routeFor('privacy', relatedLocale)}>{text.privacyHubLabel}</a>
        <LocaleMenu locale={locale} page="papiraPrivacy" />
      </div>
    </nav>

    <h1>{text.title}</h1>
    <p class="intro">{text.intro}</p>
    <p class="updated"><strong>{text.updatedLabel}:</strong> {text.updatedValue}</p>
    <hr />
    <h2>{text.heading}</h2>
    <p>{text.opening}</p>

    {text.sections.map((section) => (
      <section>
        <h3>{section.title}</h3>
        {section.paragraphs?.map((paragraph) => {
          const parts = emailParts(paragraph);
          return paragraph.includes(email) ? (
            <p>{parts.before}<a href={`mailto:${email}`}>{email}</a>{parts.after}</p>
          ) : (
            <p>{paragraph}</p>
          );
        })}
        {section.items && (
          <ul>
            {section.items.map((item) => <li>{item}</li>)}
          </ul>
        )}
      </section>
    ))}
    <SiteFooter locale={relatedLocale} privacyHref={routeFor('privacy', relatedLocale)} />
  </main>
</BaseLayout>

<style>
  .legal-shell {
    max-width: 840px;
    margin: 0 auto;
    padding: 42px 28px 88px;
    color: #3e3e3e;
    font-size: 16px;
    line-height: 1.76;
  }

  .topbar,
  .topbar-actions {
    display: flex;
    align-items: center;
  }

  .topbar {
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 54px;
  }

  .topbar-actions {
    gap: 14px;
  }

  .home-link,
  .hub-link {
    color: #686259;
    text-decoration: none;
  }

  .hub-link {
    font-size: 13px;
    font-weight: 620;
  }

  .home-link:hover,
  .hub-link:hover {
    color: #32302c;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  h1 {
    margin: 0 0 14px;
    color: #36332f;
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 720;
    letter-spacing: -0.035em;
    line-height: 1.08;
  }

  h2 {
    margin: 0 0 18px;
    color: #393631;
    font-size: 1.5rem;
    font-weight: 690;
  }

  h3 {
    margin: 38px 0 12px;
    color: #403c37;
    font-size: 1.08rem;
    font-weight: 680;
    line-height: 1.4;
  }

  p {
    margin: 0 0 14px;
  }

  .intro {
    max-width: 650px;
    color: #746d64;
    font-size: 1.04rem;
  }

  .updated {
    color: #746d64;
    font-size: 0.92rem;
  }

  ul {
    margin: 0 0 18px;
    padding-left: 1.28rem;
  }

  li {
    margin: 8px 0;
  }

  hr {
    margin: 42px 0;
    border: 0;
    border-top: 1px solid #ded7cd;
  }

  a {
    color: #3d5f82;
    text-decoration-color: rgba(61, 95, 130, 0.36);
    text-underline-offset: 0.18em;
  }

  a:hover {
    text-decoration-color: currentColor;
  }

  @media (max-width: 640px) {
    .legal-shell {
      padding: 26px 20px 64px;
      font-size: 15px;
    }

    .topbar {
      margin-bottom: 42px;
    }

    .topbar-actions {
      align-items: flex-end;
      flex-direction: column-reverse;
      gap: 8px;
    }

    h3 {
      margin-top: 32px;
    }

    hr {
      margin: 34px 0;
    }
  }
</style>
