const { locale } = Astro.props;
const text = policies[locale];
const definition = papiraPrivacyLocaleDefinitions[locale];
const canonicalPath = papiraPrivacyRouteFor(locale);
const relatedLocale = isSiteLocale(locale) ? locale : 'en';
const email = 'onnellab.app@gmail.com';
const emailParts = (value: string) => {
  const index = value.indexOf(email);
  if (index < 0) return { before: value, after: '' };
  return {
    before: value.slice(0, index),
    after: value.slice(index + email.length)
  };
};
---

<BaseLayout
  title={text.title}
  description={text.description}
  canonicalPath={canonicalPath}
  lang={definition.htmlLang}
  alternates={papiraPrivacyLocaleAlternates()}
>
  <main class="legal-shell" data-papira-privacy data-locale={locale}>
    <nav class="topbar site-header" aria-label={uiLabels[locale].navigation}>
      <a class="brand home-link" href={routeFor('home', relatedLocale)}>{text.homeLabel}</a>
      <div class="topbar-actions">
        <a class="hub-link" href={routeFor('privacy', relatedLocale)}>{text.privacyHubLabel}</a>
        <LocaleMenu locale={locale} page="papiraPrivacy" />
      </div>
    </nav>

    <h1>{text.title}</h1>
    <p class="intro">{text.intro}</p>
    <p class="updated"><strong>{text.updatedLabel}:</strong> {text.updatedValue}</p>
    <hr />
    <h2>{text.heading}</h2>
    <p>{text.opening}</p>

    {text.sections.map((section) => (
      <section>
        <h3>{section.title}</h3>
        {section.paragraphs?.map((paragraph) => {
          const parts = emailParts(paragraph);
          return paragraph.includes(email) ? (
            <p>{parts.before}<a href={`mailto:${email}`}>{email}</a>{parts.after}</p>
          ) : (
            <p>{paragraph}</p>
          );
        })}
        {section.items && (
          <ul>
            {section.items.map((item) => <li>{item}</li>)}
          </ul>
        )}
      </section>
    ))}
    <SiteFooter locale={relatedLocale} privacyHref={routeFor('privacy', relatedLocale)} />
  </main>
</BaseLayout>

