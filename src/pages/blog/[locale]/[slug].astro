---
import BlogArticle from '../../../components/BlogArticle.astro';
import { translatedPrivacyLocales } from '../../../lib/app-privacy-localizations';
import { allLocaleDefinitions, type AllSiteLocale } from '../../../lib/extended-site-i18n';
import { getBlogPosts, type BlogPost } from '../../../lib/blog';

export function getStaticPaths() {
  return translatedPrivacyLocales.flatMap((locale) =>
    getBlogPosts(locale).map((post) => ({
      params: { locale: allLocaleDefinitions[locale].pathSegment, slug: post.meta.slug },
      props: { post, locale }
    }))
  );
}
const { post, locale } = Astro.props as { post: BlogPost; locale: AllSiteLocale };
---
<BlogArticle locale={locale} post={post} />
