---
import BlogIndex from '../../../components/BlogIndex.astro';
import { translatedPrivacyLocales } from '../../../lib/app-privacy-localizations';
import { allLocaleDefinitions, type AllSiteLocale } from '../../../lib/extended-site-i18n';

export function getStaticPaths() {
  return translatedPrivacyLocales.map((locale) => ({
    params: { locale: allLocaleDefinitions[locale].pathSegment },
    props: { locale }
  }));
}
const { locale } = Astro.props as { locale: AllSiteLocale };
---
<BlogIndex locale={locale} />
