---
import LocalizedAppPrivacyPage from '../../../../components/LocalizedAppPrivacyPage.astro';
import {
  allPrivacyAppSlugs,
  type AllPrivacyAppSlug
} from '../../../../lib/privacy-policy-documents';
import { allLocaleDefinitions, allSiteLocales, type AllSiteLocale } from '../../../../lib/extended-site-i18n';

export function getStaticPaths() {
  return allPrivacyAppSlugs.flatMap((app) =>
    allSiteLocales.filter((locale) => locale !== 'en').map((locale) => ({
      params: { app, locale: allLocaleDefinitions[locale].pathSegment },
      props: { app, locale }
    }))
  );
}

const { app, locale } = Astro.props as {
  app: AllPrivacyAppSlug;
  locale: AllSiteLocale;
};
---

<LocalizedAppPrivacyPage slug={app} locale={locale} />
