---
import PastenelMoved from '../../../components/PastenelMoved.astro';
import LocalizedAppPrivacyPage from '../../../components/LocalizedAppPrivacyPage.astro';
import {
  allPrivacyAppSlugs,
  type AllPrivacyAppSlug
} from '../../../lib/privacy-policy-documents';

export function getStaticPaths() {
  return [
    ...allPrivacyAppSlugs.map((app) => ({ params: { app }, props: { app } })),
    { params: { app: 'pastenel' }, props: { app: 'clipnest' as const } }
  ];
}
const { app } = Astro.props as { app: AllPrivacyAppSlug };
---
{Astro.params.app === 'clipnest' ? <PastenelMoved family="privacy" locale="en" /> : <LocalizedAppPrivacyPage slug={app} locale="en" />}
