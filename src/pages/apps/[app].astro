---
import PastenelMoved from '../../components/PastenelMoved.astro';
import ProductTemplate from '../../components/ProductTemplate.astro';
import { getProductPageData, getProductSources } from '../../lib/products';

export function getStaticPaths() {
  return getProductSources().map((source) => ({
    params: { app: source.slug }
  }));
}

const app = Astro.params.app as string;
const data = getProductPageData(app, 'en');
---

{app === 'clipnest' ? <PastenelMoved family="product" locale="en" /> : <ProductTemplate data={data} />}
