---
import pins from '../../data/ondo-paper-pins.json';

const homeUrl = 'https://onnellab.com/ondo-paper/';
const previewPath = '/ondo-paper/previews';
const sampleUrl = 'https://akinstun.gumroad.com/l/midweek-reset-sample';

const planners = [
  {
    slug: 'cozy-undated-planner',
    title: 'Cozy Undated Planner',
    details: 'Undated · English PDF · 105 pages',
    description: 'Choose a month to begin, then tap into the week you want to plan.',
    image: 'cozy-undated-planner',
    alt: 'A month overview beside a weekly page with handwritten plans.',
    width: 960,
    height: 545,
  },
  {
    slug: '2027-cozy-digital-calendar',
    title: '2027 Cozy Digital Calendar',
    details: 'Sunday start · PDF · 12 monthly pages',
    description: 'Keep plans and US federal holidays, including observed dates, in the same monthly view.',
    image: '2027-digital-calendar',
    alt: 'A January 2027 calendar page with month tabs and space for notes.',
    width: 625,
    height: 717,
  },
];

const stickers = [
  { slug: 'cozy-winter-stickers', title: 'Cozy Winter', alt: 'Snowman, gingerbread person, and penguin stickers.' },
  { slug: 'cozy-study-desk-stickers', title: 'Cozy Study & Desk', alt: 'Book, pencil, and desk lamp stickers.' },
  { slug: 'cozy-cafe-stickers', title: 'Cozy Café & Bakery', alt: 'Bagel, moka pot, and teacup stickers.' },
  { slug: 'film-frame-masking-tape-deco-stickers', title: 'Film Frames & Tape', alt: 'Film frame, striped tape, and dotted tape stickers.' },
  { slug: 'hachana-squad-stickers', title: 'Hachana Squad', alt: 'Cat, capybara, and rabbit stickers.' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="p:domain_verify" content="92a3758bc73810d2cacbdbcd9ae0bd0c" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ONDO PAPER | Digital planners, calendars & stickers</title>
    <meta name="description" content="Shop ONDO PAPER's digital planners, calendars, and stickers. Try The Midweek Reset, a free two-page weekly planner with a filled example." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="ONDO PAPER | Digital planners, calendars & stickers" />
    <meta property="og:description" content="Try The Midweek Reset, a free two-page weekly planner with a filled example." />
    <meta property="og:image" content={`${homeUrl}previews/midweek-reset-filled.webp`} />
    <meta property="og:image:alt" content="The Midweek Reset weekly planner with a filled Thursday example." />
    <link rel="canonical" href={homeUrl} />
    <link rel="alternate" type="application/rss+xml" href="/ondo-paper/pinterest.xml" title="ONDO PAPER RSS" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header shell">
      <a class="wordmark" href="/ondo-paper/">ONDO <span>PAPER</span></a>
      <nav aria-label="Main navigation">
        <a href="#collection">Shop</a>
        <a href="#design-notes">Design notes</a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <section class="hero shell" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Digital stationery</p>
          <h1 id="hero-title">A little room<br class="hero-break" /> to plan.</h1>
          <p class="hero-lede">Digital planners, calendars, and stickers for the weeks that go to plan and the ones that change halfway through.</p>
          <a class="button" href={sampleUrl}>Try a free planner <span aria-hidden="true">↗</span></a>
          <p class="download-note">The Midweek Reset · 2-page PDF on Gumroad</p>
        </div>
        <figure class="hero-preview">
          <div class="hero-stage">
            <img
              src={`${previewPath}/midweek-reset-filled.webp`}
              alt="The Midweek Reset filled in on Thursday, with the missed days left blank and one task moved to Friday."
              width="720"
              height="960"
              fetchpriority="high"
            />
          </div>
          <figcaption>
            <span>The Midweek Reset · Filled example</span>
            <a href={`${previewPath}/midweek-reset-filled.webp`}>Open full-size preview <span aria-hidden="true">↗</span></a>
          </figcaption>
        </figure>
      </section>

      <section class="collection shell" id="collection" aria-labelledby="collection-title">
        <div class="section-heading">
          <h2 id="collection-title">Planners &amp; calendars</h2>
          <p>Start whenever you like, or see the whole year ahead.</p>
        </div>
        <div class="planner-grid">
          {planners.map((planner) => {
            const productUrl = pins.find((pin) => pin.slug === planner.slug)?.productUrl;
            if (!productUrl) throw new Error(`ONDO PAPER product missing from the catalog: ${planner.slug}`);
            return (
              <article class="product">
                <div class="product-preview">
                  <img
                    src={`${previewPath}/${planner.image}.webp`}
                    alt={planner.alt}
                    width={planner.width}
                    height={planner.height}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <p class="product-details">{planner.details}</p>
                <h3>{planner.title}</h3>
                <p class="product-description">{planner.description}</p>
                <a class="text-link" href={productUrl} aria-label={`View ${planner.title} on Gumroad`}>
                  View on Gumroad <span aria-hidden="true">↗</span>
                </a>
              </article>
            );
          })}
        </div>
        <section class="sticker-collection" aria-labelledby="sticker-title">
          <div class="section-heading">
            <h3 id="sticker-title">Digital stickers</h3>
            <p>PNG sticker packs for your planner or journal.</p>
          </div>
          <ul class="sticker-grid">
            {stickers.map((sticker) => (
              <li>
                <a href={`https://akinstun.gumroad.com/l/${sticker.slug}`}>
                  <img
                    src={`${previewPath}/${sticker.slug}.webp`}
                    alt={sticker.alt}
                    width="590"
                    height="187"
                    loading="lazy"
                    decoding="async"
                  />
                  <span>{sticker.title} <span aria-hidden="true">↗</span></span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      </section>

      <section class="design-notes" id="design-notes" aria-labelledby="design-title">
        <div class="notes-inner shell">
          <div class="notes-copy">
            <p class="eyebrow">Design notes</p>
            <h2 id="design-title">What if you open your planner on Thursday?</h2>
            <p>That question shaped The Midweek Reset.</p>
            <dl>
              <div>
                <dt>Start with three commitments.</dt>
                <dd>A short list helps you see what still matters before filling in the days.</dd>
              </div>
              <div>
                <dt>Let missed days stay blank.</dt>
                <dd>Use the space ahead of you without having to reconstruct the first half of the week.</dd>
              </div>
              <div>
                <dt>Keep one thing and drop one.</dt>
                <dd>Changing your plan is easier when you can see both decisions in writing.</dd>
              </div>
            </dl>
          </div>
          <figure class="blank-preview">
            <img
              src={`${previewPath}/midweek-reset-blank.webp`}
              alt="The blank weekly planner with three commitment lines and prompts to keep one thing and drop one."
              width="720"
              height="960"
              loading="lazy"
              decoding="async"
            />
            <figcaption><a href={sampleUrl}>Get the blank page and filled example <span aria-hidden="true">↗</span></a></figcaption>
          </figure>
        </div>
      </section>
    </main>
    <footer class="site-footer shell">
      <a class="wordmark" href="/ondo-paper/">ONDO <span>PAPER</span></a>
      <nav aria-label="Footer navigation">
        <a href="https://www.pinterest.com/akinstun21/digital-planner-2027-goodnotes-stickers/">Find us on Pinterest</a>
        <a href="/">A stationery line by ONNELLAB</a>
      </nav>
    </footer>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --paper: #f8f4ec;
    --ink: #322921;
    --muted: #62564b;
    --rule: #dacdbc;
    --rust: #824330;
    --rust-dark: #663221;
    --display: Georgia, "Times New Roman", serif;
  }

  *, *::before, *::after { box-sizing: border-box; }
  body { margin: 0; background: var(--paper); color: var(--ink); font: 1rem/1.55 system-ui, sans-serif; }
  a { color: var(--rust); text-underline-offset: .2em; }
  a:hover { color: var(--rust-dark); }
  a:focus-visible { outline: 3px solid var(--rust); outline-offset: 4px; }
  img { display: block; max-width: 100%; height: auto; }
  figure, h1, h2, h3, p, dl, dd { margin: 0; }
  h1, h2, h3 { font-family: var(--display); font-weight: 400; line-height: 1.06; overflow-wrap: anywhere; }
  h2 { font-size: clamp(2rem, 5vw, 3.5rem); letter-spacing: -.035em; }
  h3 { font-size: clamp(1.55rem, 3vw, 2.1rem); letter-spacing: -.025em; }

  .skip {
    position: absolute;
    top: 0;
    left: 1rem;
    z-index: 1;
    padding: .65rem 1rem;
    background: var(--paper);
    transform: translateY(-130%);
  }
  .skip:focus { transform: translateY(.75rem); }
  .shell { width: min(75rem, calc(100% - clamp(2rem, 8vw, 8rem))); margin-inline: auto; }
  .site-header, .site-footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .5rem 1.5rem; }
  .site-header { border-bottom: 1px solid var(--rule); padding-block: .9rem; }
  .wordmark {
    display: block;
    min-height: 44px;
    padding-block: .65rem;
    max-width: 100%;
    color: var(--ink);
    font: 700 1.15rem/1.1 var(--display);
    letter-spacing: .09em;
    overflow-wrap: anywhere;
    text-decoration: none;
  }
  .wordmark span { color: var(--rust); }
  nav { display: flex; flex-wrap: wrap; gap: 0 clamp(.8rem, 3vw, 2rem); }
  nav a, figcaption a, .text-link {
    display: inline-flex;
    align-items: center;
    gap: .32em;
    min-height: 44px;
    font-weight: 600;
  }
  nav a { color: var(--ink); text-decoration: none; }
  nav a:hover { text-decoration: underline; }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    padding-block: clamp(2.5rem, 6vw, 5.6rem) clamp(2.7rem, 7vw, 6rem);
  }
  .eyebrow { color: var(--rust); font-size: .74rem; font-weight: 750; letter-spacing: .14em; text-transform: uppercase; }
  .hero h1 { margin-block: .17em .28em; font-size: clamp(3.15rem, 7.65vw, 7.4rem); letter-spacing: -.062em; line-height: .92; }
  .hero-lede { max-width: 34ch; color: var(--muted); font-size: clamp(1rem, 1.6vw, 1.22rem); }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: .6em 1.6em;
    min-height: 50px;
    margin-top: 1.55rem;
    padding: .65rem 1.08rem;
    border-radius: .28rem;
    background: var(--rust);
    color: white;
    font-weight: 700;
    text-decoration: none;
  }
  .button:hover { background: var(--rust-dark); color: white; }
  .download-note { margin-top: .65rem; color: var(--muted); font-size: .85rem; }
  .hero-stage { display: grid; place-items: center; padding: clamp(1.2rem, 3vw, 2.8rem); background: #ded3bf; border: 1px solid #d8c9b0; border-radius: .7rem; }
  .hero-stage img { width: min(100%, 23.25rem); border: 1px solid #e5dacf; box-shadow: 0 .65rem 1.6rem #49352330; }
  figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0 1rem;
    padding-top: .32rem;
    color: var(--muted);
    font-size: .85rem;
  }

  #collection, #design-notes { scroll-margin-top: 1rem; }
  .collection { border-top: 1px solid var(--rule); padding-block: clamp(2rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem); }
  .section-heading { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: .6rem 1.75rem; margin-bottom: 1.6rem; }
  .section-heading p, .product-description { color: var(--muted); }
  .planner-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.1rem, 3vw, 2rem); }
  .product { display: grid; grid-template-rows: auto auto auto 1fr auto; }
  .product-preview { display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); height: clamp(14rem, 26vw, 23rem); padding: clamp(.7rem, 2vw, 1.5rem); background: #eae0d2; border: 1px solid var(--rule); border-radius: .5rem; }
  .product-preview img { width: 100%; height: 100%; object-fit: contain; }
  .product-details { margin-block: .95rem .35rem; color: var(--rust); font-size: .85rem; font-weight: 700; }
  .product-description { margin-top: .55rem; max-width: 46ch; }
  .text-link { justify-self: start; margin-top: .25rem; }

  .sticker-collection { margin-top: clamp(2.4rem, 6vw, 4.6rem); }
  .sticker-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr)); gap: 1rem; padding: 0; margin: 0; list-style: none; }
  .sticker-grid a { display: flex; flex-direction: column; height: 100%; border: 1px solid var(--rule); border-radius: .45rem; background: #fbf8f2; font-size: .92rem; font-weight: 650; }
  .sticker-grid a > span { display: flex; align-items: center; justify-content: space-between; gap: .6rem; flex: 1; padding: .5rem .65rem; min-height: 44px; }
  .sticker-grid img { width: 100%; border-radius: .4rem .4rem 0 0; border-bottom: 1px solid var(--rule); }

  .design-notes { background: #eae2d4; border-block: 1px solid var(--rule); }
  .notes-inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .78fr); gap: clamp(1.8rem, 6vw, 7rem); align-items: center; padding-block: clamp(2.5rem, 7vw, 5rem); }
  .notes-copy h2 { max-width: 17ch; margin-block: .35rem .65rem; }
  .notes-copy > p:not(.eyebrow), dd { color: var(--muted); }
  dl { margin-top: 1.35rem; }
  dl > div { border-top: 1px solid #d3c5b2; padding-block: .75rem; }
  dt { color: var(--ink); font-weight: 700; }
  .blank-preview { max-width: 22rem; margin-inline: auto; }
  .blank-preview img { box-shadow: 0 .45rem 1.4rem #49352324; }
  .blank-preview figcaption { justify-content: center; text-align: center; }
  .site-footer { padding-block: clamp(1.15rem, 4vw, 2.5rem); }
  .site-footer nav a { color: var(--muted); font-size: .88rem; }

  @media (max-width: 48rem) {
    .hero, .notes-inner { grid-template-columns: minmax(0, 1fr); }
    .hero { gap: 1.6rem; }
    .hero-break { display: none; }
    .hero h1 { font-size: clamp(2.9rem, 10vw, 5rem); }
  }

  @media (max-width: 34rem) {
    .planner-grid { grid-template-columns: minmax(0, 1fr); gap: 1.8rem; }
    .hero-preview figcaption { row-gap: .14rem; }
    .hero-preview figcaption > span { margin-top: .45rem; }
    .site-footer nav { column-gap: 1rem; }
  }
</style>
