---
type Props = {
  title: string;
  description: string;
  canonicalPath: string;
  lang?: string;
  image?: string;
  socialImage?: string;
  favicon?: string;
  ogType?: string;
  articleMeta?: {
    publishedTime?: string;
    modifiedTime?: string;
    section?: string;
    tags?: string[];
  };
  jsonLd?: unknown | unknown[];
  alternates?: Array<{ lang: string; path: string }>;
};

const {
  title,
  description,
  canonicalPath,
  lang = 'en',
  image,
  socialImage,
  favicon,
  ogType = 'website',
  articleMeta,
  jsonLd,
  alternates = []
} = Astro.props;
const canonicalUrl = new URL(canonicalPath, Astro.site);
const imageUrl = socialImage || image ? new URL(socialImage || image || '', Astro.site) : undefined;
const twitterCard = imageUrl ? 'summary_large_image' : 'summary';
const faviconVersion = '20260713-ol-classic-v2';
const customFaviconPath = favicon || image;
const customFaviconUrl = customFaviconPath ? new URL(customFaviconPath, Astro.site) : undefined;
const jsonLdItems = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim();
const gaScript = gaMeasurementId
  ? `
    window.dataLayer = window.dataLayer || [];
    function gtag(){window.dataLayer.push(arguments);}
    window.gtag = window.gtag || gtag;
    gtag('js', new Date());
    gtag('config', ${JSON.stringify(gaMeasurementId)}, {
      anonymize_ip: true,
      send_page_view: true
    });
    window.onnelTrack = (eventName, params = {}) => {
      if (!eventName || typeof window.gtag !== 'function') return;
      window.gtag('event', eventName, {
        transport_type: 'beacon',
        ...params
      });
    };
  `
  : '';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        if (window.location.pathname !== '/') return;

        const localePaths = {
          en: '/',
          ko: '/ko/',
          ja: '/ja/',
          'zh-Hans': '/zh-hans/',
          'zh-Hant': '/zh-hant/',
          'pt-BR': '/pt-br/',
          de: '/de/',
          fr: '/fr/',
          es: '/es/'
        };
        let preferredLocale = null;
        try {
          const storedLocale = window.localStorage.getItem('onnellab.locale');
          if (storedLocale && Object.prototype.hasOwnProperty.call(localePaths, storedLocale)) {
            preferredLocale = storedLocale;
          }
        } catch {
        }

        if (!preferredLocale) {
          const browserLocales = [...(navigator.languages || []), navigator.language];
          for (const browserLocale of browserLocales) {
            const normalized = String(browserLocale || '').replaceAll('_', '-').toLowerCase();
            if (normalized === 'ko' || normalized.startsWith('ko-')) preferredLocale = 'ko';
            else if (normalized === 'ja' || normalized.startsWith('ja-')) preferredLocale = 'ja';
            else if (
              normalized === 'zh-cn' ||
              normalized.startsWith('zh-cn-') ||
              normalized === 'zh-sg' ||
              normalized.startsWith('zh-sg-') ||
              normalized === 'zh-hans' ||
              normalized.startsWith('zh-hans-') ||
              normalized === 'zh'
            ) preferredLocale = 'zh-Hans';
            else if (
              normalized === 'zh-tw' ||
              normalized.startsWith('zh-tw-') ||
              normalized === 'zh-hk' ||
              normalized.startsWith('zh-hk-') ||
              normalized === 'zh-mo' ||
              normalized.startsWith('zh-mo-') ||
              normalized === 'zh-hant' ||
              normalized.startsWith('zh-hant-')
            ) preferredLocale = 'zh-Hant';
            else if (normalized === 'pt' || normalized.startsWith('pt-')) preferredLocale = 'pt-BR';
            else if (normalized === 'de' || normalized.startsWith('de-')) preferredLocale = 'de';
            else if (normalized === 'fr' || normalized.startsWith('fr-')) preferredLocale = 'fr';
            else if (normalized === 'es' || normalized.startsWith('es-')) preferredLocale = 'es';
            else if (normalized === 'en' || normalized.startsWith('en-')) preferredLocale = 'en';
            if (preferredLocale) break;
          }
        }

        const targetPath = preferredLocale ? localePaths[preferredLocale] : '/';
        if (targetPath === '/') return;

        document.documentElement.style.visibility = 'hidden';
        try {
          window.location.replace(targetPath);
        } catch {
          document.documentElement.style.removeProperty('visibility');
        }
      })();
    </script>
    <meta name="google-site-verification" content="0IUOtlQTLbMO9gWiDi4TqtQpMCKZVsGRLEchK8A6IzE" />
    {customFaviconUrl ? (
      <>
        <link
          rel="icon"
          href={customFaviconUrl}
          type={customFaviconPath?.endsWith('.png') ? 'image/png' : undefined}
        />
        <link rel="apple-touch-icon" href={customFaviconUrl} />
      </>
    ) : (
      <>
        <link rel="icon" href={new URL(`/favicon.svg?v=${faviconVersion}`, Astro.site)} type="image/svg+xml" />
        <link rel="icon" href={new URL(`/favicon-32x32.png?v=${faviconVersion}`, Astro.site)} sizes="32x32" type="image/png" />
        <link rel="apple-touch-icon" href={new URL(`/apple-touch-icon.png?v=${faviconVersion}`, Astro.site)} />
      </>
    )}
    <link rel="manifest" href={new URL(`/site.webmanifest?v=${faviconVersion}`, Astro.site)} />
    <meta name="theme-color" content="#f8f4ec" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="ONNELLAB RSS" href={new URL('/rss.xml', Astro.site)} />
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.lang} href={new URL(alternate.path, Astro.site)} />
    ))}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {ogType === 'article' && articleMeta?.publishedTime && <meta property="article:published_time" content={articleMeta.publishedTime} />}
    {ogType === 'article' && articleMeta?.modifiedTime && <meta property="article:modified_time" content={articleMeta.modifiedTime} />}
    {ogType === 'article' && articleMeta?.section && <meta property="article:section" content={articleMeta.section} />}
    {ogType === 'article' && articleMeta?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <slot name="head" />
    {jsonLdItems.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    {gaMeasurementId && <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>}
    {gaMeasurementId && <script is:inline set:html={gaScript}></script>}
  </head>
  <body>
    <slot />
    <script is:inline>
      (() => {
        const preferenceKey = 'onnellab.locale';

        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const link = target.closest('a[data-locale-choice]');
          const locale = link?.getAttribute('data-locale-choice');
          if (!locale) return;
          window.onnelTrack?.('language_switch', {
            from_locale: document.documentElement.lang || '',
            to_locale: locale,
            page_path: window.location.pathname
          });
          try {
            window.localStorage.setItem(preferenceKey, locale);
          } catch {
          }
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "SUIT Variable";
    font-weight: 45 920;
    font-style: normal;
    font-display: swap;
    src: url("https://cdn.jsdelivr.net/gh/sunn-us/SUIT/fonts/variable/woff2/SUIT-Variable.woff2")
      format("woff2-variations");
  }

  * {
    box-sizing: border-box;
  }

  :root {
    --onnellab-wordmark-font: "Avenir Next", Avenir, "Helvetica Neue", Arial, sans-serif;
    --site-header-control-height: 36px;
    --site-header-control-border: #ded6ca;
    --site-header-control-border-hover: #cfc5b7;
    --site-header-control-background: rgba(255, 253, 248, 0.82);
    --site-header-control-background-hover: #fffdf8;
    --site-header-control-color: #5f5a50;
    --site-header-focus: #827d72;
    --information-shell-max-width: 1040px;
    --information-shell-gutter: 40px;
    --information-shell-padding-top: 26px;
    --information-shell-padding-bottom: 54px;
    --information-heading-size: clamp(42px, 7vw, 72px);
    --information-heading-line-height: 1.04;
    --information-heading-letter-spacing: -0.01em;
  }

  body {
    margin: 0;
    background: #faf8f5;
    color: #3e3e3e;
    font-family:
      "SUIT Variable", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Apple SD Gothic Neo", "Segoe UI", sans-serif;
    word-break: normal;
    overflow-wrap: anywhere;
    line-break: strict;
  }

  html[lang='ko'] body {
    word-break: keep-all;
    overflow-wrap: break-word;
  }

  a {
    color: inherit;
  }

  code,
  pre,
  kbd,
  samp,
  input,
  textarea,
  table,
  .word-break-anywhere {
    word-break: normal;
    overflow-wrap: anywhere;
    line-break: auto;
  }

  .wordmark,
  .brand {
    font-family: var(--onnellab-wordmark-font);
    letter-spacing: 0;
  }

  .brand {
    color: #737067;
    font-size: 14px;
    font-weight: 560;
    line-height: 1.2;
  }

  .site-header,
  main[data-core-page='terms'] > .top-nav {
    min-height: var(--site-header-control-height);
    align-items: center;
  }

  .site-header .brand.brand,
  main[data-core-page='terms'] > .top-nav .brand.brand {
    min-height: var(--site-header-control-height);
    display: inline-flex;
    align-items: center;
    padding: 0;
    color: #737067;
    font-family: var(--onnellab-wordmark-font);
    font-size: 14px;
    font-weight: 560;
    line-height: 1.2;
    text-decoration: none;
  }

  .site-header .site-language-control.site-language-control {
    min-height: var(--site-header-control-height);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--site-header-control-border);
    border-radius: 999px;
    padding: 7px 13px;
    background: var(--site-header-control-background);
    box-shadow: none;
    color: var(--site-header-control-color);
    font-size: 13px;
    font-weight: 650;
    line-height: 1.35;
    text-decoration: none;
  }

  .site-header .site-language-control.site-language-control:hover,
  .site-header .site-language-control.site-language-control:focus-visible {
    border-color: var(--site-header-control-border-hover);
    background: var(--site-header-control-background-hover);
  }

  .site-header .brand.brand:focus-visible,
  .site-header .site-language-control.site-language-control:focus-visible {
    outline: 2px solid var(--site-header-focus);
    outline-offset: 3px;
  }

  .information-shell {
    width: min(
      var(--information-shell-max-width),
      calc(100% - var(--information-shell-gutter))
    );
    margin: 0 auto;
    padding: var(--information-shell-padding-top) 0 var(--information-shell-padding-bottom);
  }

  .information-heading {
    font-size: var(--information-heading-size);
    font-weight: 650;
    line-height: var(--information-heading-line-height);
    letter-spacing: var(--information-heading-letter-spacing);
  }

  main[data-core-page='about'] .intro-copy {
    max-width: none;
  }
</style>
